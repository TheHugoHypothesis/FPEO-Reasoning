  <rdf:Description rdf:about="http://www.usp.ai/Ontologies/FPEO/FugitiveEmissionModule#FugitiveEmissionProcess">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Fugitive emission process</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.usp.ai/Ontologies/FPEO/EmissionProcessModule#EmissionProcess"/>
    <rdfs:comment xml:lang="en">What it is: An emission process involving unintended leakage or diffuse release of gas. BFO/IOF placement: process. Why it is here: Provides a named process specialization for the FPSO emissions architecture and future scenario accounting.</rdfs:comment>
  </rdf:Description>
