  <rdf:Description rdf:about="http://www.usp.ai/Ontologies/FPEO/FugitiveEmissionModule">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <rdfs:label xml:lang="en">Fugitive emission process Module</rdfs:label>
    <rdfs:comment xml:lang="en">FPEO V5 candidate generated 2026-08-21. This ontology is part of the JSON-compatible, BFO-2020-aligned test architecture and is not the immutable production baseline.</rdfs:comment>
    <owl:versionIRI rdf:resource="http://www.usp.ai/Ontologies/FPEO/FugitiveEmissionModule/versions/2026-08-21"/>
    <owl:imports rdf:resource="http://www.usp.ai/Ontologies/FPEO/EmissionProcessModule"/>
