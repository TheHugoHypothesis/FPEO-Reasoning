    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">has distribution efficiency</rdfs:label>
    <rdfs:comment xml:lang="en">What it is: Bus-to-consumer delivery efficiency fraction. BFO/IOF placement: literal-bearing information attribute. Why it is here: Supports BusIn.distribution_efficiency.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.usp.ai/Ontologies/FPEO/EquipmentModule#ElectricalBus"/>
