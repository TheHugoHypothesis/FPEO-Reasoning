    <rdfs:label xml:lang="en">has interpolation segment</rdfs:label>
    <rdfs:comment xml:lang="en">What it is: Relates a keyframe profile to a segment between consecutive breakpoints. BFO/IOF placement: relation between ontology entities. Why it is here: Supports KeyframeDemand.connections.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.usp.ai/Ontologies/FPEO/PowerModule.rdf#KeyframePowerDemandProfile"/>
