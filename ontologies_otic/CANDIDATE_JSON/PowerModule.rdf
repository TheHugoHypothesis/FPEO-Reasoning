    <rdf:first rdf:resource="http://www.usp.ai/Ontologies/FPEO/PowerModule.rdf#ConsumerRole"/>
    <rdf:rest rdf:nodeID="N8dc249d9c2bb47ae8b3ec1e8aeb147d8"/>
