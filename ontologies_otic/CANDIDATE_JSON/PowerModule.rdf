    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000031"/>
    <rdfs:comment xml:lang="en">What it is: A configuration/information entity describing electrical power imported from outside the modeled offshore generation set. BFO/IOF placement: generically dependent continuant. Why it is here: Supports AlternativeSourceIn imported-power cases without inventing physical equipment.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.usp.ai/Ontologies/FPEO/PowerModule.rdf#hasConnectedBus">
