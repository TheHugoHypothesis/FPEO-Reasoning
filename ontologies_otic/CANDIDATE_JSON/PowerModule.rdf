    <rdfs:label xml:lang="en">configures cable</rdfs:label>
    <rdfs:comment xml:lang="en">What it is: Relates a transfer configuration to the physical cable it configures. BFO/IOF placement: relation between ontology entities. Why it is here: Separates cable identity from scenario direction.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.usp.ai/Ontologies/FPEO/PowerModule.rdf#CablePowerTransferConfiguration"/>
    <rdfs:range rdf:resource="http://rds.posccaesar.org/ontology/plm/rdl/PCA_100004105"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.usp.ai/Ontologies/FPEO/PowerModule.rdf#hasSegmentIndex">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">has segment index</rdfs:label>
    <rdfs:comment xml:lang="en">What it is: Zero-based/ordered segment position in a keyframe profile. BFO/IOF placement: literal-bearing information attribute. Why it is here: Supports deterministic JSON serialization of connections.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.usp.ai/Ontologies/FPEO/PowerModule.rdf#InterpolationSegment"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#nonNegativeInteger"/>
  </rdf:Description>
