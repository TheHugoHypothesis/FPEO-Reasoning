    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">has ramp-up years</rdfs:label>
    <rdfs:comment xml:lang="en">What it is: Duration of linear ramp-up phase in years. BFO/IOF placement: literal-bearing information attribute. Why it is here: Supports FieldLifecycleDemand.ramp_up_years.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.usp.ai/Ontologies/FPEO/PowerModule.rdf#FieldLifecyclePowerDemandProfile"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </rdf:Description>
