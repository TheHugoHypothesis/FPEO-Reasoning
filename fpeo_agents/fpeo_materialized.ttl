        iof-core:DesignSpecification ;
    rdfs:label "Design Pressure Specification"@en ;
    iof-core:hasContinuantPartAtAllTimes abox:Val_Pressure_K01 ;
    iof-core:prescribes abox:VRUCompressor_K01 .

abox:Spec_DesignPressure_K02 a prop:DesignPressureSpecification,
        owl:NamedIndividual,
        owl:Thing,
        iof-core:DesignSpecification ;
    rdfs:label "Design Pressure Specification (MAWP)"@en ;
    iof-core:hasContinuantPartAtAllTimes abox:Val_Pressure_K02 ;
    iof-core:prescribes abox:LPCompressor_K02 .

abox:Spec_DesignPressure_P01 a prop:DesignPressureSpecification,
        owl:NamedIndividual,
        owl:Thing,
        iof-core:DesignSpecification ;
    rdfs:label "Design Discharge Pressure"@en ;
    iof-core:hasContinuantPartAtAllTimes abox:Val_Pressure_P01 ;
    iof-core:prescribes abox:SeawaterLiftPump_P01 .

abox:Spec_DesignPressure_V01 a prop:DesignPressureSpecification,
        owl:NamedIndividual,
        owl:Thing,
        iof-core:DesignSpecification ;
    rdfs:label "Design Pressure Specification"@en ;
    iof-core:hasContinuantPartAtAllTimes abox:Val_Pressure_V01 ;
