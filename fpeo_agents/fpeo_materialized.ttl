core:powersEquipment a owl:ObjectProperty ;
    rdfs:label "powers equipment"@en,
        "alimenta equipamento"@pt ;
    rdfs:domain core:ElectricalEquipment ;
    rdfs:range core:TopsideEquipment ;
    owl:inverseOf [ owl:inverseOf core:powersEquipment ] ;
    skos:definition "Relates an electrical equipment to another topside equipment that receives electrical power from it."@en .

iof-core:roleOf a owl:ObjectProperty ;
    owl:inverseOf [ owl:inverseOf iof-core:roleOf ] .

o3po:Well a owl:Class ;
    rdfs:label "well"@en,
        "poço"@pt-br ;
    ns2:source "https://petrowiki.spe.org/Glossary:Completed_well"@en ;
    ns1:definition "def. a material artifact that is used to produce hydrocarbons or inject fluids and is located in a wellbore"@en ;
    rdfs:comment "A well that has been drilled, cased and cemented and is ready to produce hydrocarbons."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty uo:BFO_0000051 ;
            owl:someValuesFrom o3po:Borehole ],
        [ a owl:Restriction ;
            owl:onProperty uo:RO_0000086 ;
            owl:someValuesFrom o3po:BottomholePressure ],
        [ a owl:Restriction ;
            owl:onProperty uo:BFO_0000051 ;
            owl:someValuesFrom o3po:Borehole ],
        [ a owl:Restriction ;
            owl:onProperty uo:RO_0000086 ;
            owl:someValuesFrom o3po:BottomholePressure ],
        iof-core:MaterialArtifact .

iof-core:DesignSpecification a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty iof-core:prescribes ;
            owl:someValuesFrom core:TopsideEquipment ],
        [ a owl:Restriction ;
            owl:onProperty iof-core:hasContinuantPartAtAllTimes ;
            owl:someValuesFrom iof-core:ValueExpression ],
        [ a owl:Restriction ;
            owl:onProperty iof-core:prescribes ;
            owl:someValuesFrom core:TopsideEquipment ],
        [ a owl:Restriction ;
            owl:onProperty iof-core:hasContinuantPartAtAllTimes ;
            owl:someValuesFrom iof-core:ValueExpression ],
        owl:Thing .

core:EquipmentPort a owl:Class ;
    rdfs:label "Equipment Port"@en ;
    rdfs:subClassOf iof-core:MaterialArtifact ;
    skos:definition "A material artifact that acts as a physical, fluidic, or electrical boundary interface of a topside equipment, allowing physical connection and transfer to another equipment or piping line."@en .

core:TopsideEquipment a owl:Class ;
    rdfs:label "Topside Equipment"@en ;
    rdfs:subClassOf iof-core:MaterialArtifact ;
    skos:definition "Material Artifact designed to perform a specific process, utility, safety, or power generation function within the topside facilities of a floating production, storage, and offloading (FPSO) unit."@en .

iof-core:ValueExpression a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty uo:IAO_0000039 ;
            owl:someValuesFrom uo:UO_0000000 ],
        [ a owl:Restriction ;
            owl:onProperty iof-core:hasSimpleExpressionValue ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty uo:IAO_0000039 ;
            owl:someValuesFrom uo:UO_0000000 ],
        [ a owl:Restriction ;
            owl:onProperty iof-core:hasSimpleExpressionValue ;
            owl:someValuesFrom rdfs:Literal ],
        owl:Thing .

uo:BFO_0000040 a owl:Class ;
    rdfs:subClassOf owl:Thing .

iof-core:MaterialArtifact a owl:Class ;
    rdfs:subClassOf owl:Thing .

core:feedsFluidToEquipment a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "feeds fluid to equipment"@en,
        "envia fluido para equipamento"@pt ;
    rdfs:domain core:TopsideEquipment ;
    rdfs:range core:TopsideEquipment ;
    rdfs:subPropertyOf o3po:feedsFluidTo ;
    owl:inverseOf [ owl:inverseOf core:feedsFluidToEquipment ],
        core:receivesFluidFromEquipment ;
    owl:propertyChainAxiom ( core:hasPort core:portConnectedTo core:isPortOf ),
        ( core:hasPort core:portConnectedTo core:isPortOf ) ;
    skos:definition "Represents process fluid flow direction from an upstream topside equipment to a downstream topside equipment."@en .

