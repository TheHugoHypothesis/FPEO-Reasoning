        owl:Thing,
        iof-core:MaterialArtifact,
        o3po:Nozzle ;
    core:isPortOf abox:SeawaterLiftPump_P01 ;
    core:portConnectedTo abox:F01_Port_In ;
    o3po:connectedTo abox:F01_Port_In .

abox:P02_Port_In a uo:BFO_0000040,
        core:EquipmentPort,
        core:InletPort,
        owl:NamedIndividual,
        owl:Thing,
        iof-core:MaterialArtifact,
        o3po:Nozzle ;
    core:isPortOf abox:TestOilPump_P02 ;
    core:portConnectedTo abox:V01_Port_Out_Oil ;
    o3po:connectedTo abox:V01_Port_Out_Oil .

abox:P02_Port_Out a uo:BFO_0000040,
        core:EquipmentPort,
        core:OutletPort,
        owl:NamedIndividual,
        owl:Thing,
        iof-core:MaterialArtifact,
        o3po:Nozzle ;
    core:isPortOf abox:TestOilPump_P02 ;
    core:portConnectedTo abox:E02_Port_In ;
    o3po:connectedTo abox:E02_Port_In .

abox:V01_Port_In a uo:BFO_0000040,
        core:EquipmentPort,
        core:InletPort,
        owl:NamedIndividual,
        owl:Thing,
        iof-core:MaterialArtifact,
        o3po:Nozzle ;
    core:isPortOf abox:TestSeparator_V01 ;
    core:portConnectedTo abox:E02_Port_Out ;
    o3po:connectedTo abox:E02_Port_Out .

abox:V01_Port_Out_Oil a uo:BFO_0000040,
        core:EquipmentPort,
        core:OutletPort,
        owl:NamedIndividual,
        owl:Thing,
        iof-core:MaterialArtifact,
        o3po:Nozzle ;
    core:isPortOf abox:TestSeparator_V01 ;
    core:portConnectedTo abox:P02_Port_In ;
    o3po:connectedTo abox:P02_Port_In .

dynamical:GasGenerator a owl:Class ;
    rdfs:label "Gas Generator Assembly"@en,
        "Gerador de Gás"@pt ;
    rdfs:subClassOf dynamical:TurbineComponentEquipment ;
    skos:definition "Assembly of gas turbine components which produces heated pressurized gas to a power turbine or process."@en .

dynamical:LowPressureCompressor a owl:Class ;
    rdfs:label "Low Pressure Compressor"@en,
        "Compressor de Baixa Pressão"@pt ;
    rdfs:isDefinedBy "ISO 10439" ;
    rdfs:subClassOf dynamical:CompressorEquipment .

dynamical:MultiShaftGasTurbine a owl:Class ;
    rdfs:label "Multi Shaft Gas Turbine"@en,
        "Turbina a Gás Multieixo"@pt ;
    rdfs:isDefinedBy "ISO 11042" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty prop:hasGasGenerator ;
            owl:someValuesFrom dynamical:GasGenerator ],
        [ a owl:Restriction ;
            owl:onProperty prop:hasPowerTurbine ;
            owl:someValuesFrom dynamical:PowerTurbine ],
        dynamical:GasTurbineEquipment ;
    skos:definition "Gas turbine combination including at least two turbines working on independent shafts."@en .

electrical:ElectricalConductorEquipment a owl:Class ;
    rdfs:label "Electrical Conductor Equipment"@en,
        "Equipamento Condutor Elétrico"@pt ;
    rdfs:subClassOf core:ElectricalEquipment ;
    skos:definition "An electrical physical artifact designed to transmit electrical energy between power sources, switchgears, and loads."@en .

prop:RatedSpeedSpecification a owl:Class ;
    rdfs:label "Rated Speed Specification"@en,
        "Especificação de Rotação Nominal"@pt ;
    rdfs:subClassOf iof-core:DesignSpecification ;
    skos:definition "Design specification prescribing the design rotational speed (RPM) of a turbomachine."@en .

prop:hasAuxiliarySystem a owl:ObjectProperty ;
    rdfs:label "has auxiliary system"@en,
        "tem sistema auxiliar"@pt ;
    owl:inverseOf [ owl:inverseOf prop:hasAuxiliarySystem ] .

prop:hasCombustionChamber a owl:ObjectProperty ;
    rdfs:label "has combustion chamber"@en,
        "tem câmara de combustão"@pt ;
    rdfs:range dynamical:CombustionChamber ;
    owl:inverseOf [ owl:inverseOf prop:hasCombustionChamber ] .

prop:hasGasGenerator a owl:ObjectProperty ;
    rdfs:label "has gas generator"@en,
        "tem gerador de gás"@pt ;
    rdfs:domain dynamical:GasTurbineEquipment ;
    rdfs:range dynamical:GasGenerator ;
    owl:inverseOf [ owl:inverseOf prop:hasGasGenerator ] .

sensors:FlowMeter a owl:Class ;
    rdfs:label "Flow Meter"@en,
        "Medidor de Vazão"@pt-br ;
    rdfs:comment "Instrument that measures the flow rate (mass or volumetric) of a fluid in a process pipe or duct."@en,
        "Instrumento que mede a vazão (mássica ou volumétrica) de um fluido em um duto ou tubulação de processo."@pt-br ;
    rdfs:subClassOf sensors:MeasuringInstrument ;
    owl:equivalentClass o3po:Flowmeter .

sensors:MeasuringInstrument a owl:Class ;
    rdfs:label "Measuring Instrument"@en,
        "Instrumento de Medição"@pt-br ;
    rdfs:comment "Equipment whose function is to measure one or more physical or chemical quantities of a process (e.g., flow, gas concentration), providing a measurable signal or value. Common superclass for gas analyzers and flow meters."@en,
        "Equipamento cuja função é medir uma ou mais grandezas físicas ou químicas de um processo (ex.: vazão, concentração de gases), fornecendo um sinal ou valor mensurável. Superclasse comum para analisadores de gases e medidores de vazão desta ontologia."@pt-br ;
    rdfs:subClassOf core:InstrumentationAndControlEquipment,
        o3po:Sensor .

static:SRUCartridgeFilter a owl:Class ;
    rdfs:label "SRU Cartridge Filter"@en,
        "Filtro de Cartucho do SRU"@pt ;
    rdfs:isDefinedBy "API Spec 14E" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty core:feedsFluidToEquipment ;
            owl:someValuesFrom static:SRUMembraneTrain ],
        [ a owl:Restriction ;
            owl:onProperty core:feedsFluidToEquipment ;
            owl:someValuesFrom static:SRUMembraneTrain ],
        [ a owl:Restriction ;
            owl:onProperty core:feedsFluidToEquipment ;
            owl:someValuesFrom static:SRUMembraneTrain ],
        uo:BFO_0000040,
        static:ParticulateFilterEquipment,
        o3po:ParticulateFilter .

static:SeawaterCoarseStrainer a owl:Class ;
    rdfs:label "Seawater Coarse Strainer"@en,
        "Filtro Groso de Água do Mar"@pt ;
    rdfs:isDefinedBy "API Spec 14E" ;
    rdfs:subClassOf static:ParticulateFilterEquipment,
        o3po:ParticulateFilter .

valve:PressureSafetyAndReliefEquipment a owl:Class ;
    rdfs:label "Pressure Safety and Relief Equipment"@en,
        "Equipamento de Segurança e Alívio de Pressão"@pt ;
    rdfs:subClassOf core:ValveAndSecurityEquipment,
        o3po:Valve ;
    skos:definition "Safety devices designed to automatically relieve excess pressure from pressure vessels or piping systems to protect integrity."@en .

iof-core:ProcessCharacteristic a owl:Class ;
    rdfs:subClassOf owl:Thing .

iof-core:componentPartOfAtSomeTime a owl:ObjectProperty ;
    owl:inverseOf [ owl:inverseOf iof-core:componentPartOfAtSomeTime ] .

iof-core:hasComponentPartAtAllTimes a owl:ObjectProperty ;
    owl:inverseOf [ owl:inverseOf iof-core:hasComponentPartAtAllTimes ] .

iof-core:hasContinuantPartAtAllTimes a owl:ObjectProperty ;
    owl:inverseOf [ owl:inverseOf iof-core:hasContinuantPartAtAllTimes ] .

iof-core:prescribes a owl:ObjectProperty ;
    owl:inverseOf [ owl:inverseOf iof-core:prescribes ] .

iof-core:processCharacteristicOf a owl:ObjectProperty ;
    owl:inverseOf [ owl:inverseOf iof-core:processCharacteristicOf ] .

o3po:CrudeOil a owl:Class ;
    rdfs:label "crude oil"@en,
        "óleo cru"@pt-br ;
    ns1:definition "def. petroleum that exists as a liquid in underground geologic formations and remains a liquid when brought to the surface"@en ;
    rdfs:seeAlso "https://en.wikipedia.org/wiki/Petroleum" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty uo:BFO_0000050 ;
            owl:someValuesFrom o3po:Petroleum ],
        [ a owl:Restriction ;
            owl:onProperty uo:BFO_0000050 ;
            owl:someValuesFrom o3po:Petroleum ],
        o3po:Petroleum ;
    owl:disjointWith o3po:NaturalGas .

o3po:FlowRateMeasurementDatum a owl:Class ;
    rdfs:label "flow rate measurement datum"@en,
        "dado de medição de vazão"@pt-br ;
    ns1:definition "def. a measurement information content entity about flow rate"@en ;
    rdfs:subClassOf iof-core:MeasurementInformationContentEntity .

o3po:Water a owl:Class ;
    rdfs:label "water"@en,
        "água"@pt-br ;
    ns1:definition "def. an earth fluid that has chemical formula H2O and is inorganic, transparent, tasteless, odorless, and nearly colorless chemical substance"@en ;
    rdfs:comment "Water (chemical formula H2O) is an inorganic, transparent, tasteless, odorless, and nearly colorless chemical substance, which is the main constituent of Earth's hydrosphere and the fluids of all known living organisms."@en ;
    rdfs:subClassOf <https://www.inf.ufrgs.br/bdi/ontologies/GEOCORE_0000009> .

o3po:WellFlowRate a owl:Class ;
    rdfs:label "well liquid rate"@en,
        "vazão líquida do poço"@pt-br ;
    uo:IAO_0000112 "production rate of a well, injection rate of a well"@en ;
    ns1:definition "def. the flow rate that has only crude oil and water as participants and occurs in a well"@en ;
    rdfs:seeAlso "https://www.glossary.oilfield.slb.com/Terms/w/well_flow_rate.aspx"@en ;
    rdfs:subClassOf o3po:FlowRate .

uo:UO_0000099 a uo:UO_0000000,
        owl:NamedIndividual,
        owl:Thing .

abox:FPSO_P79 a owl:NamedIndividual,
        owl:Thing,
        iof-core:MaterialArtifact,
        o3po:FPSO,
        o3po:Platform ;
    rdfs:label "FPSO P-79 Guanabara"@en ;
    uo:RO_0001015 abox:Module_M06,
        abox:Module_M08 ;
    core:hasFPSOModule abox:Module_M06,
        abox:Module_M08 ;
    rdfs:comment "Navio Plataforma FPSO P-79 alocado na Bacia de Santos"@pt .

abox:MCC_01 a electrical:MotorControlCenter,
        electrical:PowerDistributionAndSwitchingEquipment,
        core:ElectricalEquipment,
        core:TopsideEquipment,
        owl:NamedIndividual,
        owl:Thing,
        iof-core:MaterialArtifact ;
    rdfs:label "MCC-01 Low Voltage Motor Control Center"@en ;
    uo:RO_0001025 abox:Module_M06 ;
    core:hasPort abox:MCC01_Port_Elec ;
    core:isLocatedInModule abox:Module_M06 ;
    core:powersEquipment abox:Motor_P01 .

abox:MCC_Emergency a electrical:MotorControlCenter,
        electrical:PowerDistributionAndSwitchingEquipment,
        core:ElectricalEquipment,
        core:TopsideEquipment,
        owl:NamedIndividual,
        owl:Thing,
        iof-core:MaterialArtifact ;
    rdfs:label "MCC-EMERGENCY Essential Motor Control Center"@en ;
    uo:RO_0001025 abox:Module_M02 ;
    core:hasPort abox:MCC_EMERG_Port_Elec ;
    core:isLocatedInModule abox:Module_M02 .

abox:Motor_P01 a electrical:ElectricMotorEquipment,
        core:ElectricalEquipment,
        core:TopsideEquipment,
        owl:NamedIndividual,
        owl:Thing,
        iof-core:MaterialArtifact ;
    rdfs:label "M-P01 Seawater Lift Pump Electric Motor"@en ;
    uo:RO_0001025 abox:Module_M01 ;
    core:hasPort abox:MP01_Port_Elec ;
    core:isLocatedInModule abox:Module_M01 .

abox:PowerTransformer_TR01 a electrical:PowerTransformationAndConversionEquipment,
        electrical:PowerTransformer,
        core:ElectricalEquipment,
        core:TopsideEquipment,
        owl:NamedIndividual,
        owl:Thing,
        iof-core:MaterialArtifact ;
    rdfs:label "TR-01 Main Step-Down Power Transformer"@en ;
    uo:RO_0001025 abox:Module_M06 ;
    core:hasPort abox:TR01_Port_Elec ;
    core:isLocatedInModule abox:Module_M06 ;
    core:powersEquipment abox:MCC_01 .

dynamical:CombustionChamber a owl:Class ;
    rdfs:label "Combustion Chamber"@en,
        "Câmara de Combustão"@pt ;
    rdfs:subClassOf dynamical:TurbineComponentEquipment ;
    skos:definition "Heat source in which fuel reacts with compressed air to increase the working fluid temperature."@en .

core:RenewableEquipment a owl:Class ;
    rdfs:label "Renewable Equipment"@en ;
    rdfs:subClassOf core:TopsideEquipment ;
    skos:definition "A topside equipment designed to capture, convert, or condition energy from renewable sources to support decarbonized power supply in offshore operations."@en .

core:isPortOf a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "is port of"@en,
        "é porta de"@pt ;
    rdfs:domain core:EquipmentPort ;
    rdfs:range core:TopsideEquipment ;
    owl:inverseOf [ owl:inverseOf core:isPortOf ],
        core:hasPort ;
    skos:definition "Relates an equipment port to the unique topside equipment it belongs to."@en .

prop:DesignFlowRateSpecification a owl:Class ;
    rdfs:label "Design Flow Rate Specification"@en,
        "Especificação de Vazão de Projeto"@pt ;
    rdfs:subClassOf iof-core:DesignSpecification ;
    skos:definition "Design specification prescribing design fluid flow rate capacity."@en .

prop:FlowRateValueExpression a owl:Class ;
    rdfs:label "Flow Rate Value Expression"@en,
        "Expressão de Valor de Vazão"@pt ;
    rdfs:subClassOf iof-core:ValueExpression ;
    skos:definition "A value expression representing volumetric or mass flow rate paired with a flow unit of measure."@en .

static:GasFlotationCell a owl:Class ;
    rdfs:label "Flotation Unit Cell"@en,
        "Célula de Flotação a Gás"@pt ;
    rdfs:isDefinedBy "API Spec 12L" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty core:feedsFluidToEquipment ;
            owl:someValuesFrom [ owl:complementOf static:DeoilingHydrocyclone ] ],
        [ a owl:Restriction ;
            owl:onProperty core:feedsFluidToEquipment ;
            owl:someValuesFrom [ owl:complementOf static:DeoilingHydrocyclone ] ],
        [ a owl:Restriction ;
            owl:onProperty core:feedsFluidToEquipment ;
            owl:someValuesFrom [ owl:complementOf static:DeoilingHydrocyclone ] ],
        uo:BFO_0000040,
        static:SeparationAndFilterEquipment ;
    owl:disjointWith [ a owl:Restriction ;
            owl:onProperty core:feedsFluidToEquipment ;
            owl:someValuesFrom static:DeoilingHydrocyclone ],
        [ a owl:Restriction ;
            owl:onProperty core:feedsFluidToEquipment ;
            owl:someValuesFrom static:DeoilingHydrocyclone ] .

static:NitrogenReceiverTank a owl:Class ;
    rdfs:label "Nitrogen Receiver Tank"@en,
        "Vaso Pulmão de Nitrogênio"@pt ;
    rdfs:isDefinedBy "API Spec 12J" ;
    rdfs:subClassOf static:PressureVesselEquipment,
        o3po:Vessel .

static:ProducedWaterInletCooler a owl:Class ;
    rdfs:label "Produced Water Inlet Cooler"@en,
        "Resfriador de Entrada de Água Produzida"@pt ;
    rdfs:isDefinedBy "ISO 16812" ;
    rdfs:subClassOf static:HeatExchangeEquipment,
        o3po:Cooler .

static:ProducedWaterOverboardCooler a owl:Class ;
    rdfs:label "Produced Water Overboard Cooler"@en,
        "Resfriador de Descarte de Água Produzida"@pt ;
    rdfs:isDefinedBy "ISO 16812" ;
    rdfs:subClassOf static:HeatExchangeEquipment,
        o3po:Cooler .

static:SRUMembraneTrain a owl:Class ;
    rdfs:label "SRU Membrane Train"@en,
        "Trem de Membranas de Remoção de Sulfato"@pt ;
    rdfs:isDefinedBy "API Spec 14E" ;
    rdfs:subClassOf static:SeparationAndFilterEquipment .

static:WaterSkimVessel a owl:Class ;
    rdfs:label "Water Collection / Skim Vessel"@en,
        "Vaso Desnatador de Água Produzida"@pt ;
    rdfs:isDefinedBy "API Spec 12J" ;
    rdfs:subClassOf static:PressureVesselEquipment,
        o3po:Vessel .

valve:IsolationAndShutdownEquipment a owl:Class ;
    rdfs:label "Isolation and Shutdown Equipment"@en,
        "Equipamento de Isolamento e Parada de Emergência"@pt ;
    rdfs:subClassOf core:ValveAndSecurityEquipment,
        o3po:Valve ;
    skos:definition "Valves engineered for positive shutoff, emergency shutdown (ESD), or unidirectional flow prevention to isolate process units."@en .

valve:ProcessControlEquipment a owl:Class ;
    rdfs:label "Process Control Equipment"@en,
        "Equipamento de Controle de Processo"@pt ;
    rdfs:subClassOf core:ValveAndSecurityEquipment,
        o3po:Valve ;
    skos:definition "Final control elements designed to regulate fluid flow rate, pressure, temperature, or liquid level in process loops."@en .

iof-core:Assembly a owl:Class ;
    rdfs:subClassOf owl:Thing .

o3po:BottomholePressure a owl:Class ;
    rdfs:label "bottomhole pressure"@en,
        "pressão de fundo"@pt-br ;
    ns1:definition "def. pressure at the bottom of the well"@en ;
    rdfs:seeAlso "https://www.glossary.oilfield.slb.com/Terms/b/bottomhole_pressure.aspx"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty iof-core:qualityOf ;
            owl:someValuesFrom o3po:Well ],
        [ a owl:Restriction ;
            owl:onProperty iof-core:qualityOf ;
            owl:someValuesFrom o3po:Well ],
        o3po:Pressure .

o3po:FPSO a owl:Class ;
    rdfs:label "floating production, storage, and offloading vessel"@en,
        "FPSO"@pt-br ;
    ns2:source "https://www.glossary.oilfield.slb.com/Terms/f/fpso.aspx"@en ;
    ns1:acronym "FPSO"@en ;
    ns1:definition "def. an offshore platform that serves as gathering, processing and storage facilities for fluids produced from subsea wells"@en ;
    rdfs:comment "Abbreviation for floating production, storage, and offloading vessel. FPSOs are commonly deployed for offshore production in locations that have little infrastructure. They serve as gathering, processing and storage facilities for fluids produced from subsea wells. Processed using equipment on the ship's deck, the fluids are then stored in the ship's hull before they are offloaded to pipelines, barges, or ships."@en ;
    rdfs:subClassOf o3po:Platform ;
    owl:disjointWith o3po:Semisubmersible .

o3po:Flow a owl:Class ;
    rdfs:label "flow"@en,
        "fluxo"@pt-br ;
    ns2:hasRelatedSynonym "fluid flow"@en ;
    ns1:definition "def. a process that has participant some fluid and the fluid is in continuous movement"@en ;
    rdfs:comment "The continuous movement characteristic of a liquid or gas."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty uo:RO_0000057 ;
            owl:someValuesFrom o3po:Fluid ],
        [ a owl:Restriction ;
            owl:onProperty uo:RO_0000057 ;
            owl:someValuesFrom o3po:Fluid ],
        uo:BFO_0000015 .

o3po:ICVAnnularPressure a owl:Class ;
    rdfs:label "ICV annular pressure"@en,
        "pressão no anular do ICV"@pt-br ;
    ns1:definition "def. a pressure quality that inheres in the annular space of an ICV"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty uo:RO_0000080 ;
            owl:someValuesFrom o3po:ICV ],
        [ a owl:Restriction ;
            owl:onProperty uo:RO_0000080 ;
            owl:someValuesFrom o3po:ICV ],
        o3po:Pressure .

o3po:ICVAnnularTemperature a owl:Class ;
    rdfs:label "ICV annular temperature"@en,
        "temperatura no anular do ICV"@pt-br ;
    ns1:definition "def. a temperature quality that inheres in the annular space of an ICV"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty uo:RO_0000080 ;
            owl:someValuesFrom o3po:ICV ],
        [ a owl:Restriction ;
            owl:onProperty uo:RO_0000080 ;
            owl:someValuesFrom o3po:ICV ],
        o3po:Temperature .

o3po:ICVDeltaPressure a owl:Class ;
    rdfs:label "ICV delta pressure"@en,
        "pressão delta do ICV"@pt-br ;
    ns1:definition "def. a pressure quality that represents the pressure difference across an ICV"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty uo:RO_0000080 ;
            owl:someValuesFrom o3po:ICV ],
        [ a owl:Restriction ;
            owl:onProperty uo:RO_0000080 ;
            owl:someValuesFrom o3po:ICV ],
        o3po:Pressure .

o3po:ICVOpenControlLinePressure a owl:Class ;
    rdfs:label "ICV open control line pressure"@en,
        "pressão na linha de controle aberta do ICV"@pt-br ;
    ns1:definition "def. a pressure quality that inheres in the open control line of an ICV"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty uo:RO_0000080 ;
            owl:someValuesFrom o3po:ICV ],
        [ a owl:Restriction ;
            owl:onProperty uo:RO_0000080 ;
            owl:someValuesFrom o3po:ICV ],
        o3po:Pressure .

o3po:InjectionFluid a owl:Class ;
    rdfs:label "injection fluid"@en,
        "fluido de injeção"@pt-br ;
    ns1:definition "def. a fluid that has role some injection role"@en ;
    rdfs:comment "Fluid injected by an injection well."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty iof-core:hasRole ;
            owl:someValuesFrom o3po:InjectionRole ],
        [ a owl:Restriction ;
            owl:onProperty iof-core:hasRole ;
            owl:someValuesFrom o3po:InjectionRole ],
        o3po:Fluid ;
    owl:disjointWith o3po:ProductionFluid .

o3po:InjectionWell a owl:Class ;
    rdfs:label "injection well"@en,
        "poço de injeção"@pt-br ;
    ns1:definition "def. a well where fluids are injected rather than produced, the primary objective typically being to maintain reservoir pressure"@en ;
    rdfs:seeAlso "https://petrowiki.spe.org/Glossary:Injection_well" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty uo:RO_0000087 ;
            owl:someValuesFrom o3po:InjectorRole ],
        [ a owl:Restriction ;
            owl:onProperty uo:RO_0000087 ;
            owl:someValuesFrom o3po:InjectorRole ],
        o3po:Well ;
    owl:disjointWith o3po:ProductionWell .

o3po:Petroleum a owl:Class ;
    rdfs:label "petroleum"@en,
        "petróleo"@pt-br ;
    ns1:definition "def. an earth fluid that consists of a complex mixture of hydrocarbons of various molecular weights and other liquid organic compounds, that are found in geologic formations beneath the planetary surfaces"@en ;
    rdfs:seeAlso "https://en.wikipedia.org/wiki/Petroleum" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty uo:BFO_0000051 ;
            owl:someValuesFrom o3po:CrudeOil ],
        [ a owl:Restriction ;
            owl:onProperty uo:BFO_0000051 ;
            owl:someValuesFrom o3po:CrudeOil ],
        <https://www.inf.ufrgs.br/bdi/ontologies/GEOCORE_0000009> ;
    owl:disjointWith o3po:Water .

o3po:Wellhead a owl:Class ;
    rdfs:label "wellhead"@en,
        "cabeça do poço"@pt-br ;
    ns1:definition "def. an assembly that is located at the top of the casing strings of a well and that provide pressure control of a well, and the means for hanging and isolating the various tubular strings"@en ;
    rdfs:comment "An equipment (or assembly) located to the top of the casing strings of a well that provide pressure control of a well, and the means for hanging and isolating the various tubular strings."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty o3po:componentOf ;
            owl:someValuesFrom o3po:Well ],
        [ a owl:Restriction ;
            owl:onProperty o3po:componentOf ;
            owl:someValuesFrom o3po:Well ],
        iof-core:Assembly .

o3po:exchangesFluidWith a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "exchanges fluid with"@en,
        "troca fluido com"@pt-br ;
    rdfs:comment "Relation between two things which have a fluid exchange connection"@en ;
    rdfs:domain uo:BFO_0000040 ;
    rdfs:range uo:BFO_0000040 ;
    rdfs:subPropertyOf o3po:connectedTo ;
    owl:inverseOf [ owl:inverseOf o3po:exchangesFluidWith ],
        o3po:exchangesFluidWith ;
    ns3:adaptedFrom "http://www.w3id.org/fso"@en .

o3po:feedsFluidTo a owl:ObjectProperty ;
    rdfs:label "feeds fluid to"@en,
        "alimenta fluido para"@pt-br ;
    rdfs:comment "Relation from a thing feeding fluid to the thing it is feeding fluid to."@en ;
    rdfs:subPropertyOf o3po:exchangesFluidWith ;
    owl:inverseOf [ owl:inverseOf o3po:feedsFluidTo ],
        o3po:hasFluidFedBy ;
    ns3:adaptedFrom "http://www.w3id.org/fso"@en .

uo:BFO_0000197 a owl:ObjectProperty ;
    owl:inverseOf [ owl:inverseOf uo:BFO_0000197 ] .

dynamical:PositiveDisplacementPumpEquipment a owl:Class ;
    rdfs:label "Positive Displacement Pump Equipment"@en,
        "Equipamento Bomba de Deslocamento Positivo"@pt ;
    rdfs:isDefinedBy "API Std 674 / API Std 675" ;
    rdfs:subClassOf dynamical:PumpEquipment,
        o3po:Pump ;
    owl:equivalentClass o3po:PositiveDisplacementPump ;
    skos:definition "A pump equipment that moves fluid by trapping a fixed amount and forcing (displacing) that trapped volume into the discharge pipe."@en .

sensors:GasAnalyzer a owl:Class ;
    rdfs:label "Gas Analyzer"@en,
        "Analisador de Gases"@pt-br ;
    rdfs:comment "Instrument that measures the concentration of one or more gaseous components (pollutants or reference gases) in an exhaust gas sample."@en,
        "Instrumento que mede a concentração de um ou mais componentes gasosos (poluentes ou gases de referência) em uma amostra de gás de exaustão."@pt-br ;
    rdfs:subClassOf sensors:MeasuringInstrument .

static:FilterEquipment a owl:Class ;
    rdfs:label "Filter Equipment"@en,
        "Equipamento Filtro"@pt ;
    rdfs:subClassOf static:SeparationAndFilterEquipment ;
    owl:equivalentClass o3po:Filter ;
    skos:definition "A static separation equipment designed to remove solid particles or liquid droplets from a fluid stream."@en .

static:LPFlareKnockoutDrum a owl:Class ;
    rdfs:label "LP Flare Knockout Drum"@en,
        "Vaso Knockout de Baixa Pressão do Flare"@pt ;
    rdfs:isDefinedBy "ISO 23251 (API 521)" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty core:feedsFluidToEquipment ;
            owl:someValuesFrom static:IntegratedLPFlareTip ],
        [ a owl:Restriction ;
            owl:onProperty core:feedsFluidToEquipment ;
            owl:someValuesFrom static:IntegratedLPFlareTip ],
        [ a owl:Restriction ;
            owl:onProperty core:feedsFluidToEquipment ;
            owl:someValuesFrom static:IntegratedLPFlareTip ],
        uo:BFO_0000040,
        static:PressureVesselEquipment,
        o3po:GasScrubber ;
    owl:disjointWith [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf core:feedsFluidToEquipment ] ;
            owl:someValuesFrom dynamical:HighPressureCompressor ] ;
    skos:altLabel "LP Flare Scrubber"@en,
        "Vaso Ciclônico de Baixa Pressão do Flare"@pt .

static:TestInletHeater a owl:Class ;
    rdfs:label "Test Inlet Heater"@en,
        "Aquecedor de Entrada do Separador de Teste"@pt ;
    rdfs:isDefinedBy "API Spec 12K" ;
    rdfs:subClassOf static:HeatExchangeEquipment,
        o3po:HeatExchanger,
        o3po:Heater .

iof-core:isPrescribedBy a owl:ObjectProperty ;
    owl:inverseOf [ owl:inverseOf iof-core:isPrescribedBy ] .

o3po:ChristmasTree a owl:Class ;
    rdfs:label "christmas tree"@en,
        "árvore de natal"@pt-br ;
    ns2:hasRelatedSynonym "Tree"@en ;
    ns2:source <https://en.wikipedia.org/wiki/Christmas_tree_(oil_well)> ;
    ns1:definition "def. an assembly that is composed of valves and that is located above a well and that is directly or indirectly connected to the well to control the flow of fluids from/into the well"@en ;
    rdfs:comment "In petroleum and natural gas extraction, a Christmas tree, or 'tree', is an assembly of valves, spools, and fittings used to regulate the flow of pipes in an oil well, gas well, water injection well, water disposal well, gas injection well, condensate well and other types of wells."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty iof-core:hasComponentPartAtAllTimes ;
            owl:someValuesFrom o3po:Valve ],
        [ a owl:Restriction ;
            owl:onProperty iof-core:hasComponentPartAtAllTimes ;
            owl:someValuesFrom o3po:Valve ],
        iof-core:Assembly .

o3po:FlowRate a owl:Class ;
    rdfs:label "flow rate"@en,
        "vazão"@pt-br ;
    ns1:definition "def. a IOF:process characteristic that is volume of fluid which flows per unit of time"@en ;
    rdfs:comment "The volume of fluid which flows per unit of time"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty iof-core:processCharacteristicOf ;
            owl:someValuesFrom o3po:Flow ],
        [ a owl:Restriction ;
            owl:onProperty iof-core:processCharacteristicOf ;
            owl:someValuesFrom o3po:Flow ],
        iof-core:ProcessCharacteristic .

o3po:PositiveDisplacementPump a owl:Class ;
    rdfs:label "positive-displacement pump"@en,
        "bomba de deslocamento positivo"@pt-br ;
    ns1:definition "def. a type of fluid pump in which the displacement volume of the pump is fixed for each rotation of the pump"@en ;
    rdfs:seeAlso "https://www.glossary.oilfield.slb.com/Terms/p/positive-displacement_pump.aspx" ;
    rdfs:subClassOf dynamical:PumpEquipment,
        o3po:Pump .

o3po:ProductionFluid a owl:Class ;
    rdfs:label "production fluid"@en,
        "fluido de produção"@pt-br ;
    ns1:definition "def. a fluid that has_role production_role"@en ;
    rdfs:comment "Fluid produced by a production well."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty iof-core:hasRole ;
            owl:someValuesFrom o3po:ProductionRole ],
        [ a owl:Restriction ;
            owl:onProperty iof-core:hasRole ;
            owl:someValuesFrom o3po:ProductionRole ],
        o3po:Fluid .

o3po:ProductionWell a owl:Class ;
    rdfs:label "production well"@en,
        "poço de produção"@pt-br ;
    ns2:source "https://petrowiki.spe.org/Glossary:Producing_well"@en ;
    ns1:definition "def. a well that produces hydrocarbon in commercial quantities"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty uo:RO_0000087 ;
            owl:someValuesFrom o3po:ProducerRole ],
        [ a owl:Restriction ;
            owl:onProperty uo:RO_0000087 ;
            owl:someValuesFrom o3po:ProducerRole ],
        o3po:Well .

o3po:hasFluidFedBy a owl:ObjectProperty ;
    rdfs:label "has fluid fed by"@en,
        "tem fluido alimentado por"@pt-br ;
    rdfs:comment "Relation from a thing that is fed fluid to the thing feeding the fluid."@en ;
    rdfs:subPropertyOf o3po:exchangesFluidWith ;
    owl:inverseOf [ owl:inverseOf o3po:hasFluidFedBy ] ;
    ns3:adaptedFrom "http://www.w3id.org/fso"@en .

uo:UO_0000037 a uo:UO_0000000,
        owl:NamedIndividual,
        owl:Thing .

uo:UO_0000062 a uo:UO_0000000,
        owl:NamedIndividual,
        owl:Thing .

dynamical:PowerTurbine a owl:Class ;
    rdfs:label "Power Turbine"@en,
        "Turbina de Potência"@pt ;
    rdfs:subClassOf dynamical:TurbineComponentEquipment ;
    skos:definition "Turbine having a separate shaft from which useful output power is derived."@en .

electrical:LowVoltageSwitchgear a owl:Class ;
    rdfs:label "Low Voltage Switchgear"@en,
        "Painel de Baixa Tensão"@pt ;
    rdfs:isDefinedBy "IEC 61439 / IEC 61892-3" ;
    rdfs:subClassOf electrical:PowerDistributionAndSwitchingEquipment ;
    skos:altLabel "LV Switchgear"@en,
        "Painel LV"@pt ;
    skos:definition "Switchgear assembly operating at low voltages for feeding sub-distribution centers and auxiliary systems."@en .

electrical:PowerGenerationEquipment a owl:Class ;
    rdfs:label "Power Generation Equipment"@en,
        "Equipamento de Geração de Energia"@pt ;
    rdfs:subClassOf core:ElectricalEquipment ;
    skos:definition "An electrical equipment designed to convert mechanical energy or chemical reactions into electrical power for offshore topside distribution."@en .

electrical:PowerTransformationAndConversionEquipment a owl:Class ;
    rdfs:label "Power Transformation and Conversion Equipment"@en,
        "Equipamento de Transformação e Conversão Elétrica"@pt ;
    rdfs:subClassOf core:ElectricalEquipment ;
    skos:definition "An electrical equipment designed to alter voltage levels, frequency, or convert electrical current (AC/DC) for process or power needs."@en .

electrical:PowerTransformer a owl:Class ;
    rdfs:label "Power Transformer"@en,
        "Transformador de Potência"@pt ;
    rdfs:isDefinedBy "IEC 60076 / IEC 61892-3" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty core:powersEquipment ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( electrical:LowVoltageSwitchgear electrical:MotorControlCenter ) ] ],
        [ a owl:Restriction ;
            owl:onProperty core:powersEquipment ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( electrical:LowVoltageSwitchgear electrical:MotorControlCenter ) ] ],
        [ a owl:Restriction ;
            owl:onProperty core:powersEquipment ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( electrical:LowVoltageSwitchgear electrical:MotorControlCenter ) ] ],
        electrical:PowerTransformationAndConversionEquipment ;
    skos:definition "Static electrical equipment that converts voltage and current levels via electromagnetic induction."@en .

core:hasPort a owl:ObjectProperty ;
    rdfs:label "has port"@en,
        "possui porta"@pt ;
    rdfs:domain core:TopsideEquipment ;
    rdfs:range core:EquipmentPort ;
    owl:inverseOf [ owl:inverseOf core:hasPort ],
        core:isPortOf ;
    skos:definition "Relates a topside equipment to a physical port interface that belongs to it."@en .

prop:DesignPressureSpecification a owl:Class ;
    rdfs:label "Design Pressure Specification"@en,
        "Especificação de Pressão de Projeto"@pt ;
    rdfs:subClassOf iof-core:DesignSpecification ;
    skos:definition "Design specification prescribing the maximum design pressure / MAWP of a pressure vessel or piping."@en .

prop:PressureValueExpression a owl:Class ;
    rdfs:label "Pressure Value Expression"@en,
        "Expressão de Valor de Pressão"@pt ;
    rdfs:subClassOf iof-core:ValueExpression ;
    skos:definition "A value expression representing pressure paired with a pressure unit of measure (e.g. bar, pascal, psi from UO)."@en .

prop:hasPowerTurbine a owl:ObjectProperty ;
    rdfs:label "has power turbine"@en,
        "tem turbina de potência"@pt ;
    rdfs:domain dynamical:GasTurbineEquipment ;
    rdfs:range dynamical:PowerTurbine ;
    owl:inverseOf [ owl:inverseOf prop:hasPowerTurbine ] .

static:CrudeExchanger a owl:Class ;
    rdfs:label "Crude Exchanger"@en,
        "Trocador de Calor de Petróleo"@pt ;
    rdfs:isDefinedBy "ISO 16812" ;
    rdfs:subClassOf static:HeatExchangeEquipment,
        o3po:HeatExchanger .

static:CrudeHeater a owl:Class ;
    rdfs:label "Crude Heater"@en,
        "Aquecedor de Petróleo"@pt ;
    rdfs:isDefinedBy "API Spec 12K" ;
    rdfs:subClassOf static:HeatExchangeEquipment,
        o3po:HeatExchanger,
        o3po:Heater .

static:CrudePreheater a owl:Class ;
    rdfs:label "Crude Preheater"@en,
        "Pré-aquecedor de Petróleo"@pt ;
    rdfs:isDefinedBy "ISO 16812 / API Spec 12K" ;
    rdfs:subClassOf static:HeatExchangeEquipment,
        o3po:HeatExchanger,
        o3po:Heater .

static:IntegratedLPFlareTip a owl:Class ;
    rdfs:label "Integrated LP Flare Tip"@en,
        "Ponteira do Flare de Baixa Pressão"@pt ;
    rdfs:isDefinedBy "ISO 23251 (API 521)" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "0"^^xsd:nonNegativeInteger ;
            owl:onProperty core:feedsFluidToEquipment ],
        [ a owl:Restriction ;
            owl:cardinality "0"^^xsd:nonNegativeInteger ;
            owl:onProperty core:feedsFluidToEquipment ],
        [ a owl:Restriction ;
            owl:cardinality "0"^^xsd:nonNegativeInteger ;
            owl:onProperty core:feedsFluidToEquipment ],
        static:StorageAndPipingHeaderEquipment .

iof-core:EngineeredSystem a owl:Class ;
    rdfs:subClassOf owl:Thing .

<https://www.inf.ufrgs.br/bdi/ontologies/GEOCORE_0000009> a owl:Class ;
    rdfs:subClassOf owl:Thing .

o3po:Cooler a owl:Class ;
    rdfs:label "cooler"@en,
        "resfriador"@pt-br ;
    ns1:definition "def. A heat exchanger designed to reduce the temperature of a process fluid by transferring heat to a cooling medium (air or water)."@en ;
    rdfs:subClassOf static:HeatExchangeEquipment,
        o3po:HeatExchanger .

o3po:Field a owl:Class ;
    rdfs:label "field"@en,
        "campo"@pt-br ;
    ns1:definition "def. a two-dimensional continuant faunal boundary that is an area where one or more reservoirs, grouped on by the same individual geological structural feature and/or stratigraphic condition, exist in the subsurface with the possibility of sufficient economic benefit worthy of commercial attention for exploration and production of hydrocarbons"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty uo:RO_0001025 ;
            owl:someValuesFrom o3po:Basin ],
        [ a owl:Restriction ;
            owl:onProperty uo:RO_0001025 ;
            owl:someValuesFrom o3po:Basin ],
        uo:BFO_0000146 .

o3po:Filter a owl:Class ;
    rdfs:label "filter"@en,
        "filtro"@pt-br ;
    ns1:definition "def. A material artifact containing a porous medium or screen designed to remove solid particles or liquid droplets from a fluid stream."@en ;
    rdfs:subClassOf static:SeparationAndFilterEquipment,
        iof-core:MaterialArtifact .

o3po:ICVFlowRate a owl:Class ;
    rdfs:label "ICV flow rate"@en,
        "vazão na ICV"@pt-br ;
    ns1:definition "def. a flow rate that is a process characteristic of a flow that occurs inside an ICV"@en ;
    rdfs:comment "the rate of a flow that occurs inside an ICV"@en ;
    rdfs:subClassOf o3po:FlowRate ;
    owl:disjointWith o3po:WellFlowRate .

o3po:ObservationWell a owl:Class ;
    rdfs:label "observation well"@en,
        "poço de observação"@pt-br ;
    ns2:source "Oil and Gas Wells, Pennsylvania Code, Title 25, Chapter 78, December 2012."@en,
        "https://iadclexicon.org/observation-well/"@en ;
    ns1:definition "def. a well that bears an observation role"@en ;
    rdfs:comment "A well used to monitor the operational integrity and conditions in a gas storage reservoir, the reservoir protective area or strata above or below the gas storage horizon."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty iof-core:hasRole ;
            owl:someValuesFrom o3po:ObservationRole ],
        [ a owl:Restriction ;
            owl:onProperty iof-core:hasRole ;
            owl:someValuesFrom o3po:ObservationRole ],
        o3po:Well .

o3po:Platform a owl:Class ;
    rdfs:label "platform"@en,
        "plataforma"@pt-br ;
    ns2:source "https://petrowiki.spe.org/Glossary:Platform"@en ;
    ns1:definition "def. a material artifact that is an offshore structure from which a well may be drilled or produced"@en ;
    rdfs:comment "An offshore structure from which a well may be drilled or produced."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty uo:RO_0001025 ;
            owl:someValuesFrom o3po:Field ],
        [ a owl:Restriction ;
            owl:onProperty uo:RO_0001025 ;
            owl:someValuesFrom o3po:Field ],
        iof-core:MaterialArtifact ;
    owl:disjointWith o3po:Well .

o3po:Separator a owl:Class ;
    rdfs:label "separator"@en,
        "separador"@pt-br ;
    ns2:source "https://petrowiki.spe.org/Glossary:Separator"@en ;
    ns1:definition "def. a material artifact that facilitates the separation of gas, oil, and/or water from a produced fluid stream"@en ;
    rdfs:comment "A production treating vessel designed to facilitate the separation of gas, oil, and/or water from a produced fluid stream."@en ;
    rdfs:subClassOf iof-core:MaterialArtifact .

o3po:Tubing a owl:Class ;
    rdfs:label "tubing"@en,
        "coluna de produção"@pt-br ;
    ns1:definition "def. a pipeline that is inside a well"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty uo:RO_0000087 ;
            owl:someValuesFrom o3po:TubingRole ],
        [ a owl:Restriction ;
            owl:onProperty iof-core:componentPartOfAtSomeTime ;
            owl:someValuesFrom o3po:Well ],
        [ a owl:Restriction ;
            owl:onProperty uo:RO_0000087 ;
            owl:someValuesFrom o3po:TubingRole ],
        [ a owl:Restriction ;
            owl:onProperty iof-core:componentPartOfAtSomeTime ;
            owl:someValuesFrom o3po:Well ],
        o3po:Pipeline .

o3po:connectedTo a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "connected to"@en,
        "conectado a"@pt-br ;
    rdfs:domain uo:BFO_0000040 ;
    rdfs:range uo:BFO_0000040 ;
    owl:inverseOf [ owl:inverseOf o3po:connectedTo ],
        o3po:connectedTo .

abox:FPSO_P78 a owl:NamedIndividual,
        owl:Thing,
        iof-core:MaterialArtifact,
        o3po:FPSO,
        o3po:Platform ;
    rdfs:label "FPSO P-78 Marechal Duque"@en ;
    uo:RO_0001015 abox:Module_M01,
        abox:Module_M02 ;
    core:hasFPSOModule abox:Module_M01,
        abox:Module_M02 ;
    rdfs:comment "Navio Plataforma FPSO P-78 alocado no Campo de Búzios, Pré-Sal da Bacia de Santos"@pt .

abox:HV_Switchgear_01 a electrical:HighVoltageSwitchgear,
        electrical:PowerDistributionAndSwitchingEquipment,
        core:ElectricalEquipment,
        core:TopsideEquipment,
        owl:NamedIndividual,
        owl:Thing,
        iof-core:MaterialArtifact ;
    rdfs:label "SWG-HV-01 Main High Voltage Switchgear"@en ;
    uo:RO_0001025 abox:Module_M06 ;
    core:hasPort abox:HV01_Port_Elec ;
    core:isLocatedInModule abox:Module_M06 ;
    core:powersEquipment abox:PowerTransformer_TR01 .

<http://usp.ai/ontologies/fpeo-equipments-core> a owl:Ontology ;
    dc:creator "Hugo Cardoso Ferreira de Araújo" ;
    dc:description "Core Module for FPEO-Equipments Ontology defining fundamental equipment classes, ports, and flow properties"@en ;
    owl:imports <https://www.inf.ufrgs.br/ontologies/o3po/2.0> .

static:CoolingMediumSeawaterExchanger a owl:Class ;
    rdfs:label "Cooling Medium Seawater Exchanger"@en,
        "Trocador de Calor Fluido Refrigerante e Água do Mar"@pt ;
    rdfs:isDefinedBy "ISO 16812" ;
    rdfs:subClassOf static:HeatExchangeEquipment,
        o3po:Cooler ;
    owl:disjointWith [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf core:feedsFluidToEquipment ] ;
            owl:someValuesFrom dynamical:HighPressureCompressor ] ;
    skos:altLabel "Cooling Medium SW Heat Exchanger"@en,
        "Trocador de Calor Fluido Refrigerante / Água do Mar"@pt .

static:ParticulateFilterEquipment a owl:Class ;
    rdfs:label "Particulate Filter Equipment"@en,
        "Filtro de Particulados"@pt ;
    rdfs:subClassOf static:FilterEquipment,
        o3po:Filter ;
    owl:disjointWith static:CoalescingFilterEquipment ;
    owl:equivalentClass o3po:ParticulateFilter ;
    skos:definition "A filter designed primarily for retaining suspended solid particles from fluid streams."@en .

iof-core:hasRole a owl:ObjectProperty ;
    owl:inverseOf [ owl:inverseOf iof-core:hasRole ] .

iof-core:isAbout a owl:ObjectProperty ;
    owl:inverseOf [ owl:inverseOf iof-core:isAbout ] .

o3po:Pump a owl:Class ;
    rdfs:label "pump"@en,
        "bomba"@pt-br ;
    ns2:source "https://www.lexico.com/en/definition/pump"@en ;
    ns1:definition "def. a material artifact that moves fluids or fluid-like amounts (e.g., slurries) by increasing pressure of the fluid or pressure difference in a fluid flow"@en ;
    rdfs:comment "Device that moves (e.g., transfer, deliver, compress) fluids (e.g., liquids, gases) or fluid-like amounts (e.g., slurries) by increasing pressure."@en ;
    rdfs:subClassOf core:DynamicalEquipment,
        iof-core:MaterialArtifact .

o3po:Reservoir a owl:Class ;
    rdfs:label "reservoir"@en,
        "reservatório"@pt-br ;
    ns1:definition "def. a rock that contains one or more individual and separate natural accumulations of petroleum that is confined (the oil, not the reservoir) by impermeable rock"@en ;
    rdfs:comment "A rock (defined in GeoCore) containing one or more individual and separate natural accumulations of petroleum that is confined (the oil, not the reservoir) by impermeable rock."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty uo:BFO_0000051 ;
            owl:someValuesFrom <https://www.inf.ufrgs.br/bdi/ontologies/GEOCORE_0000009> ],
        [ a owl:Restriction ;
            owl:onProperty uo:RO_0000087 ;
            owl:someValuesFrom o3po:ReservoirRole ],
        [ a owl:Restriction ;
            owl:onProperty uo:BFO_0000051 ;
            owl:someValuesFrom <https://www.inf.ufrgs.br/bdi/ontologies/GEOCORE_0000009> ],
        [ a owl:Restriction ;
            owl:onProperty uo:RO_0000087 ;
            owl:someValuesFrom o3po:ReservoirRole ],
        <https://www.inf.ufrgs.br/bdi/ontologies/GEOCORE_0000008> .

o3po:Temperature a owl:Class ;
    rdfs:label "temperature"@en,
        "temperatura"@pt-br ;
    ns1:definition "def. a BFO:Quality that corresponds to the degree/intensity of the thermal energy of a BFO:Material_Entity"@en ;
    rdfs:comment "A quality that corresponds to the degree/intensity of the thermal energy of a material entity."@en ;
    rdfs:subClassOf uo:BFO_0000019 .

o3po:Tube a owl:Class ;
    rdfs:label "tube"@en,
        "tubo"@pt-br ;
    ns2:hasRelatedSynonym "duct"@en,
        "pipe"@en,
        "tubular"@en ;
    ns1:definition "def. a material artifact that is long, enclosed and hollow and that acts as a passageway to carry different sorts of things (e.g., fluids, cables, other ducts)"@en ;
    rdfs:comment "Functional Object / Material Artifact that is enclosed and hollow and that acts as a passageway to carry different sorts of things (e.g., fluids, cables, other ducts)."@en ;
    rdfs:subClassOf iof-core:MaterialArtifact .

o3po:measures a owl:ObjectProperty ;
    rdfs:label "measures"@en,
        "mede"@pt-br ;
    ns1:definition "def. a relation between a sensor and a quality that the sensor is designed to measure"@en ;
    rdfs:domain o3po:Sensor ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( uo:BFO_0000019 iof-core:ProcessCharacteristic ) ],
        [ a owl:Class ;
            owl:unionOf ( uo:BFO_0000019 iof-core:ProcessCharacteristic ) ] ;
    owl:inverseOf [ owl:inverseOf o3po:measures ] .

uo:BFO_0000023 a owl:Class ;
    rdfs:subClassOf owl:Thing .

uo:BFO_0000050 a owl:ObjectProperty ;
    owl:inverseOf [ owl:inverseOf uo:BFO_0000050 ] .

uo:BFO_0000051 a owl:ObjectProperty ;
    owl:inverseOf [ owl:inverseOf uo:BFO_0000051 ] .

abox:Module_M02 a core:FPSOModule,
        owl:NamedIndividual,
        owl:Thing,
        iof-core:EngineeredSystem ;
    rdfs:label "M-02 Flare & VRU System"@en ;
    uo:RO_0001015 abox:EmergencyGenerator_EDG01,
        abox:MCC_Emergency,
        abox:VRUCompressor_K01 ;
    uo:RO_0001025 abox:FPSO_P78 ;
    core:containsEquipment abox:EmergencyGenerator_EDG01,
        abox:MCC_Emergency,
        abox:VRUCompressor_K01 ;
    core:isLocatedInFPSO abox:FPSO_P78 ;
    rdfs:comment "Módulo M-02: Sistema de Flare e Recuperação de Vapores (VRU)"@pt .

abox:Module_M08 a core:FPSOModule,
        owl:NamedIndividual,
        owl:Thing,
        iof-core:EngineeredSystem ;
    rdfs:label "M-08 Oil Processing Module"@en ;
    uo:RO_0001015 abox:TestInletHeater_E02,
        abox:TestOilPump_P02,
        abox:TestSeparator_V01 ;
    uo:RO_0001025 abox:FPSO_P79 ;
    core:containsEquipment abox:TestInletHeater_E02,
        abox:TestOilPump_P02,
        abox:TestSeparator_V01 ;
    core:isLocatedInFPSO abox:FPSO_P79 ;
    rdfs:comment "Módulo M-08: Separação, Aquecimento e Tratamento Eletrostático de Petróleo"@pt .

dynamical:PumpEquipment a owl:Class ;
    rdfs:label "Pump Equipment"@en,
        "Equipamento Bomba"@pt ;
    rdfs:subClassOf core:DynamicalEquipment ;
    owl:equivalentClass o3po:Pump ;
    skos:definition "A dynamical equipment engineered to transport or increase the pressure of an incompressible fluid (liquid) through continuous or positive displacement movement."@en .

core:FPSOModule a owl:Class ;
    rdfs:label "FPSO Module"@en,
        "Módulo do FPSO"@pt ;
    rdfs:subClassOf iof-core:EngineeredSystem ;
    skos:definition "A distinct structural and functional topside module/skid of a Floating Production Storage and Offloading (FPSO) facility, integrating equipment, piping, electrical, and control systems for a designated process or utility function."@en .

core:ValveAndSecurityEquipment a owl:Class ;
    rdfs:label "Valve and Security Equipment"@en ;
    rdfs:subClassOf core:TopsideEquipment ;
    owl:equivalentClass o3po:Valve ;
    skos:definition "A topside equipment designed to control, isolate, block, or relieve fluid flow and pressure to maintain operational safety and protect against overpressure events."@en .

prop:PowerValueExpression a owl:Class ;
    rdfs:label "Power Value Expression"@en,
        "Expressão de Valor de Potência"@pt ;
    rdfs:subClassOf iof-core:ValueExpression ;
    skos:definition "A value expression representing a quantified power magnitude paired with a power unit of measure (e.g. watt, megawatt from UO)."@en .

static:CleanSlopTank a owl:Class ;
    rdfs:label "Clean Slop Tank"@en,
        "Tanque de Slop Limpo"@pt ;
    rdfs:isDefinedBy "API Spec 14E" ;
    rdfs:subClassOf static:StorageAndPipingHeaderEquipment ;
    owl:disjointWith static:DirtySlopTank .

static:DeoilingHydrocyclone a owl:Class ;
    rdfs:label "Deoiling Hydrocyclone"@en,
        "Hidrocclone Desoleador"@pt ;
    rdfs:isDefinedBy "API Spec 12L" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty core:feedsFluidToEquipment ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( static:GasFlotationCell static:ProducedWaterInletCooler static:ProducedWaterOverboardCooler static:WaterSkimVessel ) ] ],
        [ a owl:Restriction ;
            owl:onProperty core:feedsFluidToEquipment ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( static:GasFlotationCell static:ProducedWaterInletCooler static:ProducedWaterOverboardCooler static:WaterSkimVessel ) ] ],
        [ a owl:Restriction ;
            owl:onProperty core:feedsFluidToEquipment ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( static:GasFlotationCell static:ProducedWaterInletCooler static:ProducedWaterOverboardCooler static:WaterSkimVessel ) ] ],
        uo:BFO_0000040,
        static:SeparationAndFilterEquipment .

static:IntegratedHPFlareTip a owl:Class ;
    rdfs:label "Integrated HP Flare Tip"@en,
        "Ponteira do Flare de Alta Pressão"@pt ;
    rdfs:isDefinedBy "ISO 23251 (API 521)" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "0"^^xsd:nonNegativeInteger ;
            owl:onProperty core:feedsFluidToEquipment ],
        [ a owl:Restriction ;
            owl:cardinality "0"^^xsd:nonNegativeInteger ;
            owl:onProperty core:feedsFluidToEquipment ],
        [ a owl:Restriction ;
            owl:cardinality "0"^^xsd:nonNegativeInteger ;
            owl:onProperty core:feedsFluidToEquipment ],
        static:StorageAndPipingHeaderEquipment ;
    owl:disjointWith static:IntegratedLPFlareTip .

o3po:Fluid a owl:Class ;
    rdfs:label "fluid (portion of)"@en,
        "fluido (porção de)"@pt-br ;
    uo:IAO_0000112 "A puddle of water, this particular pile of sand, a barrel of oil."@en ;
    ns1:definition "def. a BFO:Object that is in liquid or gas form and is able to flow in response to external pressure and has no fixed shape"@en ;
    rdfs:comment "Portion of Substance (e.g., liquid or gas) that tends/is able to flow in response to external pressure and has no fixed shape."@en ;
    rdfs:subClassOf uo:BFO_0000030 .

o3po:Heater a owl:Class ;
    rdfs:label "heater"@en,
        "aquecedor"@pt-br ;
    ns1:definition "def. A material artifact designed to raise the temperature of a fluid, typically using an external heat source (combustion or electricity)."@en ;
    rdfs:subClassOf iof-core:MaterialArtifact .

o3po:ParticulateFilter a owl:Class ;
    rdfs:label "particulate filter"@en,
        "filtro de particulado"@pt-br ;
    ns1:definition "def. A filter designed principally to remove solid particulate matter from a fluid stream."@en ;
    rdfs:subClassOf static:FilterEquipment,
        o3po:Filter .

o3po:Sensor a owl:Class ;
    rdfs:label "sensor"@en,
        "sensor"@pt-br ;
    uo:IAO_0000112 "Accelerometers, gyroscopes, barometers, magnetometers, and so forth are Sensors that are typically mounted on a modern smart phone (which acts as Platform). Other examples of Sensors include the human eyes."@en ;
    ns1:definition "def. a material artifact that generates a result in response to some stimulus (e.g., a change in its environment) or input data from results of prior observations, with such result corresponding to the measurement of a physical property"@en ;
    rdfs:comment "A device that produces an output signal for the purpose of sensing of a physical phenomenon."@en ;
    rdfs:seeAlso "https://en.wikipedia.org/wiki/Sensor"^^xsd:anyURI ;
    rdfs:subClassOf iof-core:MaterialArtifact .

o3po:componentOf a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "component of"@en,
        "componente de"@pt-br ;
    ns1:definition "def. a part of relation that holds between two material entities"@en ;
    rdfs:domain uo:BFO_0000040 ;
    rdfs:range uo:BFO_0000040 ;
    rdfs:subPropertyOf uo:BFO_0000050 ;
    owl:inverseOf [ owl:inverseOf o3po:componentOf ],
        o3po:hasComponent .

uo:RO_0000087 a owl:ObjectProperty ;
    owl:inverseOf [ owl:inverseOf uo:RO_0000087 ] .

uo:RO_0001025 a owl:ObjectProperty ;
    owl:inverseOf [ owl:inverseOf uo:RO_0001025 ] .

electrical:MotorControlCenter a owl:Class ;
    rdfs:label "Motor Control Center (MCC)"@en,
        "Centro de Controle de Motores (CCM)"@pt ;
    rdfs:isDefinedBy "IEC 61439-2" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty core:powersEquipment ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( electrical:ElectricMotorEquipment electrical:VariableSpeedDrive ) ] ],
        [ a owl:Restriction ;
            owl:onProperty core:powersEquipment ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( electrical:ElectricMotorEquipment electrical:VariableSpeedDrive ) ] ],
        [ a owl:Restriction ;
            owl:onProperty core:powersEquipment ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( electrical:ElectricMotorEquipment electrical:VariableSpeedDrive ) ] ],
        electrical:PowerDistributionAndSwitchingEquipment ;
    skos:definition "Assembly to control electric motors in a central location, comprising motor starters, contactors, and protection relays."@en .

electrical:PowerDistributionAndSwitchingEquipment a owl:Class ;
    rdfs:label "Power Distribution and Switching Equipment"@en,
        "Equipamento de Distribuição e Manobra Elétrica"@pt ;
    rdfs:subClassOf core:ElectricalEquipment ;
    skos:definition "An electrical equipment engineered to route, switch, protect, and isolate electrical circuits across topside modules."@en .

electrical:VariableSpeedDrive a owl:Class ;
    rdfs:label "Variable Speed Drive"@en,
        "Inversor de Frequência"@pt ;
    rdfs:isDefinedBy "IEC 61800" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty core:powersEquipment ;
            owl:someValuesFrom electrical:ElectricMotorEquipment ],
        [ a owl:Restriction ;
            owl:onProperty core:powersEquipment ;
            owl:someValuesFrom electrical:ElectricMotorEquipment ],
        [ a owl:Restriction ;
            owl:onProperty core:powersEquipment ;
            owl:someValuesFrom electrical:ElectricMotorEquipment ],
        electrical:PowerTransformationAndConversionEquipment ;
    skos:altLabel "VSD"@en,
        "VSD"@pt ;
    skos:definition "Power electronics equipment that controls motor speed and torque by adjusting power supply frequency and voltage."@en .

static:NonHazardousOpenDrainHeader a owl:Class ;
    rdfs:label "Non-Hazardous Open Drain Header"@en,
        "Coletor de Dreno Aberto Não-Perigoso"@pt ;
    rdfs:isDefinedBy "API Spec 14E" ;
    rdfs:subClassOf static:StorageAndPipingHeaderEquipment .

iof-core:hasQuality a owl:ObjectProperty ;
    owl:inverseOf [ owl:inverseOf iof-core:hasQuality ] .

uo:BFO_0000019 a owl:Class ;
    rdfs:subClassOf owl:Thing .

uo:UO_0000000 a owl:Class ;
    rdfs:subClassOf owl:Thing .

abox:Module_M01 a core:FPSOModule,
        owl:NamedIndividual,
        owl:Thing,
        iof-core:EngineeredSystem ;
    rdfs:label "M-01 CO2 & Seawater Module"@en ;
    uo:RO_0001015 abox:Motor_P01,
        abox:SeawaterCooler_E01,
        abox:SeawaterLiftPump_P01,
        abox:SeawaterStrainer_F01 ;
    uo:RO_0001025 abox:FPSO_P78 ;
    core:containsEquipment abox:Motor_P01,
        abox:SeawaterCooler_E01,
        abox:SeawaterLiftPump_P01,
        abox:SeawaterStrainer_F01 ;
    core:isLocatedInFPSO abox:FPSO_P78 ;
    rdfs:comment "Módulo M-01: Captação de Água do Mar, Resfriamento e Compressão de CO2"@pt .

core:InstrumentationAndControlEquipment a owl:Class ;
    rdfs:label "Instrumentation and Control Equipment"@en,
        "Equipamento de Instrumentação e Controle"@pt ;
    rdfs:subClassOf core:TopsideEquipment ;
    skos:definition "A topside equipment designed to measure, monitor, transmit, or control physical process variables (e.g., pressure, temperature, flow, level) or send signal interlocks for plant automation and safety."@en .

prop:EquipmentTagIdentifier a owl:Class ;
    rdfs:label "Equipment Tag Identifier"@en,
        "Identificador de Tag de Equipamento"@pt ;
    rdfs:subClassOf iof-core:Identifier ;
    skos:altLabel "Equipment Tag"@en,
        "Tag de Equipamento"@pt ;
    skos:definition "An identifier assigned by engineering convention (e.g. ISA-5.1) that denotes a unique equipment in the process plant."@en .

prop:RatedPowerSpecification a owl:Class ;
    rdfs:label "Rated Power Specification"@en,
        "Especificação de Potência Nominal"@pt ;
    rdfs:subClassOf iof-core:DesignSpecification ;
    skos:definition "Design specification prescribing the nominal power capacity of a machine under rated conditions (ISO 3977-1)."@en .

o3po:Pipeline a owl:Class ;
    rdfs:label "pipeline"@en,
        "tubulação"@pt-br ;
    ns2:source "https://petrowiki.org/Glossary:Flowline"@en ;
    ns1:definition "def. an assembly that is necessarily composed of tubes which are connected to one another in a single, maximal/end-to-end line, and that is intended for conveying liquids, gases or finely divided solids"@en ;
    rdfs:comment "The pipe connection between the well and the separators or tank battery."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty o3po:hasComponent ;
            owl:someValuesFrom o3po:Tube ],
        [ a owl:Restriction ;
            owl:onProperty o3po:hasComponent ;
            owl:someValuesFrom o3po:Tube ],
        uo:BFO_0000040,
        iof-core:Assembly ;
    owl:disjointWith o3po:Sensor .

o3po:hasComponent a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "has component"@en,
        "tem componente"@pt-br ;
    rdfs:subPropertyOf uo:BFO_0000051 ;
    owl:inverseOf [ owl:inverseOf o3po:hasComponent ],
        o3po:componentOf .

prop:EquipmentDesignDocument a owl:Class ;
    rdfs:label "Equipment Design Document"@en,
        "Documento de Projeto do Equipamento"@pt ;
    rdfs:subClassOf iof-core:DesignDocument ;
    skos:altLabel "Equipment Datasheet"@en,
        "Folha de Dados do Equipamento"@pt ;
    skos:definition "An organized collection of information content entities comprising technical design prescriptions, ratings, and identifiers describing a physical topside equipment."@en .

static:StorageAndPipingHeaderEquipment a owl:Class ;
    rdfs:label "Storage and Piping Header Equipment"@en,
        "Equipamento de Armazenamento e Coleta"@pt ;
    rdfs:subClassOf core:StaticEquipment ;
    skos:definition "A static equipment designed for fluid storage or collection from multiple drain/process lines."@en .

o3po:ICV a owl:Class ;
    rdfs:label "inflow control valve"@en,
        "válvula de controle de influxo"@pt-br ;
    uo:IAO_0000118 "válvula de completação inteligente"@pt-br ;
    ns1:acronym "ICV"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty iof-core:hasQuality ;
            owl:someValuesFrom o3po:ICVAnnularPressure ],
        [ a owl:Restriction ;
            owl:onProperty iof-core:hasQuality ;
            owl:someValuesFrom o3po:ICVAnnularTemperature ],
        [ a owl:Restriction ;
            owl:onProperty iof-core:hasQuality ;
            owl:someValuesFrom o3po:ICVDeltaPressure ],
        [ a owl:Restriction ;
            owl:onProperty iof-core:hasQuality ;
            owl:someValuesFrom o3po:ICVOpenControlLinePressure ],
        [ a owl:Restriction ;
            owl:onProperty o3po:componentOf ;
            owl:someValuesFrom o3po:Tubing ],
        [ a owl:Restriction ;
            owl:onProperty iof-core:hasQuality ;
            owl:someValuesFrom o3po:ICVAnnularPressure ],
        [ a owl:Restriction ;
            owl:onProperty iof-core:hasQuality ;
            owl:someValuesFrom o3po:ICVAnnularTemperature ],
        [ a owl:Restriction ;
            owl:onProperty iof-core:hasQuality ;
            owl:someValuesFrom o3po:ICVDeltaPressure ],
        [ a owl:Restriction ;
            owl:onProperty iof-core:hasQuality ;
            owl:someValuesFrom o3po:ICVOpenControlLinePressure ],
        [ a owl:Restriction ;
            owl:onProperty o3po:componentOf ;
            owl:someValuesFrom o3po:Tubing ],
        core:ValveAndSecurityEquipment,
        o3po:Valve .

o3po:Pressure a owl:Class ;
    rdfs:label "pressure"@en,
        "pressão"@pt-br ;
    ns1:definition "def. a BFO:Quality that corresponds to the degree/intensity of the force applied perpendicular to the surface of a BFO:Material_Entity per unit area over which that force is distributed"@en ;
    rdfs:comment "A quality that corresponds to the degree/intensity of the force applied perpendicular to the surface of a material entity per unit area over which that force is distributed."@en ;
    rdfs:subClassOf uo:BFO_0000019 .

abox:Module_M06 a core:FPSOModule,
        owl:NamedIndividual,
        owl:Thing,
        iof-core:EngineeredSystem ;
    rdfs:label "M-06 Main Gas Compression & Power"@en ;
    uo:RO_0001015 abox:HV_Switchgear_01,
        abox:LPCompressor_K02,
        abox:MCC_01,
        abox:MainTurbineGenerator_GTG01,
        abox:PowerTransformer_TR01 ;
    uo:RO_0001025 abox:FPSO_P79 ;
    core:containsEquipment abox:HV_Switchgear_01,
        abox:LPCompressor_K02,
        abox:MCC_01,
        abox:MainTurbineGenerator_GTG01,
        abox:PowerTransformer_TR01 ;
    core:isLocatedInFPSO abox:FPSO_P79 ;
    rdfs:comment "Módulo M-06: Compressão Principal de Gás e Geração de Energia"@pt .

dynamical:CompressorEquipment a owl:Class ;
    rdfs:label "Compressor Equipment"@en,
        "Equipamento Compressor"@pt ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty core:feedsFluidToEquipment ;
            owl:someValuesFrom [ owl:complementOf static:IntegratedHPFlareTip ] ],
        uo:BFO_0000040,
        core:DynamicalEquipment ;
    owl:disjointWith [ a owl:Restriction ;
            owl:onProperty core:feedsFluidToEquipment ;
            owl:someValuesFrom static:IntegratedHPFlareTip ],
        [ a owl:Restriction ;
            owl:onProperty core:feedsFluidToEquipment ;
            owl:someValuesFrom static:IntegratedHPFlareTip ] ;
    skos:definition "A dynamical equipment engineered to increase the pressure of a compressible fluid (gas or vapor) by absorbing mechanical work."@en .

core:StaticEquipment a owl:Class ;
    rdfs:label "Static Equipment"@en ;
    rdfs:subClassOf core:TopsideEquipment ;
    skos:definition "A topside equipment designed to contain, separate, filter, or transfer mass and heat between fluids without relying on primary rotating moving parts to achieve its main process function."@en .

static:SeparationAndFilterEquipment a owl:Class ;
    rdfs:label "Separation and Filter Equipment"@en,
        "Equipamento de Separação e Filtração"@pt ;
    rdfs:subClassOf core:StaticEquipment ;
    skos:definition "A static equipment designed to separate fluid phases, particulate solids, or molecular compounds."@en .

iof-core:DesignDocument a owl:Class ;
    rdfs:subClassOf owl:Thing .

o3po:CentrifugalPump a owl:Class ;
    rdfs:label "centrifugal pump"@en,
        "bomba centrífuga"@pt-br ;
    ns1:definition "def. a pump where the rotary motion applies centrifugal force to discharge fluids from the pump"@en ;
    rdfs:seeAlso "https://www.glossary.oilfield.slb.com/Terms/c/centrifugal_pump.aspx" ;
    rdfs:subClassOf dynamical:PumpEquipment,
        o3po:Pump ;
    owl:disjointWith o3po:PositiveDisplacementPump .

abox:MainTurbineGenerator_GTG01 a uo:BFO_0000040,
        electrical:MainTurbineGenerator,
        electrical:PowerGenerationEquipment,
        core:ElectricalEquipment,
        core:TopsideEquipment,
        owl:NamedIndividual,
        owl:Thing,
        iof-core:MaterialArtifact ;
    rdfs:label "GTG-01 Main Gas Turbine Generator"@en ;
    uo:BFO_0000051 abox:CombustionChamber_GTG01,
        abox:Shaft_GTG01 ;
    uo:RO_0001025 abox:Module_M06 ;
    core:hasPort abox:GTG01_Port_Elec ;
    core:isLocatedInModule abox:Module_M06 ;
    core:powersEquipment abox:HV_Switchgear_01 ;
    o3po:hasComponent abox:CombustionChamber_GTG01,
        abox:Shaft_GTG01 .

dynamical:CentrifugalPumpEquipment a owl:Class ;
    rdfs:label "Centrifugal Pump Equipment"@en,
        "Equipamento Bomba Centrífuga"@pt ;
    rdfs:isDefinedBy "ISO 13709 / API Std 610" ;
    rdfs:subClassOf dynamical:PumpEquipment,
        o3po:Pump ;
    owl:equivalentClass o3po:CentrifugalPump ;
    skos:altLabel "Kinetic Pump Equipment"@en,
        "Bomba Cinética"@pt ;
    skos:definition "A pump equipment that converts rotational kinetic energy from an impeller into hydrodynamic energy to transport fluids."@en .

dynamical:GasTurbineEquipment a owl:Class ;
    rdfs:label "Gas Turbine Equipment"@en,
        "Equipamento Turbina a Gás"@pt ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty prop:hasCombustionChamber ;
            owl:someValuesFrom dynamical:CombustionChamber ],
        [ a owl:Restriction ;
            owl:onProperty iof-core:isPrescribedBy ;
            owl:someValuesFrom prop:RatedPowerSpecification ],
        [ a owl:Restriction ;
            owl:onProperty iof-core:isPrescribedBy ;
            owl:someValuesFrom prop:RatedSpeedSpecification ],
        core:DynamicalEquipment ;
    skos:definition "A internal combustion rotary engine that extracts energy from a flow of hot combustion gas produced by the continuous burning of fuel."@en .

electrical:HighVoltageSwitchgear a owl:Class ;
    rdfs:label "High Voltage Switchgear"@en,
        "Painel de Alta Tensão"@pt ;
    rdfs:isDefinedBy "IEC 62271 / IEC 61892-3" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty core:powersEquipment ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( electrical:PowerTransformer electrical:VariableSpeedDrive electrical:ElectricMotorEquipment ) ] ],
        [ a owl:Restriction ;
            owl:onProperty core:powersEquipment ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( electrical:PowerTransformer electrical:VariableSpeedDrive electrical:ElectricMotorEquipment ) ] ],
        [ a owl:Restriction ;
            owl:onProperty core:powersEquipment ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( electrical:PowerTransformer electrical:VariableSpeedDrive electrical:ElectricMotorEquipment ) ] ],
        electrical:PowerDistributionAndSwitchingEquipment ;
    skos:altLabel "HV Switchgear"@en,
        "Painel de Média Tensão"@pt ;
    skos:definition "Assembly of primary switching and circuit-breaking devices for main high voltage electrical distribution."@en .

core:DynamicalEquipment a owl:Class ;
    rdfs:label "Dynamical Equipment"@en ;
    rdfs:subClassOf core:TopsideEquipment ;
    skos:definition "Topside equipment that utilizes mechanical work and continuous rotational or positive displacement motion to pressurize, transport, or compress process and utility fluids."@en .

iof-core:Identifier a owl:Class ;
    rdfs:subClassOf owl:Thing .

o3po:HeatExchanger a owl:Class ;
    rdfs:label "heat exchanger"@en,
        "trocador de calor"@pt-br ;
    ns1:definition "def. A material artifact designed to transfer thermal energy from one fluid to another without them mixing."@en ;
    rdfs:subClassOf core:StaticEquipment,
        iof-core:MaterialArtifact .

o3po:Valve a owl:Class ;
    rdfs:label "valve"@en,
        "válvula"@pt-br ;
    ns1:definition "def. a functional complex that controls flow of fluids or fluid-like amounts (e.g., slurries, fluidized solids)"@en ;
    rdfs:comment "Device that controls (e.g., permits, obstructs, regulates, directs) a stream/flow of fluids (e.g., gases, liquids) or fluid-like amounts (e.g., slurries, fluidized solids)."@en ;
    rdfs:subClassOf core:TopsideEquipment,
        iof-core:MaterialArtifact .

o3po:Vessel a owl:Class ;
    rdfs:label "vessel"@en,
        "vaso"@pt-br ;
    ns1:definition "def. A closed container designed to hold gases or liquids at a pressure substantially different from the ambient pressure."@en ;
    rdfs:seeAlso "https://en.wikipedia.org/wiki/Pressure_vessel" ;
    rdfs:subClassOf core:StaticEquipment,
        iof-core:MaterialArtifact .

dynamical:TurbineComponentEquipment a owl:Class ;
    rdfs:label "Turbine Subcomponent Equipment"@en,
        "Subcomponente de Turbina"@pt ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "0"^^xsd:nonNegativeInteger ;
            owl:onProperty core:feedsFluidToEquipment ],
        core:DynamicalEquipment ;
    skos:definition "Rotary or structural mechanical artifact designed as a functional assembly or core component within a gas turbine drive system."@en .

core:InletPort a owl:Class ;
    rdfs:label "Inlet Port"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:complementOf core:InletPort ] ;
            owl:onProperty core:portConnectedTo ],
        [ a owl:Restriction ;
            owl:allValuesFrom core:OutletPort ;
            owl:onProperty core:portConnectedTo ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:complementOf core:InletPort ] ;
            owl:onProperty core:portConnectedTo ],
        [ a owl:Restriction ;
            owl:allValuesFrom core:OutletPort ;
            owl:onProperty core:portConnectedTo ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:complementOf core:InletPort ] ;
            owl:onProperty core:portConnectedTo ],
        core:EquipmentPort,
        o3po:Nozzle ;
    owl:disjointWith core:OutletPort ;
    skos:definition "An equipment port designed as the physical boundary interface to admit process or utility fluids into a topside equipment."@en .

core:portConnectedTo a owl:IrreflexiveProperty,
        owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "port connected to"@en,
        "porta conectada a"@pt ;
    rdfs:domain core:EquipmentPort ;
    rdfs:range core:EquipmentPort ;
    rdfs:subPropertyOf o3po:connectedTo ;
    owl:inverseOf [ owl:inverseOf core:portConnectedTo ],
        core:portConnectedTo ;
    skos:definition "Physical boundary connection between two equipment ports."@en .

uo:RO_0000057 a owl:ObjectProperty ;
    owl:inverseOf [ owl:inverseOf uo:RO_0000057 ] .

electrical:ElectricMotorEquipment a owl:Class ;
    rdfs:label "Electric Motor Equipment"@en,
        "Equipamento Motor Elétrico"@pt ;
    rdfs:isDefinedBy "IEC 60034" ;
    rdfs:subClassOf core:ElectricalEquipment ;
    skos:definition "An electromechanical device that converts electrical energy into rotational mechanical work to drive pumps or compressors."@en .

core:ElectricalEquipment a owl:Class ;
    rdfs:label "Electrical Equipment"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty core:hasPort ;
            owl:someValuesFrom core:ElectricalPort ],
        [ a owl:Restriction ;
            owl:onProperty core:hasPort ;
            owl:someValuesFrom core:ElectricalPort ],
        core:TopsideEquipment ;
    skos:definition "A topside equipment designed to generate, transform, distribute, switch, or convert electrical energy for power distribution or driving mechanical loads."@en .

core:ElectricalPort a owl:Class ;
    rdfs:label "Electrical Port"@en ;
    rdfs:subClassOf core:EquipmentPort ;
    skos:definition "An equipment port designed as the physical conductor interface (terminals/junctions) for transmitting or receiving electrical power in topside equipment."@en .

core:OutletPort a owl:Class ;
    rdfs:label "Outlet Port"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:complementOf core:OutletPort ] ;
            owl:onProperty core:portConnectedTo ],
        [ a owl:Restriction ;
            owl:allValuesFrom core:InletPort ;
            owl:onProperty core:portConnectedTo ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:complementOf core:OutletPort ] ;
            owl:onProperty core:portConnectedTo ],
        [ a owl:Restriction ;
            owl:allValuesFrom core:InletPort ;
            owl:onProperty core:portConnectedTo ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:complementOf core:OutletPort ] ;
            owl:onProperty core:portConnectedTo ],
        core:EquipmentPort,
        o3po:Nozzle ;
    skos:definition "An equipment port designed as the physical boundary interface to discharge process or utility fluids from a topside equipment."@en .

static:PressureVesselEquipment a owl:Class ;
    rdfs:label "Pressure Vessel Equipment"@en,
        "Equipamento Vaso de Pressão"@pt ;
    rdfs:subClassOf core:StaticEquipment ;
    owl:equivalentClass o3po:Vessel ;
    skos:definition "A static equipment engineered to contain fluids under internal or external pressure."@en .

o3po:Nozzle a owl:Class ;
    rdfs:label "nozzle"@en,
        "bocal"@pt-br ;
    dc:description "A nozzle is a device designed to control the direction or characteristics of a fluid flow (specially to increase velocity) as it exits (or enters) an enclosed chamber or pipe. A nozzle is often a pipe or tube of varying cross sectional area, and it can be used to direct or modify the flow of a fluid (liquid or gas). Nozzles are frequently used to control the rate of flow, speed, direction, mass, shape, and/or the pressure of the stream that emerges from them. In a nozzle, the velocity of fluid increases at the expense of its pressure energy."@en ;
    ns1:definition "def. a material artifact that has a protruding part through which a stream of fluid is directed"@en ;
    rdfs:subClassOf iof-core:MaterialArtifact .

static:HeatExchangeEquipment a owl:Class ;
    rdfs:label "Heat Exchange Equipment"@en,
        "Equipamento de Troca Térmica"@pt ;
    rdfs:subClassOf core:StaticEquipment ;
    owl:equivalentClass o3po:HeatExchanger ;
    skos:definition "A static equipment designed to transfer thermal energy between fluids at different temperatures."@en .

o3po:Choke a owl:Class ;
    rdfs:label "choke valve"@en,
        "válvula de choke"@pt-br ;
    ns1:definition "def. a valve that restricts flow"@en ;
    rdfs:subClassOf core:ValveAndSecurityEquipment,
        o3po:Valve ;
    owl:disjointWith o3po:ICV .

abox:VRUCompressor_K01 a uo:BFO_0000040,
        dynamical:CompressorEquipment,
        dynamical:ProcessVRUCompressor,
        core:DynamicalEquipment,
        core:TopsideEquipment,
        owl:NamedIndividual,
        owl:Thing,
        iof-core:MaterialArtifact ;
    rdfs:label "K-01 Process VRU Compressor"@en ;
    uo:RO_0001025 abox:Module_M02 ;
    core:feedsFluidToEquipment abox:LPCompressor_K02,
        abox:VRUCompressor_K01 ;
    core:hasPort abox:K01_Port_Elec,
        abox:K01_Port_In,
        abox:K01_Port_Out ;
    core:isLocatedInModule abox:Module_M02 ;
    core:receivesFluidFromEquipment abox:LPCompressor_K02,
        abox:VRUCompressor_K01 ;
    o3po:connectedTo abox:LPCompressor_K02,
        abox:VRUCompressor_K01 ;
    o3po:exchangesFluidWith abox:LPCompressor_K02,
        abox:VRUCompressor_K01 ;
    o3po:feedsFluidTo abox:LPCompressor_K02,
        abox:VRUCompressor_K01 ;
    o3po:hasFluidFedBy abox:LPCompressor_K02,
        abox:VRUCompressor_K01 .

iof-core:qualityOf a owl:ObjectProperty ;
    owl:inverseOf [ owl:inverseOf iof-core:qualityOf ] .

