dynamical:Aeroderivative a owl:Class ;
    rdfs:label "Aeroderivative Gas Turbine"@en,
        "Turbina a Gás Aeroderivativa"@pt ;
    rdfs:isDefinedBy "ISO 3977-3, 3.1" ;
    rdfs:subClassOf dynamical:GasTurbineEquipment ;
    skos:definition "Aircraft propulsion gas generator adapted to drive mechanical, electrical or marine equipment. [Source: ISO 3977-3, 3.1]"@en .

dynamical:ChemicalInjectionPump a owl:Class ;
    rdfs:label "Chemical Injection Pump"@en,
        "Bomba de Injeção Química"@pt ;
    rdfs:isDefinedBy "API Std 675 (Controlled Volume Pumps)" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty core:feedsFluidToEquipment ;
            owl:someValuesFrom [ owl:complementOf static:NonHazardousOpenDrainHeader ] ],
        uo:BFO_0000040,
        dynamical:PositiveDisplacementPumpEquipment,
        o3po:PositiveDisplacementPump ;
    owl:disjointWith [ a owl:Restriction ;
            owl:onProperty core:feedsFluidToEquipment ;
            owl:someValuesFrom static:NonHazardousOpenDrainHeader ],
        [ a owl:Restriction ;
            owl:onProperty core:feedsFluidToEquipment ;
            owl:someValuesFrom static:NonHazardousOpenDrainHeader ] .

dynamical:ChemicalTransferPump a owl:Class ;
    rdfs:label "Chemical Transfer Pump"@en,
        "Bomba de Transferência de Produtos Químicos"@pt ;
    rdfs:isDefinedBy "API Std 674 / ISO 13709" ;
    rdfs:subClassOf dynamical:PositiveDisplacementPumpEquipment,
        o3po:PositiveDisplacementPump .

dynamical:ClosedDrainPump a owl:Class ;
    rdfs:label "Closed Drain Pump"@en,
        "Bomba do Dreno Fechado"@pt ;
    rdfs:isDefinedBy "API Std 674 / ISO 13709" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty core:feedsFluidToEquipment ;
            owl:someValuesFrom [ owl:complementOf static:CleanSlopTank ] ],
        uo:BFO_0000040,
        dynamical:PositiveDisplacementPumpEquipment,
        o3po:PositiveDisplacementPump ;
    owl:disjointWith [ a owl:Restriction ;
            owl:onProperty core:feedsFluidToEquipment ;
            owl:someValuesFrom static:CleanSlopTank ],
        [ a owl:Restriction ;
            owl:onProperty core:feedsFluidToEquipment ;
            owl:someValuesFrom static:CleanSlopTank ] .

dynamical:CoolingMediumCirculationPump a owl:Class ;
    rdfs:label "Cooling Medium Circulation Pump"@en,
        "Bomba de Circulação do Fluido Refrigerante"@pt ;
    rdfs:isDefinedBy "ISO 13709" ;
    rdfs:subClassOf dynamical:CentrifugalPumpEquipment,
        o3po:CentrifugalPump .

dynamical:Coupling a owl:Class ;
    rdfs:label "Flexible Shaft Coupling"@en,
        "Acoplamento Flexível de Eixos"@pt ;
    rdfs:isDefinedBy "ISO 3977-3 / API Spec 671" ;
    rdfs:subClassOf dynamical:TurbineComponentEquipment ;
    skos:definition "Mechanical component that connects two rotating shafts together for the purpose of transmitting power."@en .

dynamical:DriveTrain a owl:Class ;
    rdfs:label "Drive Train"@en,
        "Trem de Acionamento"@pt ;
    rdfs:isDefinedBy "ISO 3977-1, 2.8" ;
    rdfs:subClassOf dynamical:TurbineComponentEquipment ;
    skos:definition "Assembly of rotational components transmitting mechanical power from the gas turbine to driven equipment, including shafts, couplings and gearboxes. [Source: ISO 3977-1, 2.8]"@en .

dynamical:ElectrostaticTreaterFeedPump a owl:Class ;
    rdfs:label "Electrostatic Treater Feed Pump"@en,
        "Bomba de Alimentação do Tratador Eletrostático"@pt ;
    rdfs:isDefinedBy "ISO 13709" ;
    rdfs:subClassOf dynamical:CentrifugalPumpEquipment,
        o3po:CentrifugalPump .

dynamical:ElectrostaticTreaterWaterPump a owl:Class ;
    rdfs:label "Electrostatic Treater Water Pump"@en,
        "Bomba de Água do Tratador Eletrostático"@pt ;
    rdfs:isDefinedBy "ISO 13709" ;
    rdfs:subClassOf dynamical:CentrifugalPumpEquipment,
        o3po:CentrifugalPump .

dynamical:Gearbox a owl:Class ;
    rdfs:label "Gearbox"@en,
        "Caixa de Engrenagens"@pt ;
    rdfs:isDefinedBy "ISO 3977-3" ;
    rdfs:subClassOf dynamical:TurbineComponentEquipment ;
    skos:altLabel "Speed Reducer"@en,
        "Redutor de Velocidade"@pt ;
    skos:definition "Mechanical transmission device comprising gears that matches rotational speed and torque between the driver turbine and driven load. [Source: ISO 3977-3]"@en .

dynamical:HeavyDutyIndustrial a owl:Class ;
    rdfs:label "Heavy Duty Industrial Gas Turbine"@en,
        "Turbina a Gás Industrial Pesada (Heavy Duty)"@pt ;
    rdfs:isDefinedBy "ISO 3977-3" ;
    rdfs:subClassOf dynamical:GasTurbineEquipment ;
    skos:definition "Heavy duty frame gas turbine designed specifically for stationary industrial power generation or mechanical drive applications."@en .

dynamical:HighPressureTurbine a owl:Class ;
    rdfs:label "High Pressure Turbine"@en,
        "Turbina de Alta Pressão"@pt ;
    rdfs:subClassOf dynamical:TurbineComponentEquipment .

dynamical:LiftGasCompressor a owl:Class ;
    rdfs:label "Lift Gas Compressor"@en,
        "Compressor de Gás Lift"@pt ;
    rdfs:isDefinedBy "ISO 10439" ;
    rdfs:subClassOf dynamical:CompressorEquipment .

dynamical:LowPressureTurbine a owl:Class ;
    rdfs:label "Low Pressure Turbine"@en,
        "Turbina de Baixa Pressão"@pt ;
    rdfs:subClassOf dynamical:TurbineComponentEquipment .

dynamical:MainGasCompressorTrainA a owl:Class ;
    rdfs:label "Main Gas Compressor (Train A)"@en,
        "Compressor Principal de Gás (Trem A)"@pt ;
    rdfs:isDefinedBy "ISO 10439 (Centrifugal Compressors)" ;
    rdfs:subClassOf dynamical:CompressorEquipment .

dynamical:MainGasCompressorTrainB a owl:Class ;
    rdfs:label "Main Gas Compressor (Train B)"@en,
        "Compressor Principal de Gás (Trem B)"@pt ;
    rdfs:isDefinedBy "ISO 10439 (Centrifugal Compressors)" ;
    rdfs:subClassOf dynamical:CompressorEquipment .

dynamical:PowerGenerationPackage a owl:Class ;
    rdfs:label "Gas Turbine Power Generation Package"@en,
        "Pacote de Geração de Potência por Turbina a Gás"@pt ;
    rdfs:isDefinedBy "ISO 3977-3" ;
    rdfs:subClassOf dynamical:GasTurbineEquipment ;
    skos:definition "Integrated skid-mounted package comprising the gas turbine driver, driven electrical generator, auxiliary systems and control enclosure. [Source: ISO 3977-3]"@en .

dynamical:ReinjectionGasCompressor a owl:Class ;
    rdfs:label "Reinjection Gas Compressor"@en,
        "Compressor de Reinjeção de Gás"@pt ;
    rdfs:isDefinedBy "ISO 10439" ;
    rdfs:subClassOf dynamical:CompressorEquipment .

dynamical:SeawaterInjectionPump a owl:Class ;
    rdfs:label "Seawater Injection Pump"@en,
        "Bomba de Injeção de Água do Mar"@pt ;
    rdfs:isDefinedBy "ISO 13709" ;
    rdfs:subClassOf dynamical:CentrifugalPumpEquipment,
        o3po:CentrifugalPump .

electrical:Busbar a owl:Class ;
    rdfs:label "Busbar"@en,
        "Barramento Elétrico"@pt ;
    rdfs:isDefinedBy "IEC 61439" ;
    rdfs:subClassOf electrical:PowerDistributionAndSwitchingEquipment ;
    skos:definition "A metallic strip or bar contained within switchgears for local high-current power distribution and switching."@en .

electrical:Electrochlorinator a owl:Class ;
    rdfs:label "Electrochlorinator"@en,
        "Eletroclorador"@pt ;
    rdfs:isDefinedBy "IEC 61892" ;
    rdfs:subClassOf electrical:PowerTransformationAndConversionEquipment ;
    skos:definition "An electrical electrochemical unit that uses direct electrical current to produce sodium hypochlorite from seawater for biofouling control."@en .

electrical:PowerCable a owl:Class ;
    rdfs:label "Power Cable"@en,
        "Cabo de Potência"@pt ;
    rdfs:isDefinedBy "IEC 60092-350 / IEC 61892-4" ;
    rdfs:subClassOf electrical:ElectricalConductorEquipment ;
    skos:definition "An assembly of one or more insulated electrical conductors used to transmit high/low voltage electrical energy."@en .

prop:ExhaustGasTemperatureSpecification a owl:Class ;
    rdfs:label "Exhaust Gas Temperature Specification (EGT)"@en,
        "Especificação de Temperatura dos Gases de Exaustão (EGT)"@pt ;
    rdfs:subClassOf iof-core:DesignSpecification ;
    skos:definition "Design specification prescribing the design temperature of exhaust gases."@en .

prop:HeatRateSpecification a owl:Class ;
    rdfs:label "Heat Rate Specification"@en,
        "Especificação de Taxa de Calor"@pt ;
    rdfs:subClassOf iof-core:DesignSpecification ;
    skos:definition "Design specification prescribing the design heat rate consumption per unit of energy produced."@en .

prop:HeatRateValueExpression a owl:Class ;
    rdfs:label "Heat Rate Value Expression"@en,
        "Expressão de Valor de Taxa de Calor"@pt ;
    rdfs:subClassOf iof-core:ValueExpression ;
    skos:definition "A value expression representing specific heat consumption paired with an energy/power unit of measure."@en .

prop:ModelIdentifier a owl:Class ;
    rdfs:label "Model Identifier"@en,
        "Identificador de Modelo"@pt ;
    rdfs:subClassOf iof-core:Identifier ;
    skos:altLabel "Part Number Identifier"@en,
        "Identificador de Número de Peça"@pt ;
    skos:definition "An identifier designating a manufacturer model or product series."@en .

renewable:SolarInverter a owl:Class ;
    rdfs:label "Solar Photovoltaic Inverter"@en,
        "Inversor Solar Fotovoltaico"@pt ;
    rdfs:isDefinedBy "IEC 62109" ;
    rdfs:subClassOf renewable:RenewablePowerConversionEquipment ;
    skos:definition "A power converter that transforms variable direct current (DC) output from solar panels into utility-frequency alternating current (AC)."@en .

renewable:SolarPanel a owl:Class ;
    rdfs:label "Solar PV Panel"@en,
        "Painel Solar Fotovoltaico"@pt ;
    rdfs:isDefinedBy "IEC 61215 / IEC 61730" ;
    rdfs:subClassOf renewable:RenewablePowerGenerationEquipment ;
    skos:altLabel "Solar PV Module"@en,
        "Módulo Solar Fotovoltaico"@pt ;
    skos:definition "Assembly of photovoltaic cells that converts solar irradiance directly into direct current (DC) electrical power."@en .

renewable:WindPowerConverter a owl:Class ;
    rdfs:label "Wind Turbine Power Converter"@en,
        "Conversor de Potência para Turbina Eólica"@pt ;
    rdfs:isDefinedBy "IEC 61400-21 / IEC 62477" ;
    rdfs:subClassOf renewable:RenewablePowerConversionEquipment ;
    skos:definition "An AC-DC-AC power electronic converter used to synchronize variable-frequency power from wind generators with the main platform grid."@en .

renewable:WindTurbine a owl:Class ;
    rdfs:label "Offshore Wind Turbine Generator"@en,
        "Turbina Eólica Offshore"@pt ;
    rdfs:isDefinedBy "IEC 61400" ;
    rdfs:subClassOf renewable:RenewablePowerGenerationEquipment ;
    skos:definition "A rotary device that converts the kinetic energy of wind into mechanical energy and then into electrical power."@en .

sensors:CO2Analyzer a owl:Class ;
    rdfs:label "CO2 Analyzer"@en,
        "Analisador de Dióxido de Carbono (CO2)"@pt-br ;
    rdfs:comment "Gas analyzer dedicated to measuring the concentration of carbon dioxide in the exhaust gas sample."@en,
        "Analisador de gases dedicado à medição da concentração de dióxido de carbono na amostra de gás de exaustão."@pt-br ;
    rdfs:subClassOf sensors:GasAnalyzer .

sensors:COAnalyzer a owl:Class ;
    rdfs:label "CO Analyzer"@en,
        "Analisador de Monóxido de Carbono (CO)"@pt-br ;
    rdfs:comment "Gas analyzer dedicated to measuring the concentration of carbon monoxide in the exhaust gas sample."@en,
        "Analisador de gases dedicado à medição da concentração de monóxido de carbono na amostra de gás de exaustão."@pt-br ;
    rdfs:subClassOf sensors:GasAnalyzer .

sensors:ContinuousEmissionMonitoringSystem a owl:Class ;
    rdfs:label "Continuous Emission Monitoring System (CEMS)"@en,
        "Sistema de Monitoramento Contínuo de Emissões (CEMS)"@pt-br ;
    rdfs:comment "Integrated instrumental package that continuously measures and records the concentration of air pollutants (NOx, CO, CO2, SO2, O2) in exhaust gas stacks."@en,
        "Conjunto instrumental integrado que mede e registra continuamente as concentrações de poluentes gasosos na chaminé da turbina a gás."@pt-br ;
    rdfs:isDefinedBy "ISO 11042-1 / EPA 40 CFR 60" ;
    rdfs:subClassOf core:InstrumentationAndControlEquipment .

sensors:EmissionsDataAcquisitionSystem a owl:Class ;
    rdfs:label "Emissions Data Acquisition System (EDAS)"@en,
        "Sistema de Aquisição de Dados de Emissões (EDAS)"@pt-br ;
    rdfs:subClassOf core:InstrumentationAndControlEquipment ;
    skos:definition "Automated data system that collects, normalizes, averages, and generates compliance reports from CEMS analyzers."@en .

sensors:FlameDetector a owl:Class ;
    rdfs:label "Optical Flame Detector"@en,
        "Detector Óptico de Chama"@pt-br ;
    rdfs:comment "Optical sensor (UV/IR) that continuously verifies the presence of flame in the gas turbine combustion chambers, tripping fuel shutoff on flameout."@en,
        "Sensor óptico (UV/IR) que monitora continuamente a presença de chama na câmara de combustão, acionando o bloqueio de combustível em caso de extinção de chama."@pt-br ;
    rdfs:isDefinedBy "ISO 3977-3" ;
    rdfs:subClassOf core:InstrumentationAndControlEquipment .

sensors:MassFlowMeter a owl:Class ;
    rdfs:label "Mass Flow Meter"@en,
        "Medidor de Vazão Mássica"@pt-br ;
    rdfs:comment "Fuel flow meter that directly measures the mass flow rate of the fluid (e.g., Coriolis technology), without requiring density compensation."@en,
        "Medidor de vazão de combustível que mede diretamente a vazão mássica do fluido (ex.: tecnologia Coriolis), sem necessidade de compensação de densidade."@pt-br ;
    rdfs:subClassOf sensors:FuelFlowMeter ;
    owl:disjointWith sensors:VolumetricFlowMeter .

sensors:NOxAnalyzer a owl:Class ;
    rdfs:label "NOx Analyzer"@en,
        "Analisador de Óxidos de Nitrogênio (NOx)"@pt-br ;
    rdfs:comment "Gas analyzer dedicated to measuring the concentration of nitrogen oxides (NO + NO2) in the exhaust gas sample."@en,
        "Analisador de gases dedicado à medição da concentração de óxidos de nitrogênio (NO + NO2) na amostra de gás de exaustão."@pt-br ;
    rdfs:subClassOf sensors:GasAnalyzer .

sensors:O2Analyzer a owl:Class ;
    rdfs:label "O2 Analyzer"@en,
        "Analisador de Oxigênio (O2)"@pt-br ;
    rdfs:comment "Gas analyzer dedicated to measuring the concentration of residual oxygen in the exhaust gas sample, typically used for correction/normalization of other emission readings."@en,
        "Analisador de gases dedicado à medição da concentração de oxigênio residual na amostra de gás de exaustão, usado tipicamente para correção/normalização das demais leituras de emissão."@pt-br ;
    rdfs:subClassOf sensors:GasAnalyzer .

sensors:OverspeedTripDevice a owl:Class ;
    rdfs:label "Overspeed Trip Device"@en,
        "Dispositivo de Disparo por Sobrevelocidade (Overspeed Trip)"@pt-br ;
    rdfs:comment "Control or trip element that immediately activates the overspeed protection system when rotor speed reaches a predetermined value. [Source: ISO 3977-1, 2.23]"@en,
        "Elemento de controle ou disparo que ativa imediatamente o sistema de proteção contra sobrevelocidade quando a velocidade do rotor atinge um valor preestabelecido. [Fonte: ISO 3977-1, 2.23 [ISO 11086]]"@pt-br ;
    rdfs:subClassOf core:InstrumentationAndControlEquipment .

sensors:OvertemperatureDetector a owl:Class ;
    rdfs:label "Overtemperature Detector"@en,
        "Detector de Sobretemperatura"@pt-br ;
    rdfs:comment "Primary sensing element directly responsive to temperature that immediately activates, via suitable amplifiers or converters, the overtemperature protection system when temperature reaches a predetermined value. [Source: ISO 3977-1, 2.30]"@en,
        "Elemento sensor primário diretamente responsivo à temperatura, que ativa imediatamente, por meio de amplificadores ou conversores adequados, o sistema de proteção contra sobretemperatura quando a temperatura atinge um valor preestabelecido. [Fonte: ISO 3977-1, 2.30 [ISO 11086]]"@pt-br ;
    rdfs:subClassOf core:InstrumentationAndControlEquipment,
        o3po:TemperatureSensor .

sensors:SO2Analyzer a owl:Class ;
    rdfs:label "SO2 Analyzer"@en,
        "Analisador de Dióxido de Enxofre (SO2)"@pt-br ;
    rdfs:comment "Gas analyzer dedicated to measuring the concentration of sulfur dioxide in the exhaust gas sample, relevant when liquid fuel with sulfur content is used."@en,
        "Analisador de gases dedicado à medição da concentração de dióxido de enxofre na amostra de gás de exaustão, relevante quando há combustível líquido com teor de enxofre."@pt-br ;
    rdfs:subClassOf sensors:GasAnalyzer .

sensors:VibrationSensor a owl:Class ;
    rdfs:label "Bearing Vibration Sensor"@en,
        "Sensor de Vibração de Mancal"@pt-br ;
    rdfs:isDefinedBy "ISO 3977-3 / ISO 10816-4" ;
    rdfs:subClassOf core:InstrumentationAndControlEquipment ;
    skos:definition "Proximity probe, velocity transducer, or accelerometer measuring shaft and bearing vibration levels for machinery protection."@en .

<http://usp.ai/ontologies/fpeo-shapes-equipments> a owl:Ontology ;
    rdfs:label "FPEO-Equipments SHACL Shapes Module"@en ;
    rdfs:comment "Validação estrutural, cardinalidade e integridade topológica sob Hipótese de Mundo Fechado (CWA) para pySHACL."@pt .

<http://usp.ai/ontologies/fpeo-shapes-equipments#CrudeExchangerPreFilterShape> a owl:NamedIndividual,
        owl:Thing,
        sh:NodeShape ;
    sh:property [ sh:message "Pré-Filtro de Óleo Cru deve descarregar em CrudeExchanger, CrudePreheater ou CrudeHeater."@pt ;
            sh:minCount 1 ;
            sh:or ( [ sh:class static:CrudeExchanger ] [ sh:class static:CrudePreheater ] [ sh:class static:CrudeHeater ] ) ;
            sh:path core:feedsFluidToEquipment ] ;
    sh:targetClass static:CrudeExchangerPreFilter .

<http://usp.ai/ontologies/fpeo-shapes-equipments#DeoilingHydrocycloneShape> a owl:NamedIndividual,
        owl:Thing,
        sh:NodeShape ;
    sh:property [ sh:message "Descarga do Hidrociclone deve seguir para flotação, resfriamento ou retorno ao vaso desnatador."@pt ;
            sh:minCount 1 ;
            sh:or ( [ sh:class static:GasFlotationCell ] [ sh:class static:ProducedWaterInletCooler ] [ sh:class static:ProducedWaterOverboardCooler ] [ sh:class static:WaterSkimVessel ] ) ;
            sh:path core:feedsFluidToEquipment ] ;
    sh:targetClass static:DeoilingHydrocyclone .

<http://usp.ai/ontologies/fpeo-shapes-equipments#GasTurbineCombustionShape> a owl:NamedIndividual,
        owl:Thing,
        sh:NodeShape ;
    sh:property [ sh:class dynamical:CombustionChamber ;
            sh:message "Equipamento de Turbina a Gás deve possuir ao menos uma Câmara de Combustão declarada."@pt ;
            sh:minCount 1 ;
            sh:path prop:hasCombustionChamber ] ;
    sh:targetClass dynamical:GasTurbineEquipment .

<http://usp.ai/ontologies/fpeo-shapes-equipments#GasTurbineSpecificationShape> a owl:NamedIndividual,
        owl:Thing,
        sh:NodeShape ;
    sh:property [ sh:message "Auditoria IOF: A Turbina a Gás deve possuir folha de dados com RatedPowerSpecification."@pt ;
            sh:path iof-core:isPrescribedBy ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape [ sh:class prop:RatedPowerSpecification ] ],
        [ sh:message "Auditoria IOF: A Turbina a Gás deve possuir folha de dados com RatedSpeedSpecification."@pt ;
            sh:path iof-core:isPrescribedBy ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape [ sh:class prop:RatedSpeedSpecification ] ] ;
    sh:targetClass dynamical:GasTurbineEquipment .

<http://usp.ai/ontologies/fpeo-shapes-equipments#HPFlareKnockoutDrumShape> a owl:NamedIndividual,
        owl:Thing,
        sh:NodeShape ;
    sh:property [ sh:class static:IntegratedHPFlareTip ;
            sh:message "Vaso de Alívio HP (HP Flare KO Drum) deve descarregar na ponteira IntegratedHPFlareTip."@pt ;
            sh:minCount 1 ;
            sh:path core:feedsFluidToEquipment ] ;
    sh:targetClass static:HPFlareKnockoutDrum .

<http://usp.ai/ontologies/fpeo-shapes-equipments#HeatingMediumCirculationPumpShape> a owl:NamedIndividual,
        owl:Thing,
        sh:NodeShape ;
    sh:property [ sh:message "Bomba de Circulação do Fluido Aquecedor deve alimentar ao menos um trocador de calor da malha térmica."@pt ;
            sh:minCount 1 ;
            sh:or ( [ sh:class static:CrudeHeater ] [ sh:class static:DilutionWaterHeater ] [ sh:class static:PIPWaterHeater ] [ sh:class static:TestInletHeater ] ) ;
            sh:path core:feedsFluidToEquipment ] ;
    sh:targetClass dynamical:HeatingMediumCirculationPump .

<http://usp.ai/ontologies/fpeo-shapes-equipments#HighVoltageSwitchgearShape> a owl:NamedIndividual,
        owl:Thing,
        sh:NodeShape ;
    sh:property [ sh:message "Painel de Alta Tensão deve alimentar Transformador, Painel VSD ou Motores de Alta Tensão."@pt ;
            sh:minCount 1 ;
            sh:or ( [ sh:class electrical:PowerTransformer ] [ sh:class electrical:VariableSpeedDrive ] [ sh:class electrical:ElectricMotorEquipment ] ) ;
            sh:path core:powersEquipment ] ;
    sh:targetClass electrical:HighVoltageSwitchgear .

<http://usp.ai/ontologies/fpeo-shapes-equipments#InstrumentAirCompressorShape> a owl:NamedIndividual,
        owl:Thing,
        sh:NodeShape ;
    sh:property [ sh:class static:AirReceiverTank ;
            sh:message "Compressor de Ar de Instrumentos exige conexão jusante com o Vaso Pulmão (AirReceiverTank)."@pt ;
            sh:minCount 1 ;
            sh:path core:feedsFluidToEquipment ] ;
    sh:targetClass dynamical:InstrumentAirCompressor .

<http://usp.ai/ontologies/fpeo-shapes-equipments#IntegratedHPFlareTipShape> a owl:NamedIndividual,
        owl:Thing,
        sh:NodeShape ;
    sh:property [ sh:maxCount 0 ;
            sh:message "Ponteira de Flare HP é um nó terminal e não pode possuir conexões de saída de fluido."@pt ;
            sh:path core:feedsFluidToEquipment ] ;
    sh:targetClass static:IntegratedHPFlareTip .

<http://usp.ai/ontologies/fpeo-shapes-equipments#IntegratedLPFlareTipShape> a owl:NamedIndividual,
        owl:Thing,
        sh:NodeShape ;
    sh:property [ sh:maxCount 0 ;
            sh:message "Ponteira de Flare LP é um nó terminal e não pode possuir conexões de saída de fluido."@pt ;
            sh:path core:feedsFluidToEquipment ] ;
    sh:targetClass static:IntegratedLPFlareTip .

<http://usp.ai/ontologies/fpeo-shapes-equipments#LPFlareKnockoutDrumShape> a owl:NamedIndividual,
        owl:Thing,
        sh:NodeShape ;
    sh:property [ sh:class static:IntegratedLPFlareTip ;
            sh:message "Vaso de Alívio LP (LP Flare KO Drum) deve descarregar na ponteira IntegratedLPFlareTip."@pt ;
            sh:minCount 1 ;
            sh:path core:feedsFluidToEquipment ] ;
    sh:targetClass static:LPFlareKnockoutDrum .

<http://usp.ai/ontologies/fpeo-shapes-equipments#MainTurbineGeneratorShape> a owl:NamedIndividual,
        owl:Thing,
        sh:NodeShape ;
    sh:property [ sh:class electrical:HighVoltageSwitchgear ;
            sh:message "Turbogerador Principal deve alimentar diretamente o Painel de Alta Tensão (HighVoltageSwitchgear)."@pt ;
            sh:minCount 1 ;
            sh:path core:powersEquipment ] ;
    sh:targetClass electrical:MainTurbineGenerator .

<http://usp.ai/ontologies/fpeo-shapes-equipments#MotorControlCenterShape> a owl:NamedIndividual,
        owl:Thing,
        sh:NodeShape ;
    sh:property [ sh:message "Centro de Controle de Motores (CCM) deve alimentar Motores Elétricos ou Inversores VSD."@pt ;
            sh:minCount 1 ;
            sh:or ( [ sh:class electrical:ElectricMotorEquipment ] [ sh:class electrical:VariableSpeedDrive ] ) ;
            sh:path core:powersEquipment ] ;
    sh:targetClass electrical:MotorControlCenter .

<http://usp.ai/ontologies/fpeo-shapes-equipments#MultiShaftGasTurbineShape> a owl:NamedIndividual,
        owl:Thing,
        sh:NodeShape ;
    sh:property [ sh:class dynamical:GasGenerator ;
            sh:message "Turbina multieixo exige ao menos um Gerador de Gás (GasGenerator) associado."@pt ;
            sh:minCount 1 ;
            sh:path prop:hasGasGenerator ],
        [ sh:class dynamical:PowerTurbine ;
            sh:message "Turbina multieixo exige ao menos uma Turbina de Potência (PowerTurbine) associada."@pt ;
            sh:minCount 1 ;
            sh:path prop:hasPowerTurbine ] ;
    sh:targetClass dynamical:MultiShaftGasTurbine .

<http://usp.ai/ontologies/fpeo-shapes-equipments#NitrogenGenerationUnitShape> a owl:NamedIndividual,
        owl:Thing,
        sh:NodeShape ;
    sh:property [ sh:class static:NitrogenReceiverTank ;
            sh:message "Unidade de Nitrogênio deve alimentar o reservatório de estocagem (NitrogenReceiverTank)."@pt ;
            sh:minCount 1 ;
            sh:path core:feedsFluidToEquipment ] ;
    sh:targetClass static:NitrogenGenerationUnit .

<http://usp.ai/ontologies/fpeo-shapes-equipments#PowerTransformerShape> a owl:NamedIndividual,
        owl:Thing,
        sh:NodeShape ;
    sh:property [ sh:message "Transformador de Potência deve alimentar Painel de Baixa Tensão (LV) ou Centro de Controle de Motores (CCM)."@pt ;
            sh:minCount 1 ;
            sh:or ( [ sh:class electrical:LowVoltageSwitchgear ] [ sh:class electrical:MotorControlCenter ] ) ;
            sh:path core:powersEquipment ] ;
    sh:targetClass electrical:PowerTransformer .

<http://usp.ai/ontologies/fpeo-shapes-equipments#ProcessVRUCompressorShape> a owl:NamedIndividual,
        owl:Thing,
        sh:NodeShape ;
    sh:property [ sh:class dynamical:LowPressureCompressor ;
            sh:message "Compressor de VRU deve direcionar fluxo ao Compressor Principal de Baixa Pressão (LowPressureCompressor)."@pt ;
            sh:minCount 1 ;
            sh:path core:feedsFluidToEquipment ] ;
    sh:targetClass dynamical:ProcessVRUCompressor .

<http://usp.ai/ontologies/fpeo-shapes-equipments#SRUCartridgeFilterShape> a owl:NamedIndividual,
        owl:Thing,
        sh:NodeShape ;
    sh:property [ sh:class static:SRUMembraneTrain ;
            sh:message "Filtro de Cartucho do SRU deve alimentar diretamente o Trem de Membranas (SRUMembraneTrain)."@pt ;
            sh:minCount 1 ;
            sh:path core:feedsFluidToEquipment ] ;
    sh:targetClass static:SRUCartridgeFilter .

<http://usp.ai/ontologies/fpeo-shapes-equipments#SRUFeedPumpShape> a owl:NamedIndividual,
        owl:Thing,
        sh:NodeShape ;
    sh:property [ sh:class static:SRUCartridgeFilter ;
            sh:message "Bomba de Alimentação do SRU exige conexão de saída para SRUCartridgeFilter."@pt ;
            sh:minCount 1 ;
            sh:path core:feedsFluidToEquipment ] ;
    sh:targetClass dynamical:SRUFeedPump .

<http://usp.ai/ontologies/fpeo-shapes-equipments#SWExchangerPreFilterShape> a owl:NamedIndividual,
        owl:Thing,
        sh:NodeShape ;
    sh:property [ sh:class static:CoolingMediumSeawaterExchanger ;
            sh:message "Pré-Filtro de Água do Mar deve alimentar o trocador CoolingMediumSeawaterExchanger."@pt ;
            sh:minCount 1 ;
            sh:path core:feedsFluidToEquipment ] ;
    sh:targetClass static:SWExchangerPreFilter .

<http://usp.ai/ontologies/fpeo-shapes-equipments#SeawaterLiftPumpShape> a owl:NamedIndividual,
        owl:Thing,
        sh:NodeShape ;
    sh:property [ sh:class static:SeawaterCoarseStrainer ;
            sh:message "Bomba de Captação de Água do Mar exige conexão de saída para SeawaterCoarseStrainer."@pt ;
            sh:minCount 1 ;
            sh:path core:feedsFluidToEquipment ] ;
    sh:targetClass dynamical:SeawaterLiftPump .

<http://usp.ai/ontologies/fpeo-shapes-equipments#TestSeparatorOilPumpShape> a owl:NamedIndividual,
        owl:Thing,
        sh:NodeShape ;
    sh:property [ sh:message "Bomba do Separador de Teste deve descarregar em TestInletHeater, CrudeExchanger ou CrudePreheater."@pt ;
            sh:minCount 1 ;
            sh:or ( [ sh:class static:TestInletHeater ] [ sh:class static:CrudeExchanger ] [ sh:class static:CrudePreheater ] ) ;
            sh:path core:feedsFluidToEquipment ] ;
    sh:targetClass dynamical:TestSeparatorOilPump .

<http://usp.ai/ontologies/fpeo-shapes-equipments#TurbineComponentEquipmentShape> a owl:NamedIndividual,
        owl:Thing,
        sh:NodeShape ;
    sh:property [ sh:maxCount 0 ;
            sh:message "Componente interno de turbina não pode possuir conexões de processo externas (feedsFluidToEquipment)."@pt ;
            sh:path core:feedsFluidToEquipment ] ;
    sh:targetClass dynamical:TurbineComponentEquipment .

<http://usp.ai/ontologies/fpeo-shapes-equipments#VariableSpeedDriveShape> a owl:NamedIndividual,
        owl:Thing,
        sh:NodeShape ;
    sh:property [ sh:class electrical:ElectricMotorEquipment ;
            sh:message "Inversor de Frequência (VSD) deve alimentar um Motor Elétrico."@pt ;
            sh:minCount 1 ;
            sh:path core:powersEquipment ] ;
    sh:targetClass electrical:VariableSpeedDrive .

<http://usp.ai/ontologies/fpeo-shapes-equipments#WaterSkimVesselPumpShape> a owl:NamedIndividual,
        owl:Thing,
        sh:NodeShape ;
    sh:property [ sh:class static:DeoilingHydrocyclone ;
            sh:message "Bomba do Vaso Desnatador deve descarregar obrigatoriamente no DeoilingHydrocyclone."@pt ;
            sh:minCount 1 ;
            sh:path core:feedsFluidToEquipment ] ;
    sh:targetClass dynamical:WaterSkimVesselPump .

static:ChemicalStorageTank a owl:Class ;
    rdfs:label "Chemical Storage Tank"@en,
        "Tanque de Armazenamento de Produtos Químicos"@pt ;
    rdfs:isDefinedBy "API Spec 12J / API Spec 14E" ;
    rdfs:subClassOf static:StorageAndPipingHeaderEquipment .

static:ClosedDrainDrum a owl:Class ;
    rdfs:label "Closed Drain Drum"@en,
        "Vaso de Dreno Fechado"@pt ;
    rdfs:isDefinedBy "API Spec 12J" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty core:feedsFluidToEquipment ;
            owl:someValuesFrom [ owl:complementOf static:CleanSlopTank ] ],
        [ a owl:Restriction ;
            owl:onProperty core:feedsFluidToEquipment ;
            owl:someValuesFrom [ owl:complementOf static:CleanSlopTank ] ],
        [ a owl:Restriction ;
            owl:onProperty core:feedsFluidToEquipment ;
            owl:someValuesFrom [ owl:complementOf static:CleanSlopTank ] ],
        uo:BFO_0000040,
        static:PressureVesselEquipment,
        o3po:Vessel ;
    owl:disjointWith [ a owl:Restriction ;
            owl:onProperty core:feedsFluidToEquipment ;
            owl:someValuesFrom static:CleanSlopTank ],
        [ a owl:Restriction ;
            owl:onProperty core:feedsFluidToEquipment ;
            owl:someValuesFrom static:CleanSlopTank ] .

static:CoolingMediumPreFilter a owl:Class ;
    rdfs:label "Cooling Medium Pre-Filter"@en,
        "Pré-Filtro do Fluido Refrigerante"@pt ;
    rdfs:isDefinedBy "API Spec 14E" ;
    rdfs:subClassOf static:ParticulateFilterEquipment,
        o3po:ParticulateFilter .

static:DieselInjectionHeater a owl:Class ;
    rdfs:label "Diesel Injection Heater"@en,
        "Aquecedor de Injeção de Diesel"@pt ;
    rdfs:isDefinedBy "ISO 16812 / API Spec 12K" ;
    rdfs:subClassOf static:HeatExchangeEquipment,
        o3po:HeatExchanger,
        o3po:Heater .

static:ElectrostaticTreater a owl:Class ;
    rdfs:label "Electrostatic Treater"@en,
        "Tratador Eletrostático"@pt ;
    rdfs:isDefinedBy "API Spec 12L" ;
    rdfs:subClassOf static:SeparationAndFilterEquipment .

static:ElectrostaticTreaterFlashVessel a owl:Class ;
    rdfs:label "Electrostatic Treater Flash Vessel"@en,
        "Vaso Flash do Tratador Eletrostático"@pt ;
    rdfs:isDefinedBy "API Spec 12L / API 12J" ;
    rdfs:subClassOf static:PressureVesselEquipment,
        o3po:Vessel .

static:FlareTower a owl:Class ;
    rdfs:label "Flare Tower"@en,
        "Torre do Flare"@pt ;
    rdfs:isDefinedBy "ISO 23251 (API 521)" ;
    rdfs:subClassOf static:StorageAndPipingHeaderEquipment .

static:FreeWaterKnockOutDrum a owl:Class ;
    rdfs:label "Free Water Knock Out Drum"@en,
        "Vaso Separador de Água Livre (FWKO)"@pt ;
    rdfs:isDefinedBy "API Spec 12J" ;
    rdfs:subClassOf static:PressureVesselEquipment,
        o3po:Vessel .

static:HazardousOpenDrainHeader a owl:Class ;
    rdfs:label "Hazardous Open Drain Header"@en,
        "Coletor de Dreno Aberto Perigoso"@pt ;
    rdfs:isDefinedBy "API Spec 14E" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty core:feedsFluidToEquipment ;
            owl:someValuesFrom [ owl:complementOf static:NonHazardousOpenDrainHeader ] ],
        [ a owl:Restriction ;
            owl:onProperty core:feedsFluidToEquipment ;
            owl:someValuesFrom [ owl:complementOf static:NonHazardousOpenDrainHeader ] ],
        [ a owl:Restriction ;
            owl:onProperty core:feedsFluidToEquipment ;
            owl:someValuesFrom [ owl:complementOf static:NonHazardousOpenDrainHeader ] ],
        uo:BFO_0000040,
        static:StorageAndPipingHeaderEquipment ;
    owl:disjointWith [ a owl:Restriction ;
            owl:onProperty core:feedsFluidToEquipment ;
            owl:someValuesFrom static:NonHazardousOpenDrainHeader ],
        [ a owl:Restriction ;
            owl:onProperty core:feedsFluidToEquipment ;
            owl:someValuesFrom static:NonHazardousOpenDrainHeader ],
        static:NonHazardousOpenDrainHeader .

static:HeatingCoil a owl:Class ;
    rdfs:label "Heating Coil"@en,
        "Serpentina de Aquecimento"@pt ;
    rdfs:isDefinedBy "API Spec 14E" ;
    rdfs:subClassOf static:HeatExchangeEquipment,
        o3po:HeatExchanger .

static:HeatingMediumExpansionTank a owl:Class ;
    rdfs:label "Heating Medium Expansion Tank"@en,
        "Tanque de Expansão do Fluido Aquecedor"@pt ;
    rdfs:isDefinedBy "API Spec 12J" ;
    rdfs:subClassOf static:PressureVesselEquipment,
        o3po:Vessel .

static:HeatingMediumTrimCooler a owl:Class ;
    rdfs:label "Heating Medium Trim Cooler"@en,
        "Resfriador Secundário do Fluido Aquecedor"@pt ;
    rdfs:isDefinedBy "ISO 16812" ;
    rdfs:subClassOf static:HeatExchangeEquipment,
        o3po:Cooler .

static:MolecularSieveGasDehydrator a owl:Class ;
    rdfs:label "Gas Dehydration Unit (Molecular Sieve)"@en,
        "Unidade de Desidratação de Gás (Peneira Molecular)"@pt ;
    rdfs:isDefinedBy "API Spec 12J / ISO 10439" ;
    rdfs:subClassOf static:SeparationAndFilterEquipment,
        owl:Nothing,
        o3po:MolecularSieveVessel ;
    owl:equivalentClass owl:Nothing .

static:MultiMediaFilter a owl:Class ;
    rdfs:label "Multi-Media Filter"@en,
        "Filtro Multimídia"@pt ;
    rdfs:isDefinedBy "API Spec 14E / API Spec 12L" ;
    rdfs:subClassOf static:ParticulateFilterEquipment,
        o3po:ParticulateFilter .

static:OffSpecFilter a owl:Class ;
    rdfs:label "Off-Spec Filter"@en,
        "Filtro de Óleo Fora de Especificação"@pt ;
    rdfs:isDefinedBy "API Spec 14E" ;
    rdfs:subClassOf static:CoalescingFilterEquipment,
        o3po:CoalescingFilter .

static:OffSpecTank a owl:Class ;
    rdfs:label "Off-Spec Tank (Hull)"@en,
        "Tanque de Óleo Fora de Especificação (Casco)"@pt ;
    rdfs:isDefinedBy "API Spec 14E" ;
    rdfs:subClassOf static:StorageAndPipingHeaderEquipment .

static:ReverseOsmosisUnit a owl:Class ;
    rdfs:label "Reverse Osmosis Unit"@en,
        "Unidade de Osmose Reversa"@pt ;
    rdfs:isDefinedBy "API Spec 14E" ;
    rdfs:subClassOf static:SeparationAndFilterEquipment .

static:SalesOilCooler a owl:Class ;
    rdfs:label "Sales Oil Cooler"@en,
        "Resfriador de Óleo de Exportação"@pt ;
    rdfs:isDefinedBy "ISO 16812" ;
    rdfs:subClassOf static:HeatExchangeEquipment,
        o3po:Cooler .

static:VacuumDeaerator a owl:Class ;
    rdfs:label "Vacuum Deaerator"@en,
        "Desaereador a Vácuo"@pt ;
    rdfs:isDefinedBy "API Spec 12J" ;
    rdfs:subClassOf static:PressureVesselEquipment,
        o3po:Vessel .

static:WasteHeatRecoveryUnit a owl:Class ;
    rdfs:label "Waste Heat Recovery Unit (WHRU)"@en,
        "Unidade de Recuperação de Calor Residual (WHRU)"@pt ;
    rdfs:isDefinedBy "ISO 16812" ;
    rdfs:subClassOf static:HeatExchangeEquipment,
        o3po:HeatExchanger .

valve:CheckValve a owl:Class ;
    rdfs:label "Check Valve"@en,
        "Válvula de Retenção"@pt ;
    rdfs:isDefinedBy "API Spec 6D / ISO 14313" ;
    rdfs:subClassOf valve:IsolationAndShutdownEquipment ;
    skos:altLabel "Non-Return Valve"@en,
        "Válvula de Não Retorno"@pt ;
    skos:definition "Unidirectional automatic valve that allows fluid flow in one direction and closes automatically to prevent backflow."@en .

valve:EmergencyShutdownValve a owl:Class ;
    rdfs:label "Emergency Shutdown Valve (ESDV)"@en,
        "Válvula de Parada de Emergência (ESDV)"@pt ;
    rdfs:isDefinedBy "ISO 14313 / API Spec 6D / API Std 14C" ;
    rdfs:subClassOf valve:IsolationAndShutdownEquipment ;
    skos:definition "Actuated safety valve designed to isolate a process module or plant section upon detection of hazardous emergency conditions."@en .

valve:FlowControlValve a owl:Class ;
    rdfs:label "Process Flow Control Valve"@en,
        "Válvula de Controle de Vazão"@pt ;
    rdfs:isDefinedBy "IEC 60534" ;
    rdfs:subClassOf valve:ProcessControlEquipment ;
    skos:definition "Power-actuated valve used to regulate fluid flow rate by modulating orifice area in response to control signals."@en .

valve:FuelGovernorValve a owl:Class ;
    rdfs:label "Turbine Fuel Governor Valve"@en,
        "Válvula Governadora do Combustível da Turbina"@pt ;
    rdfs:isDefinedBy "ISO 11042" ;
    rdfs:subClassOf valve:ProcessControlEquipment ;
    skos:definition "Final metering valve modulating fuel input to a gas turbine to maintain rotor speed or load setpoint."@en .

valve:FuelStopValve a owl:Class ;
    rdfs:label "Turbine Fuel Stop Valve"@en,
        "Válvula de Bloqueio Rápido do Combustível da Turbina"@pt ;
    rdfs:isDefinedBy "ISO 11042 / API Spec 616" ;
    rdfs:subClassOf valve:PressureSafetyAndReliefEquipment ;
    skos:definition "Emergency trip device which, when actuated by protection system, rapidly shuts off all fuel flow to the combustion chamber."@en .

valve:InjectionRateControlDevice a owl:Class ;
    rdfs:label "Injection Rate Control Device (IRCD)"@en,
        "Dispositivo de Controle de Taxa de Injeção (IRCD)"@pt ;
    rdfs:isDefinedBy "IEC 60534 / API Spec 14A" ;
    rdfs:subClassOf valve:ProcessControlEquipment ;
    skos:definition "Flow regulation valve engineered to precisely meter high-pressure chemical injection into subsea or topside lines."@en .

valve:ManualIsolationValve a owl:Class ;
    rdfs:label "Manual Block Valve"@en,
        "Válvula Manual de Bloqueio"@pt ;
    rdfs:isDefinedBy "API Spec 6D / ISO 15761" ;
    rdfs:subClassOf valve:IsolationAndShutdownEquipment ;
    skos:altLabel "Isolation Valve"@en,
        "Válvula de Isolamento"@pt ;
    skos:definition "Manually operated valve (e.g., ball, gate, plug valve) providing tight shutoff for routine maintenance isolation."@en .

valve:PressureControlValve a owl:Class ;
    rdfs:label "Pressure Control Valve"@en,
        "Válvula de Controle de Pressão"@pt ;
    rdfs:isDefinedBy "IEC 60534 / API Spec 6A" ;
    rdfs:subClassOf valve:ProcessControlEquipment,
        o3po:Choke ;
    skos:altLabel "Choke Valve"@en,
        "Válvula Choke"@pt ;
    skos:definition "Control valve designed to reduce and regulate fluid pressure downstream or maintain upstream backpressure."@en .

valve:PressureReliefValve a owl:Class ;
    rdfs:label "Pressure Relief Valve"@en,
        "Válvula de Alívio de Pressão"@pt ;
    rdfs:isDefinedBy "API Std 520 / API Std 526" ;
    rdfs:subClassOf valve:PressureSafetyAndReliefEquipment ;
    skos:altLabel "Pressure Safety Valve"@en,
        "Válvula de Segurança e Alívio"@pt ;
    skos:definition "Automatic pressure-relieving device actuated by static pressure upstream to open when pressure exceeds a specified setpoint."@en .

valve:RuptureDisc a owl:Class ;
    rdfs:label "Rupture Disc Device"@en,
        "Disco de Ruptura"@pt ;
    rdfs:isDefinedBy "API Std 520 / ISO 4126-2" ;
    rdfs:subClassOf valve:PressureSafetyAndReliefEquipment ;
    skos:definition "Non-reclosing pressure relief device actuated by differential pressure and designed to burst at a predetermined set value."@en .

valve:ShutdownValve a owl:Class ;
    rdfs:label "Process Shutdown Valve (SDV)"@en,
        "Válvula de Parada do Processo (SDV)"@pt ;
    rdfs:isDefinedBy "API Spec 6D / API Std 14C" ;
    rdfs:subClassOf valve:IsolationAndShutdownEquipment ;
    skos:definition "Actuated valve used to automatically isolate specific process equipment or lines during automated unit shutdowns."@en .

o3po:Annulus a owl:Class ;
    rdfs:label "annulus"@en,
        "anular"@pt-br ;
    ns1:definition "def. a BFO:Site that occupies a well and is delimited by any void between any piping, tubing or casing and the piping, tubing, or casing immediately surrounding it"@en ;
    rdfs:comment "The annulus of an oil well or water well is any void between any piping, tubing or casing and the piping, tubing, or casing immediately surrounding it."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty uo:BFO_0000050 ;
            owl:someValuesFrom o3po:Well ],
        [ a owl:Restriction ;
            owl:onProperty uo:BFO_0000050 ;
            owl:someValuesFrom o3po:Well ],
        uo:BFO_0000029 .

o3po:BeingOperatedCapability a owl:Class ;
    rdfs:label "being operated capability"@en,
        "capacidade de ser operado"@pt-br ;
    ns1:definition "def. a capability to be operated"@en ;
    rdfs:subClassOf iof-core:Capability .

o3po:Blower a owl:Class ;
    rdfs:label "blower"@en,
        "soprador"@pt-br ;
    ns1:definition "def. A material artifact designed to move gas with a moderate increase of pressure."@en ;
    rdfs:comment "Blowers are used to move gas or air. They operate at a pressure ratio between that of a fan and a compressor."@en ;
    rdfs:subClassOf iof-core:MaterialArtifact .

o3po:Casing a owl:Class ;
    rdfs:label "casing"@en,
        "revestimento"@pt-br ;
    ns1:definition "def. a material artifact that is a component of a well and provides structural integrity to the wellbore"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty o3po:componentOf ;
            owl:someValuesFrom o3po:Well ],
        [ a owl:Restriction ;
            owl:onProperty o3po:componentOf ;
            owl:someValuesFrom o3po:Well ],
        iof-core:MaterialArtifact .

o3po:ChokePosition a owl:Class ;
    rdfs:label "choke position"@en,
        "posição do choke"@pt-br ;
    ns1:definition "def. a quality that represents the position of a choke"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty uo:RO_0000080 ;
            owl:someValuesFrom o3po:Choke ],
        [ a owl:Restriction ;
            owl:allValuesFrom o3po:Choke ;
            owl:onProperty iof-core:qualityOf ],
        [ a owl:Restriction ;
            owl:onProperty uo:RO_0000080 ;
            owl:someValuesFrom o3po:Choke ],
        [ a owl:Restriction ;
            owl:allValuesFrom o3po:Choke ;
            owl:onProperty iof-core:qualityOf ],
        uo:BFO_0000019 .

o3po:ChokeSize a owl:Class ;
    rdfs:label "choke size"@en,
        "tamanho do choke"@pt-br ;
    ns1:definition "def. a quality that represents the size of a choke"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty iof-core:qualityOf ;
            owl:someValuesFrom o3po:Choke ],
        [ a owl:Restriction ;
            owl:allValuesFrom o3po:Choke ;
            owl:onProperty iof-core:qualityOf ],
        [ a owl:Restriction ;
            owl:onProperty iof-core:qualityOf ;
            owl:someValuesFrom o3po:Choke ],
        [ a owl:Restriction ;
            owl:allValuesFrom o3po:Choke ;
            owl:onProperty iof-core:qualityOf ],
        uo:BFO_0000019 .

o3po:Condensate a owl:Class ;
    rdfs:label "condensate"@en,
        "condensado"@pt-br ;
    ns2:source "https://www.mckinseyenergyinsights.com/resources/refinery-reference-desk/condensate/"@en ;
    ns1:definition "def. crude oil that is a mixture of light liquid hydrocarbons, similar to a very light crude oil"@en ;
    rdfs:comment "Condensate is a mixture of light liquid hydrocarbons, similar to a very light (high API) crude oil. It is typically separated out of a natural gas stream at the point of production (field separation) when the temperature and pressure of the gas is dropped to atmospheric conditions."@en ;
    rdfs:subClassOf o3po:CrudeOil ;
    owl:disjointWith o3po:Water .

o3po:DeltaPressure a owl:Class ;
    rdfs:label "delta pressure"@en,
        "diferencial de pressão"@pt-br ;
    ns1:definition "def. a relational quality that is a pressure difference"@en ;
    rdfs:subClassOf uo:BFO_0000145 .

o3po:FieldName a owl:Class ;
    rdfs:label "field name"@en,
        "nome do campo"@pt-br ;
    ns1:definition "def. a name that specifically denominates a field"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty uo:BFO_0000197 ;
            owl:someValuesFrom o3po:Field ],
        [ a owl:Restriction ;
            owl:onProperty uo:BFO_0000197 ;
            owl:someValuesFrom o3po:Field ],
        o3po:Name .

o3po:Flowline a owl:Class ;
    rdfs:label "flowline"@en,
        "linha de fluxo"@pt-br ;
    ns1:definition "def. a pipeline that carries oil, gas or water that connects the wellhead to a manifold or to a platform"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty o3po:connectedTo ;
            owl:someValuesFrom o3po:ChristmasTree ],
        [ a owl:Restriction ;
            owl:onProperty o3po:connectedTo ;
            owl:someValuesFrom o3po:ChristmasTree ],
        o3po:Pipeline .

o3po:GasHeater a owl:Class ;
    rdfs:label "gas heater"@en,
        "aquecedor de gás"@pt-br ;
    ns1:definition "def. A heater designed specifically to raise the temperature of a gas stream, often to prevent hydrate formation during pressure reduction."@en ;
    rdfs:comment "Often referred to as a Line Heater in upstream operations."@en ;
    rdfs:subClassOf o3po:Heater .

o3po:InjectionProcess a owl:Class ;
    rdfs:label "injection (process)"@en,
        "injeção (processo)"@pt-br ;
    ns1:definition "def. a flow that has an injection well as participant and is towards a reservoir"@en ;
    rdfs:comment "Injection of gases or liquids into a reservoir to force oil toward and into producing wells."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty uo:RO_0000057 ;
            owl:someValuesFrom o3po:Fluid ],
        [ a owl:Restriction ;
            owl:onProperty uo:RO_0000057 ;
            owl:someValuesFrom o3po:InjectionWell ],
        [ a owl:Restriction ;
            owl:onProperty uo:RO_0000057 ;
            owl:someValuesFrom o3po:Reservoir ],
        [ a owl:Restriction ;
            owl:onProperty uo:RO_0000057 ;
            owl:someValuesFrom o3po:Fluid ],
        [ a owl:Restriction ;
            owl:onProperty uo:RO_0000057 ;
            owl:someValuesFrom o3po:InjectionWell ],
        [ a owl:Restriction ;
            owl:onProperty uo:RO_0000057 ;
            owl:someValuesFrom o3po:Reservoir ],
        o3po:Flow ;
    owl:disjointWith o3po:ProductionProcess .

o3po:PLEM a owl:Class ;
    rdfs:label "pipeline end manifold"@en,
        "manifold de término de tubulação"@pt-br ;
    ns2:source "https://oilstates.com/offshore/subsea-pipeline-products/plem-plet-structures/" ;
    ns1:acronym "PLEM" ;
    ns1:definition "def. a manifold that splits the product flow into multiple routes that may feed into an FPSO, refinery and holding tanks concurrently"@en ;
    rdfs:subClassOf o3po:Manifold .

o3po:Permeability a owl:Class ;
    rdfs:label "permeability (quality)"@en,
        "permeabilidade (qualidade)"@pt-br ;
    ns1:definition "def. the measure of the ability of a porous material (often, a rock or an unconsolidated material) to allow fluids to pass through it"@en ;
    rdfs:seeAlso "https://en.wikipedia.org/wiki/Permeability_(Earth_sciences)"@en ;
    rdfs:subClassOf uo:BFO_0000019 .

o3po:Plant a owl:Class ;
    rdfs:label "plant"@en,
        "planta"@pt-br ;
    ns1:definition "def. an engineered system located at a field"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty uo:RO_0001025 ;
            owl:someValuesFrom o3po:Field ],
        [ a owl:Restriction ;
            owl:onProperty o3po:hasComponent ;
            owl:someValuesFrom o3po:Platform ],
        [ a owl:Restriction ;
            owl:onProperty uo:RO_0001025 ;
            owl:someValuesFrom o3po:Field ],
        [ a owl:Restriction ;
            owl:onProperty o3po:hasComponent ;
            owl:someValuesFrom o3po:Platform ],
        uo:BFO_0000040,
        iof-core:EngineeredSystem .

o3po:PressureSensor a owl:Class ;
    rdfs:label "pressure sensor"@en,
        "sensor de pressão"@pt-br ;
    ns1:definition "def. a sensor that measures the pressure of a fluid"@en ;
    rdfs:comment "A device for pressure measurement of gases or liquids."@en ;
    rdfs:seeAlso "https://en.wikipedia.org/wiki/Pressure_sensor"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty o3po:measures ;
            owl:someValuesFrom o3po:Pressure ],
        [ a owl:Restriction ;
            owl:onProperty o3po:measures ;
            owl:someValuesFrom o3po:Pressure ],
        o3po:Sensor .

o3po:ProductionSeparator a owl:Class ;
    rdfs:label "production separator"@en,
        "separador de produção"@pt-br ;
    ns1:definition "def. a separator that separates production fluids into their constituent components of crude oil, gas and water"@en ;
    rdfs:comment "The term separator in oilfield terminology designates a pressure vessel used for separating well fluids produced from oil and gas wells into gaseous and liquid components. A separator for petroleum production is a large vessel designed to separate production fluids into their constituent components of oil, gas and water."@en ;
    rdfs:seeAlso "https://en.wikipedia.org/wiki/Separator_(oil_production)"@en ;
    rdfs:subClassOf o3po:Separator .

o3po:ProductionZone a owl:Class ;
    rdfs:label "production zone"@en,
        "zona de produção"@pt-br ;
    ns1:definition "def. a reservoir or a section of a reservoir that is drilled into and from which hydrocarbons are produced or into which fluids are injected"@en ;
    rdfs:subClassOf o3po:Reservoir .

o3po:Riser a owl:Class ;
    rdfs:label "riser"@en,
        "riser role"@en,
        "papel de riser"@pt-br,
        "riser"@pt-br ;
    ns2:source "https://petrowiki.org/Glossary:Riser"@en ;
    ns1:definition "def. a pipeline that vertically carries fluids or fluid-like amounts or artifacts (e.g., cables, pipes) and that connects a wellhead or a manifold on the seafloor to a platform"@en,
        "def. a role that has bearer some pipeline"@en ;
    rdfs:comment "Pipe or pipeline that vertically carries materials (e.g., production fluids, drilling mud, drilling cuttings) or artifacts (e.g., cables, pipes) and that connects a wellhead or a manifold on the seafloor to a production and/or drilling platform."@en,
        "Pipe through which liquid travels upward."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty iof-core:roleOf ;
            owl:someValuesFrom o3po:Pipeline ],
        [ a owl:Restriction ;
            owl:allValuesFrom o3po:Pipeline ;
            owl:onProperty iof-core:roleOf ],
        [ a owl:Restriction ;
            owl:onProperty iof-core:roleOf ;
            owl:someValuesFrom o3po:Pipeline ],
        [ a owl:Restriction ;
            owl:allValuesFrom o3po:Pipeline ;
            owl:onProperty iof-core:roleOf ],
        uo:BFO_0000023 .

o3po:SubseaTree a owl:Class ;
    rdfs:label "subsea tree"@en,
        "árvore de natal molhada"@pt-br ;
    uo:IAO_0000118 "subsea christmas tree"@en ;
    ns1:definition "def. a christmas tree that is projected to work at subsea"@en ;
    rdfs:seeAlso "https://en.wikipedia.org/wiki/Christmas_tree_(oil_well)" ;
    rdfs:subClassOf o3po:ChristmasTree .

o3po:Tag a owl:Class ;
    rdfs:label "tag"@en,
        "etiqueta"@pt-br ;
    uo:IAO_0000112 "PT-001, TT-102, PCV-205"@en ;
    ns1:definition "def. an identifier used in industrial contexts to uniquely reference equipment, instruments, or systems within a plant"@en ;
    rdfs:comment "Tags follow standardized naming conventions (e.g., ISA-5.1) to ensure consistency across engineering documentation."@en ;
    rdfs:subClassOf iof-core:Identifier .

o3po:TestSeparator a owl:Class ;
    rdfs:label "test separator"@en,
        "separador de teste"@pt-br ;
    ns1:definition "def. a separator that is used to separate and meter relatively small quantities of oil and gas"@en ;
    rdfs:comment "A vessel used to separate and meter relatively small quantities of oil and gas. Test separators can be two-phase or three-phase, or horizontal, vertical or spherical. They can also be permanent or portable."@en ;
    rdfs:seeAlso "https://glossary.oilfield.slb.com/Terms/t/test_separator.aspx"@en ;
    rdfs:subClassOf o3po:Separator .

o3po:Variable a owl:Class ;
    rdfs:label "variable"@en,
        "variável"@pt-br ;
    uo:IAO_0000112 "flow rate, pressure, temperature"@en ;
    ns1:definition "def. an information content entity that represents a measurable attribute or parameter that can change over time in a production system"@en ;
    rdfs:subClassOf iof-core:InformationContentEntity .

o3po:Volume a owl:Class ;
    rdfs:label "volume"@en,
        "volume"@pt-br ;
    ns1:definition "def. a quality that represents the amount of three-dimensional space occupied by a fluid"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty iof-core:qualityOf ;
            owl:someValuesFrom o3po:Fluid ],
        [ a owl:Restriction ;
            owl:onProperty iof-core:qualityOf ;
            owl:someValuesFrom o3po:Fluid ],
        uo:BFO_0000019 .

o3po:WellLiquidRateInSituConditions a owl:Class ;
    rdfs:label "well liquid rate in-situ conditions"@en,
        "vazão de líquido do poço em condições de reservatório"@pt-br ;
    ns1:definition "def. a well flow rate measured at in-situ (reservoir) conditions"@en ;
    rdfs:subClassOf o3po:WellFlowRate ;
    owl:disjointWith o3po:WellLiquidRateStandardConditions .

o3po:WellName a owl:Class ;
    rdfs:label "well name"@en,
        "nome do poço"@pt-br ;
    ns1:definition "def. a name that specifically denominates a well"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty uo:BFO_0000197 ;
            owl:someValuesFrom o3po:Well ],
        [ a owl:Restriction ;
            owl:onProperty uo:BFO_0000197 ;
            owl:someValuesFrom o3po:Well ],
        o3po:Name .

o3po:WellStatusFlag a owl:Class ;
    rdfs:label "well status flag"@en,
        "flag de status do poço"@pt-br ;
    ns1:definition "def. a quality that represents the operational status of a well as a boolean value"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty iof-core:qualityOf ;
            owl:someValuesFrom o3po:Well ],
        [ a owl:Restriction ;
            owl:allValuesFrom o3po:Well ;
            owl:onProperty uo:RO_0000080 ],
        [ a owl:Restriction ;
            owl:onProperty iof-core:qualityOf ;
            owl:someValuesFrom o3po:Well ],
        [ a owl:Restriction ;
            owl:allValuesFrom o3po:Well ;
            owl:onProperty uo:RO_0000080 ],
        uo:BFO_0000019 .

o3po:hasFlowRateValue a owl:DatatypeProperty ;
    rdfs:label "has flow rate value"@en,
        "tem valor de vazão"@pt-br ;
    ns1:definition "def. a relation between a flow rate and a float value representing the volumetric flow magnitude"@en ;
    rdfs:comment "Flow rate typically expressed in cubic meters per day (m³/d) or barrels per day (bbl/d)."@en ;
    rdfs:domain o3po:FlowRate ;
    rdfs:range xsd:float .

uo:BFO_0000015 a owl:Class ;
    rdfs:subClassOf owl:Thing .

uo:BFO_0000030 a owl:Class ;
    rdfs:subClassOf owl:Thing .

uo:BFO_0000145 a owl:Class ;
    rdfs:subClassOf owl:Thing .

