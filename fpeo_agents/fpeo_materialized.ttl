    iof-core:hasContinuantPartAtAllTimes abox:Val_Duty_E01 ;
    iof-core:prescribes abox:SeawaterCooler_E01 .

abox:Spec_Duty_E02 a prop:RatedPowerSpecification,
        owl:NamedIndividual,
        owl:Thing,
        iof-core:DesignSpecification ;
    rdfs:label "Rated Thermal Duty"@en ;
    iof-core:hasContinuantPartAtAllTimes abox:Val_Duty_E02 ;
    iof-core:prescribes abox:TestInletHeater_E02 .

abox:Spec_Efficiency_GTG01 a prop:ThermalEfficiencySpecification,
        owl:NamedIndividual,
        owl:Thing,
        iof-core:DesignSpecification ;
    rdfs:label "Thermal Efficiency Specification"@en ;
    iof-core:hasContinuantPartAtAllTimes abox:Val_Efficiency_GTG01 ;
    iof-core:prescribes abox:MainTurbineGenerator_GTG01 .

abox:Spec_GasCapacity_P78 a prop:DesignFlowRateSpecification,
