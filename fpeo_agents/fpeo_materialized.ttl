<http://usp.ai/ontologies/fpeo-crosswalk-equipments> a owl:Ontology ;
    dc:creator "Hugo Cardoso Ferreira de Araújo" ;
    dc:description "Semantic Crosswalk and Alignment Module for FPEO-Equipments Ontology establishing equivalences and property mappings with O3PO"@en ;
    owl:imports <http://usp.ai/ontologies/fpeo-dynamical-equipments>,
        <http://usp.ai/ontologies/fpeo-electrical-equipments>,
        <http://usp.ai/ontologies/fpeo-equipments-core>,
        <http://usp.ai/ontologies/fpeo-renewable-equipments>,
        <http://usp.ai/ontologies/fpeo-sensors-equipments>,
        <http://usp.ai/ontologies/fpeo-static-equipments>,
        <http://usp.ai/ontologies/fpeo-valves-security>,
        <https://www.inf.ufrgs.br/ontologies/o3po/2.0> .

<http://usp.ai/ontologies/fpeo-dynamical-equipments> a owl:Ontology ;
    dc:creator "Hugo Cardoso Ferreira de Araújo" ;
    dc:description "Dynamical Equipments Module for FPEO-Equipments Ontology"@en ;
    owl:imports <http://usp.ai/ontologies/fpeo-equipments-core> .

dynamical:HeatingMediumCirculationPump a owl:Class ;
    rdfs:label "Heating Medium Circulation Pump"@en,
        "Bomba de Circulação do Fluido Aquecedor"@pt ;
    rdfs:isDefinedBy "ISO 13709" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty core:feedsFluidToEquipment ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( static:CrudeHeater static:DilutionWaterHeater static:PIPWaterHeater static:TestInletHeater ) ] ],
        uo:BFO_0000040,
        dynamical:CentrifugalPumpEquipment,
        o3po:CentrifugalPump .

dynamical:InstrumentAirCompressor a owl:Class ;
    rdfs:label "Instrument Air Compressor"@en,
        "Compressor de Ar de Instrumentos"@pt ;
    rdfs:isDefinedBy "ISO 10440" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty core:feedsFluidToEquipment ;
            owl:someValuesFrom static:AirReceiverTank ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty core:feedsFluidToEquipment ],
        dynamical:CompressorEquipment ;
    skos:altLabel "Utility Air Compressor"@en,
        "Compressor de Ar de Utilidades"@pt .

dynamical:SRUFeedPump a owl:Class ;
    rdfs:label "SRU Feed Pump"@en,
        "Bomba de Alimentação do SRU"@pt ;
    rdfs:isDefinedBy "ISO 13709" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty core:feedsFluidToEquipment ;
            owl:someValuesFrom static:SRUCartridgeFilter ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty core:feedsFluidToEquipment ],
        uo:BFO_0000040,
        dynamical:CentrifugalPumpEquipment,
        o3po:CentrifugalPump .

dynamical:Shaft a owl:Class ;
    rdfs:label "Shaft"@en,
        "Eixo Mecânico"@pt ;
    rdfs:subClassOf dynamical:TurbineComponentEquipment ;
    skos:altLabel "Rotor"@en,
        "Rotor Mecânico"@pt ;
    skos:definition "The mechanical element that couples the compressor and turbine stages to transfer rotational energy."@en .

dynamical:WaterSkimVesselPump a owl:Class ;
    rdfs:label "Water Collection Skim Vessel Pump"@en,
        "Bomba do Vaso Desnatador de Água Produzida"@pt ;
    rdfs:isDefinedBy "ISO 13709" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty core:feedsFluidToEquipment ;
            owl:someValuesFrom static:DeoilingHydrocyclone ],
        uo:BFO_0000040,
        dynamical:CentrifugalPumpEquipment,
        o3po:CentrifugalPump .

<http://usp.ai/ontologies/fpeo-electrical-equipments> a owl:Ontology ;
    dc:creator "Hugo Cardoso Ferreira de Araújo" ;
    dc:description "Electrical Equipments Module for FPEO-Equipments Ontology"@en ;
    owl:imports <http://usp.ai/ontologies/fpeo-equipments-core> .

electrical:EmergencyDieselGenerator a owl:Class ;
    rdfs:label "Emergency Diesel Generator"@en,
        "Gerador Diesel de Emergência"@pt ;
    rdfs:isDefinedBy "IEC 61892-2 / SOLAS Reg II-1" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty core:powersEquipment ;
            owl:someValuesFrom [ owl:complementOf electrical:HighVoltageSwitchgear ] ],
        [ a owl:Restriction ;
            owl:onProperty core:powersEquipment ;
            owl:someValuesFrom [ owl:complementOf electrical:HighVoltageSwitchgear ] ],
        [ a owl:Restriction ;
            owl:onProperty core:powersEquipment ;
            owl:someValuesFrom [ owl:complementOf electrical:HighVoltageSwitchgear ] ],
        electrical:PowerGenerationEquipment ;
    owl:disjointWith [ a owl:Restriction ;
            owl:onProperty core:powersEquipment ;
            owl:someValuesFrom electrical:HighVoltageSwitchgear ],
        [ a owl:Restriction ;
            owl:onProperty core:powersEquipment ;
            owl:someValuesFrom electrical:HighVoltageSwitchgear ] ;
    skos:definition "Auxiliary generator driven by a diesel engine to supply emergency power during main blackout events."@en .

core:isLocatedInFPSO a owl:ObjectProperty ;
    rdfs:label "is located in FPSO"@en,
        "está localizado no FPSO"@pt ;
    rdfs:domain core:FPSOModule ;
    rdfs:range o3po:FPSO ;
    rdfs:subPropertyOf uo:RO_0001025 ;
    owl:inverseOf [ owl:inverseOf core:isLocatedInFPSO ],
        core:hasFPSOModule ;
    skos:definition "Relates an FPSO topside module or process skid to the floating production vessel on which it is physically installed."@en .

core:isLocatedInModule a owl:ObjectProperty ;
    rdfs:label "is located in module"@en,
        "está localizado no módulo"@pt ;
    rdfs:domain core:TopsideEquipment ;
    rdfs:range core:FPSOModule ;
    rdfs:subPropertyOf uo:RO_0001025 ;
    owl:inverseOf [ owl:inverseOf core:isLocatedInModule ],
        core:containsEquipment ;
    skos:definition "Relates a topside equipment to the specific FPSO topside module or skid in which it is physically installed."@en .

core:monitorsEquipment a owl:ObjectProperty ;
    rdfs:label "monitors equipment"@en,
        "monitora equipamento"@pt ;
    rdfs:domain core:InstrumentationAndControlEquipment ;
    rdfs:range core:TopsideEquipment ;
    owl:inverseOf [ owl:inverseOf core:monitorsEquipment ] ;
    skos:definition "Relates an instrumentation equipment to the topside equipment whose process variables it monitors."@en .

<http://usp.ai/ontologies/fpeo-properties-equipments> a owl:Ontology ;
    dc:creator "Hugo Cardoso Ferreira de Araújo" ;
    dc:description "Properties, Data Artifacts, Metrological Units (UO) and Design Prescriptions Module for FPEO-Equipments Ontology under Industrial Ontologies Foundry (IOF-Core) and Ontological Realism"@en ;
    owl:imports uo:uo.owl,
        <http://usp.ai/ontologies/fpeo-crosswalk-equipments>,
        iof-core: .

prop:DesignTemperatureSpecification a owl:Class ;
    rdfs:label "Design Temperature Specification"@en,
        "Especificação de Temperatura de Projeto"@pt ;
    rdfs:subClassOf iof-core:DesignSpecification ;
    skos:definition "Design specification prescribing design temperature limits."@en .

prop:EfficiencyValueExpression a owl:Class ;
    rdfs:label "Efficiency Value Expression"@en,
        "Expressão de Valor de Eficiência"@pt ;
    rdfs:subClassOf iof-core:ValueExpression ;
    skos:altLabel "Percentage Value Expression"@en,
        "Expressão de Valor Percentual"@pt ;
    skos:definition "A value expression representing dimensionless efficiency paired with a percentage unit of measure (e.g. percent from UO)."@en .

prop:SpeedValueExpression a owl:Class ;
    rdfs:label "Speed Value Expression"@en,
        "Expressão de Valor de Velocidade"@pt ;
    rdfs:subClassOf iof-core:ValueExpression ;
    skos:altLabel "Rotational Frequency Value Expression"@en,
        "Expressão de Valor de Frequência de Rotação"@pt ;
    skos:definition "A value expression representing a rotational speed or frequency paired with a speed/frequency unit of measure (e.g. rpm, hertz from UO)."@en .

prop:ThermalEfficiencySpecification a owl:Class ;
    rdfs:label "Thermal Efficiency Specification"@en,
        "Especificação de Eficiência Térmica"@pt ;
    rdfs:subClassOf iof-core:DesignSpecification ;
    skos:definition "Design specification prescribing the target thermodynamic efficiency of a machine."@en .

prop:TurbineInletTemperatureSpecification a owl:Class ;
    rdfs:label "Turbine Inlet Temperature Specification (TIT)"@en,
        "Especificação de Temperatura de Entrada da Turbina (TIT)"@pt ;
    rdfs:subClassOf iof-core:DesignSpecification ;
    skos:definition "Design specification prescribing the maximum design temperature of combustion gas entering turbine nozzles."@en .

prop:drives a owl:ObjectProperty ;
    rdfs:label "drives"@en,
        "aciona"@pt ;
    owl:inverseOf [ owl:inverseOf prop:drives ],
        prop:isDrivenBy ;
    skos:definition "Functional mechanical relationship between a driving driver equipment (e.g. gas turbine) and driven equipment (e.g. generator, compressor)."@en .

prop:hasCompressor a owl:ObjectProperty ;
    rdfs:label "has compressor"@en,
        "tem compressor"@pt ;
    owl:inverseOf [ owl:inverseOf prop:hasCompressor ],
        prop:isCompressorOf .

prop:hasCoupling a owl:ObjectProperty ;
    rdfs:label "has coupling"@en,
        "tem acoplamento"@pt ;
    owl:inverseOf [ owl:inverseOf prop:hasCoupling ] .

prop:hasDrivenEquipment a owl:ObjectProperty ;
    rdfs:label "has driven equipment"@en,
        "tem equipamento acionado"@pt ;
    rdfs:domain dynamical:GasTurbineEquipment ;
    owl:inverseOf [ owl:inverseOf prop:hasDrivenEquipment ] .

prop:hasFuelSystem a owl:ObjectProperty ;
    rdfs:label "has fuel system"@en,
        "tem sistema de combustível"@pt ;
    rdfs:subPropertyOf prop:hasAuxiliarySystem ;
    owl:inverseOf [ owl:inverseOf prop:hasFuelSystem ] .

prop:hasGearbox a owl:ObjectProperty ;
    rdfs:label "has gearbox"@en,
        "tem caixa de engrenagens"@pt ;
    owl:inverseOf [ owl:inverseOf prop:hasGearbox ] .

prop:hasLubeOilSystem a owl:ObjectProperty ;
    rdfs:label "has lube oil system"@en,
        "tem sistema de óleo lubrificante"@pt ;
    rdfs:subPropertyOf prop:hasAuxiliarySystem ;
    owl:inverseOf [ owl:inverseOf prop:hasLubeOilSystem ] .

prop:measuresFlowOf a owl:ObjectProperty ;
    rdfs:label "measures flow of"@en,
        "mede vazão de"@pt ;
    rdfs:domain sensors:FlowMeter ;
    owl:inverseOf [ owl:inverseOf prop:measuresFlowOf ] .

prop:monitorsEmissionsAt a owl:ObjectProperty ;
    rdfs:label "monitors emissions at"@en,
        "monitora emissões em"@pt ;
    owl:inverseOf [ owl:inverseOf prop:monitorsEmissionsAt ],
        prop:hasEmissionsMonitor .

prop:suppliesFuelTo a owl:ObjectProperty ;
    rdfs:label "supplies fuel to"@en,
        "fornece combustível para"@pt ;
    owl:inverseOf [ owl:inverseOf prop:suppliesFuelTo ] .

<http://usp.ai/ontologies/fpeo-renewable-equipments> a owl:Ontology ;
    dc:creator "Hugo Cardoso Ferreira de Araújo" ;
    dc:description "Renewable Equipments Module for FPEO-Equipments Ontology"@en ;
    owl:imports <http://usp.ai/ontologies/fpeo-equipments-core> .

<http://usp.ai/ontologies/fpeo-rules-equipments> a owl:Ontology ;
    dc:creator "Hugo Cardoso Ferreira de Araújo" ;
    dc:description "Process Safety and Semantic Disjointness Axioms Module for FPEO-Equipments Ontology"@en,
        "SWRL Rules and Process Safety Axioms Module for FPEO-Equipments Ontology"@en ;
    owl:imports <http://usp.ai/ontologies/fpeo-properties-equipments> .

<http://usp.ai/ontologies/fpeo-sensors-equipments> a owl:Ontology ;
    dc:creator "Hugo Cardoso Ferreira de Araújo",
        "Inácio Turbiani" ;
    dc:description "Sensors and Instrumentation Equipment Module for FPEO-Equipments Ontology"@en ;
    owl:imports <http://usp.ai/ontologies/fpeo-equipments-core> .

sensors:VolumetricFlowMeter a owl:Class ;
    rdfs:label "Volumetric Flow Meter"@en,
        "Medidor de Vazão Volumétrica"@pt-br ;
    rdfs:comment "Fuel flow meter that measures the volumetric flow rate of the fluid (e.g., turbine, orifice plate, or ultrasonic technologies), generally requiring density/temperature/pressure compensation to obtain equivalent mass flow."@en,
        "Medidor de vazão de combustível que mede a vazão volumétrica do fluido (ex.: tecnologias de turbina, placa de orifício ou ultrassônica), geralmente requerendo compensação de densidade/temperatura/pressão para obter a vazão mássica equivalente."@pt-br ;
    rdfs:subClassOf sensors:FuelFlowMeter .

sensors:measuresFlowOf a owl:ObjectProperty ;
    rdfs:label "measures flow of"@en,
        "mede vazão de"@pt-br ;
    rdfs:domain sensors:FlowMeter ;
    owl:inverseOf [ owl:inverseOf sensors:measuresFlowOf ] ;
    skos:definition "Relates a flow meter to the substance or fluid whose flow rate it measures."@en .

<http://usp.ai/ontologies/fpeo-static-equipments> a owl:Ontology ;
    dc:creator "Hugo Cardoso Ferreira de Araújo" ;
    dc:description "Static Equipments Module for FPEO-Equipments Ontology with Integrity Axioms"@en ;
    owl:imports <http://usp.ai/ontologies/fpeo-equipments-core> .

static:CrudeExchangerPreFilter a owl:Class ;
    rdfs:label "Crude Exchanger Pre-Filter"@en,
        "Pré-Filtro do Trocador de Petróleo"@pt ;
    rdfs:isDefinedBy "API Spec 14E / ISO 15761" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty core:feedsFluidToEquipment ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( static:CrudeExchanger static:CrudePreheater static:CrudeHeater ) ] ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty core:feedsFluidToEquipment ],
        [ a owl:Restriction ;
            owl:onProperty core:feedsFluidToEquipment ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( static:CrudeExchanger static:CrudePreheater static:CrudeHeater ) ] ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty core:feedsFluidToEquipment ],
        [ a owl:Restriction ;
            owl:onProperty core:feedsFluidToEquipment ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( static:CrudeExchanger static:CrudePreheater static:CrudeHeater ) ] ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty core:feedsFluidToEquipment ],
        uo:BFO_0000040,
        static:ParticulateFilterEquipment,
        o3po:ParticulateFilter .

static:DirtySlopTank a owl:Class ;
    rdfs:label "Dirty Slop Tank"@en,
        "Tanque de Slop Sujo"@pt ;
    rdfs:isDefinedBy "API Spec 14E" ;
    rdfs:subClassOf static:StorageAndPipingHeaderEquipment .

static:HPFlareKnockoutDrum a owl:Class ;
    rdfs:label "HP Flare Knockout Drum"@en,
        "Vaso Knockout de Alta Pressão do Flare"@pt ;
    rdfs:isDefinedBy "ISO 23251 (API 521)" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty core:feedsFluidToEquipment ;
            owl:someValuesFrom static:IntegratedHPFlareTip ],
        [ a owl:Restriction ;
            owl:onProperty core:feedsFluidToEquipment ;
            owl:someValuesFrom static:IntegratedHPFlareTip ],
        [ a owl:Restriction ;
            owl:onProperty core:feedsFluidToEquipment ;
            owl:someValuesFrom static:IntegratedHPFlareTip ],
        uo:BFO_0000040,
        static:PressureVesselEquipment,
        o3po:GasScrubber ;
    owl:disjointWith static:LPFlareKnockoutDrum ;
    skos:altLabel "HP Flare Scrubber"@en,
        "Vaso Ciclônico de Alta Pressão do Flare"@pt .

static:NitrogenGenerationUnit a owl:Class ;
    rdfs:label "Membrane Nitrogen Generation Unit"@en,
        "Unidade Geradora de Nitrogênio por Membrana"@pt ;
    rdfs:isDefinedBy "API Spec 14E" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty core:feedsFluidToEquipment ;
            owl:someValuesFrom static:NitrogenReceiverTank ],
        [ a owl:Restriction ;
            owl:onProperty core:feedsFluidToEquipment ;
            owl:someValuesFrom static:NitrogenReceiverTank ],
        [ a owl:Restriction ;
            owl:onProperty core:feedsFluidToEquipment ;
            owl:someValuesFrom static:NitrogenReceiverTank ],
        uo:BFO_0000040,
        static:SeparationAndFilterEquipment .

static:SWExchangerPreFilter a owl:Class ;
    rdfs:label "SW Exchanger Pre-Filter"@en,
        "Pré-Filtro do Trocador de Água do Mar"@pt ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty core:feedsFluidToEquipment ;
            owl:someValuesFrom static:CoolingMediumSeawaterExchanger ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty core:feedsFluidToEquipment ],
        [ a owl:Restriction ;
            owl:onProperty core:feedsFluidToEquipment ;
            owl:someValuesFrom static:CoolingMediumSeawaterExchanger ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty core:feedsFluidToEquipment ],
        [ a owl:Restriction ;
            owl:onProperty core:feedsFluidToEquipment ;
            owl:someValuesFrom static:CoolingMediumSeawaterExchanger ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty core:feedsFluidToEquipment ],
        uo:BFO_0000040,
        static:ParticulateFilterEquipment,
        o3po:ParticulateFilter .

static:TestSeparator a owl:Class ;
    rdfs:label "Test Separator"@en,
        "Separador de Teste"@pt ;
    rdfs:isDefinedBy "API Spec 12J" ;
    rdfs:subClassOf static:PressureVesselEquipment,
        o3po:Separator,
        o3po:Vessel .

<http://usp.ai/ontologies/fpeo-valves-security> a owl:Ontology ;
    dc:creator "Hugo Cardoso Ferreira de Araújo" ;
    dc:description "Valves and Process Security Module for FPEO-Equipments Ontology"@en ;
    owl:imports <http://usp.ai/ontologies/fpeo-equipments-core> .

iof-core:Capability a owl:Class ;
    rdfs:subClassOf owl:Thing .

iof-core:InformationContentEntity a owl:Class ;
    rdfs:subClassOf owl:Thing .

iof-core:MeasurementInformationContentEntity a owl:Class ;
    rdfs:subClassOf owl:Thing .

<https://www.inf.ufrgs.br/bdi/ontologies/GEOCORE_0000008> a owl:Class ;
    rdfs:subClassOf owl:Thing .

<https://www.inf.ufrgs.br/ontologies/o3po> a owl:Ontology ;
    dc:contributor "Fabrício H. Rodrigues"@en,
        "Haroldo Rojas"@en,
        "Mara Abel"@en ;
    dc:creator "Nicolau Santos"@en ;
    dc:description "A domain ontology for offshore petroleum production plants has been established utilizing BFO as the top-level ontology and incorporating IOF-Core and GeoCore as middle-level ontologies."@en,
        "Uma ontologia de domínio para plantas de produção de petróleo offshore foi estabelecida utilizando BFO como a ontologia de topo e incorporando IOF-Core e GeoCore como ontologias de nível intermediário."@pt-br ;
    dc:license """MIT License

Copyright (c) 2025 Nicolau Oyhenard dos Santos

Permission is hereby granted, free of charge, to any person obtaining a copy of this software and associated documentation files (the "Software"), to deal in the Software without restriction, including without limitation the rights to use, copy, modify, merge, publish, distribute, sublicense, and/or sell copies of the Software, and to permit persons to whom the Software is furnished to do so, subject to the following conditions:

THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE."""@en ;
    dc:title "Offshore Petroleum Production Plant Ontology (O3PO)"@en,
        "Ontologia de Planta de Produção de Petróleo Offshore (O3PO)"@pt-br ;
    dcterms:abstract "A comprehensive domain ontology for modeling offshore petroleum production plants, their components, processes, and operational relationships."@en ;
    dcterms:created "2023-01-15"^^xsd:date ;
    dcterms:modified "2025-01-15"^^xsd:date ;
    dcterms:publisher "Federal University of Rio Grande do Sul (UFRGS) - Institute of Informatics"@en ;
    rdfs:comment "O3PO provides a comprehensive formal representation of offshore petroleum production systems based on BFO. The ontology follows aristotelian definition patterns as recommended in Barry Smith's 'Building Ontologies with Basic Formal Ontology'."@en ;
    owl:backwardCompatibleWith <https://www.petwin.org/O3PO/o3po/> ;
    owl:imports <http://purl.obolibrary.org/obo/bfo/2020/bfo.owl>,
        <http://purl.obolibrary.org/obo/iao/2022-11-07/iao.owl>,
        <https://spec.industrialontologies.org/ontology/202401/core/Core/>,
        <https://www.inf.ufrgs.br/bdi/ontologies/geocore/releases/2024-04-06/geocore.owl> ;
    owl:versionIRI <https://www.inf.ufrgs.br/ontologies/o3po/2.0> ;
    owl:versionInfo "2.0" ;
    foaf:homepage <https://www.inf.ufrgs.br/ontologies/o3po> ;
    schema:codeRepository <https://github.com/BDI-UFRGS/O3POntology> .

o3po:Manifold a owl:Class ;
    rdfs:label "manifold"@en,
        "manifold"@pt-br ;
    dc:source "https://www.glossary.oilfield.slb.com/en/Terms/m/manifold.aspx"@en ;
    ns1:definition "def. an assembly that has disposition to connect several flowlines and designed to control, distribute and typically monitor fluid flow from or to multiple wells"@en ;
    rdfs:comment "An arrangement of piping or valves designed to control, distribute and typically monitor fluid flow."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty o3po:hasComponent ;
            owl:someValuesFrom o3po:Tube ],
        [ a owl:Restriction ;
            owl:onProperty o3po:hasComponent ;
            owl:someValuesFrom o3po:Valve ],
        [ a owl:Restriction ;
            owl:onProperty o3po:hasComponent ;
            owl:someValuesFrom o3po:Tube ],
        [ a owl:Restriction ;
            owl:onProperty o3po:hasComponent ;
            owl:someValuesFrom o3po:Valve ],
        uo:BFO_0000040,
        iof-core:Assembly .

o3po:MolecularSieveVessel a owl:Class ;
    rdfs:label "molecular sieve vessel"@en,
        "vaso de peneira molecular"@pt-br ;
    ns1:definition "def. A vessel containing molecular sieve material (zeolites) used for the precise adsorption of water (dehydration) or other impurities from a gas stream."@en ;
    rdfs:subClassOf static:PressureVesselEquipment,
        o3po:Vessel .

o3po:NaturalGas a owl:Class ;
    rdfs:label "natural gas"@en,
        "gás natural"@pt-br ;
    ns1:definition "def. petroleum that is composed of a hydrocarbon gas mixture consisting primarily of methane, but commonly includes varying amounts of other higher alkanes and sometimes a usually lesser percentage of carbon dioxide, nitrogen, and/or hydrogen sulfide"@en ;
    rdfs:seeAlso "https://en.wikipedia.org/wiki/Natural_gas" ;
    rdfs:subClassOf o3po:Petroleum ;
    owl:disjointWith o3po:Water .

o3po:ProductionProcess a owl:Class ;
    rdfs:label "production (process)"@en,
        "produção (processo)"@pt-br ;
    ns1:definition "def. a flow that has a production well as participant and is towards a platform"@en ;
    rdfs:comment "The yield of an oil or gas well. Also that branch of the petroleum industry that has to do with bringing the well fluids to the surface and separating them, and with storing, gaging, and otherwise preparing the product for the pipeline."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty uo:RO_0000057 ;
            owl:someValuesFrom <https://www.inf.ufrgs.br/bdi/ontologies/GEOCORE_0000009> ],
        [ a owl:Restriction ;
            owl:onProperty uo:RO_0000057 ;
            owl:someValuesFrom o3po:ProductionWell ],
        [ a owl:Restriction ;
            owl:onProperty uo:RO_0000057 ;
            owl:someValuesFrom o3po:Reservoir ],
        [ a owl:Restriction ;
            owl:onProperty uo:RO_0000057 ;
            owl:someValuesFrom <https://www.inf.ufrgs.br/bdi/ontologies/GEOCORE_0000009> ],
        [ a owl:Restriction ;
            owl:onProperty uo:RO_0000057 ;
            owl:someValuesFrom o3po:ProductionWell ],
        [ a owl:Restriction ;
            owl:onProperty uo:RO_0000057 ;
            owl:someValuesFrom o3po:Reservoir ],
        o3po:Flow .

o3po:Scrubber a owl:Class ;
    rdfs:label "scrubber"@en,
        "vaso depurador"@pt-br ;
    ns1:definition "def. A vessel designed to remove liquid droplets or solid particles from a gas stream using gravity, impingement, or centrifugal force."@en ;
    rdfs:subClassOf static:PressureVesselEquipment,
        o3po:Vessel .

o3po:Semisubmersible a owl:Class ;
    rdfs:label "semisubmersible"@en,
        "semissubmersível"@pt-br ;
    ns2:source "https://www.glossary.oilfield.slb.com/Terms/s/semisubmersible.aspx"@en ;
    ns1:definition "def. offshore platform that can be used for drilling, workover operations, and production platforms, depending on the equipment with which they are equipped"@en ;
    rdfs:comment "A particular type of floating vessel that is supported primarily on large pontoon-like structures submerged below the sea surface. The operating decks are elevated perhaps 100 or more feet above the pontoons on large steel columns. Semisubmersibles can operate in a wide range of water depths, including deep water."@en ;
    rdfs:subClassOf o3po:Platform .

o3po:TemperatureSensor a owl:Class ;
    rdfs:label "temperature sensor"@en,
        "sensor de temperatura"@pt-br ;
    ns1:definition "def. a sensor that measures the temperature of a fluid"@en ;
    rdfs:comment "A device that measures temperature or a temperature gradient (the degree of hotness or coldness of an object)."@en ;
    rdfs:seeAlso "https://en.wikipedia.org/wiki/Thermometer"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty o3po:measures ;
            owl:someValuesFrom o3po:Temperature ],
        [ a owl:Restriction ;
            owl:onProperty o3po:measures ;
            owl:someValuesFrom o3po:Temperature ],
        o3po:Sensor .

o3po:WellLiquidRateStandardConditions a owl:Class ;
    rdfs:label "well liquid rate standard conditions"@en,
        "vazão de líquido do poço em condições padrão"@pt-br ;
    ns1:definition "def. a well flow rate measured at standard conditions"@en ;
    rdfs:subClassOf o3po:WellFlowRate .

o3po:hasFluidSuppliedBy a owl:ObjectProperty ;
    rdfs:label "has fluid supplied by"@en,
        "tem fluido fornecido por"@pt-br ;
    rdfs:comment "Relation between a thing that has fluid supplied to it and the thing supplying the fluid."@en ;
    rdfs:subPropertyOf o3po:feedsFluidTo ;
    owl:inverseOf [ owl:inverseOf o3po:hasFluidSuppliedBy ],
        o3po:suppliesFluidTo ;
    ns3:adaptedFrom "http://www.w3id.org/fso"@en .

o3po:isProducedBy a owl:ObjectProperty ;
    rdfs:label "is produced by"@en,
        "é produzido por"@pt-br ;
    ns1:definition "def. inverse of produces"@en ;
    owl:inverseOf [ owl:inverseOf o3po:isProducedBy ] .

o3po:isSeparatedBy a owl:ObjectProperty ;
    rdfs:label "is separated by"@en,
        "é separado por"@pt-br ;
    ns1:definition "def. inverse of separates"@en ;
    owl:inverseOf [ owl:inverseOf o3po:isSeparatedBy ] .

o3po:isTreatedBy a owl:ObjectProperty ;
    rdfs:label "is treated by"@en,
        "é tratado por"@pt-br ;
    ns1:definition "def. inverse of treats"@en ;
    owl:inverseOf [ owl:inverseOf o3po:isTreatedBy ],
        o3po:treats .

o3po:transports a owl:ObjectProperty ;
    rdfs:label "transports"@en,
        "transporta"@pt-br ;
    ns1:definition "def. the action of transporting something or the state of being transported"@en ;
    rdfs:seeAlso "https://www.lexico.com/en/definition/transport"@en ;
    owl:inverseOf [ owl:inverseOf o3po:transports ] .

uo:BFO_0000029 a owl:Class ;
    rdfs:subClassOf owl:Thing .

uo:BFO_0000146 a owl:Class ;
    rdfs:subClassOf owl:Thing .

uo:UO_0000027 a uo:UO_0000000,
        owl:NamedIndividual,
        owl:Thing .

uo:UO_0000036 a uo:UO_0000000,
        owl:NamedIndividual,
        owl:Thing .

abox:CombustionChamber_GTG01 a dynamical:CombustionChamber,
        dynamical:TurbineComponentEquipment,
        core:DynamicalEquipment,
        core:TopsideEquipment,
        owl:NamedIndividual,
        owl:Thing,
        iof-core:MaterialArtifact ;
    rdfs:label "DLN Combustion Chamber GTG-01"@en ;
    uo:BFO_0000050 abox:MainTurbineGenerator_GTG01 ;
    o3po:componentOf abox:MainTurbineGenerator_GTG01 .

abox:Shaft_GTG01 a dynamical:Shaft,
        dynamical:TurbineComponentEquipment,
        core:DynamicalEquipment,
        core:TopsideEquipment,
        owl:NamedIndividual,
        owl:Thing,
        iof-core:MaterialArtifact ;
    rdfs:label "Rotor Shaft GTG-01"@en ;
    uo:BFO_0000050 abox:MainTurbineGenerator_GTG01 ;
    o3po:componentOf abox:MainTurbineGenerator_GTG01 .

dynamical:BledGasTurbine a owl:Class ;
    rdfs:label "Bled Gas Turbine"@en,
        "Turbina a Gás com Sangria"@pt ;
    rdfs:isDefinedBy "ISO 11042 / API Spec 616" ;
    rdfs:subClassOf dynamical:GasTurbineEquipment ;
    skos:definition "Gas turbine which has, for external use, extraction of compressed air between compressor stages and/or at the discharge of the compressor."@en .

dynamical:HighPressureCompressor a owl:Class ;
    rdfs:label "High Pressure Compressor"@en,
        "Compressor de Alta Pressão"@pt ;
    rdfs:isDefinedBy "ISO 10439" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty core:feedsFluidToEquipment ;
            owl:someValuesFrom [ owl:complementOf static:LPFlareKnockoutDrum ] ],
        dynamical:CompressorEquipment ;
    owl:disjointWith [ a owl:Restriction ;
            owl:onProperty core:feedsFluidToEquipment ;
            owl:someValuesFrom static:LPFlareKnockoutDrum ],
        [ a owl:Restriction ;
            owl:onProperty core:feedsFluidToEquipment ;
            owl:someValuesFrom static:CoolingMediumSeawaterExchanger ],
        [ a owl:Restriction ;
            owl:onProperty core:feedsFluidToEquipment ;
            owl:someValuesFrom static:LPFlareKnockoutDrum ],
        [ a owl:Restriction ;
            owl:onProperty core:feedsFluidToEquipment ;
            owl:someValuesFrom static:CoolingMediumSeawaterExchanger ] .

dynamical:ProcessVRUCompressor a owl:Class ;
    rdfs:label "Process VRU Compressor"@en,
        "Compressor da Unidade de Recuperação de Vapores (VRU)"@pt ;
    rdfs:isDefinedBy "ISO 10440 (Screw Compressors)" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty core:feedsFluidToEquipment ;
            owl:someValuesFrom dynamical:LowPressureCompressor ],
        dynamical:CompressorEquipment .

dynamical:SeawaterLiftPump a owl:Class ;
    rdfs:label "Seawater Lift Pump"@en,
        "Bomba de Elevação de Água do Mar"@pt ;
    rdfs:isDefinedBy "ISO 13709" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty core:feedsFluidToEquipment ;
            owl:someValuesFrom static:SeawaterCoarseStrainer ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty core:feedsFluidToEquipment ],
        uo:BFO_0000040,
        dynamical:CentrifugalPumpEquipment,
        o3po:CentrifugalPump ;
    skos:altLabel "Seawater Intake Pump"@en,
        "Bomba de Captação de Água do Mar"@pt .

dynamical:SingleShaftGasTurbine a owl:Class ;
    rdfs:label "Single Shaft Gas Turbine"@en,
        "Turbina a Gás Monoeixo"@pt ;
    rdfs:isDefinedBy "ISO 11042" ;
    rdfs:subClassOf [ a owl:Class ;
            owl:complementOf [ a owl:Restriction ;
                    owl:onProperty prop:hasPowerTurbine ;
                    owl:someValuesFrom dynamical:PowerTurbine ] ],
        dynamical:GasTurbineEquipment ;
    owl:disjointWith [ a owl:Restriction ;
            owl:onProperty prop:hasPowerTurbine ;
            owl:someValuesFrom dynamical:PowerTurbine ],
        [ a owl:Restriction ;
            owl:onProperty prop:hasPowerTurbine ;
            owl:someValuesFrom dynamical:PowerTurbine ] ;
    skos:definition "Gas turbine where compressor and turbine stages are coupled on a single common shaft."@en .

dynamical:TestSeparatorOilPump a owl:Class ;
    rdfs:label "Test Separator Oil Pump"@en,
        "Bomba de Óleo do Separador de Teste"@pt ;
    rdfs:isDefinedBy "ISO 13709 (Centrifugal Pumps)" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty core:feedsFluidToEquipment ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( static:TestInletHeater static:CrudeExchanger static:CrudePreheater ) ] ],
        uo:BFO_0000040,
        dynamical:CentrifugalPumpEquipment,
        o3po:CentrifugalPump .

electrical:MainTurbineGenerator a owl:Class ;
    rdfs:label "Main Turbine Generator"@en,
        "Gerador Principal a Turbina"@pt ;
    rdfs:isDefinedBy "IEC 61892-1 / IEEE 45" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty core:powersEquipment ;
            owl:someValuesFrom electrical:HighVoltageSwitchgear ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty core:powersEquipment ],
        [ a owl:Restriction ;
            owl:onProperty core:powersEquipment ;
            owl:someValuesFrom electrical:HighVoltageSwitchgear ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty core:powersEquipment ],
        [ a owl:Restriction ;
            owl:onProperty core:powersEquipment ;
            owl:someValuesFrom electrical:HighVoltageSwitchgear ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty core:powersEquipment ],
        electrical:PowerGenerationEquipment ;
    skos:definition "Primary synchronous generator coupled to a gas turbine driver to supply continuous main power for topside facilities."@en .

core:SignalPort a owl:Class ;
    rdfs:label "Signal Port"@en ;
    rdfs:subClassOf core:EquipmentPort ;
    skos:definition "An equipment port designed as the physical interface for transmitting or receiving analog, digital, or pneumatic signals for control, measurement, and safety interlocking."@en .

core:containsEquipment a owl:ObjectProperty ;
    rdfs:label "contains equipment"@en,
        "contém equipamento"@pt ;
    rdfs:domain core:FPSOModule ;
    rdfs:range core:TopsideEquipment ;
    rdfs:subPropertyOf uo:RO_0001015 ;
    owl:inverseOf [ owl:inverseOf core:containsEquipment ] ;
    skos:definition "Relates an FPSO topside module to the topside equipment installed within its boundary."@en .

core:hasFPSOModule a owl:ObjectProperty ;
    rdfs:label "has FPSO module"@en,
        "possui módulo FPSO"@pt ;
    rdfs:domain o3po:FPSO ;
    rdfs:range core:FPSOModule ;
    rdfs:subPropertyOf uo:RO_0001015 ;
    owl:inverseOf [ owl:inverseOf core:hasFPSOModule ] ;
    skos:definition "Relates an FPSO vessel to the topside modules physically installed on its deck."@en .

core:receivesFluidFromEquipment a owl:ObjectProperty ;
    rdfs:label "receives fluid from equipment"@en,
        "recebe fluido de equipamento"@pt ;
    rdfs:domain core:TopsideEquipment ;
    rdfs:range core:TopsideEquipment ;
    rdfs:subPropertyOf o3po:hasFluidFedBy ;
    owl:inverseOf [ owl:inverseOf core:receivesFluidFromEquipment ] .

prop:TemperatureValueExpression a owl:Class ;
    rdfs:label "Temperature Value Expression"@en,
        "Expressão de Valor de Temperatura"@pt ;
    rdfs:subClassOf iof-core:ValueExpression ;
    skos:definition "A value expression representing a thermal magnitude paired with a temperature unit of measure (e.g. degree Celsius, kelvin from UO)."@en .

prop:hasEmissionsMonitor a owl:ObjectProperty ;
    rdfs:label "has emissions monitor"@en,
        "tem monitor de emissões"@pt ;
    owl:inverseOf [ owl:inverseOf prop:hasEmissionsMonitor ] .

prop:isCompressorOf a owl:ObjectProperty ;
    rdfs:label "is compressor of"@en,
        "é compressor de"@pt ;
    owl:inverseOf [ owl:inverseOf prop:isCompressorOf ] .

prop:isDrivenBy a owl:ObjectProperty ;
    rdfs:label "is driven by"@en,
        "é acionado por"@pt ;
    owl:inverseOf [ owl:inverseOf prop:isDrivenBy ] .

renewable:RenewablePowerConversionEquipment a owl:Class ;
    rdfs:label "Renewable Power Conversion Equipment"@en,
        "Equipamento de Conversão de Energia Renovável"@pt ;
    rdfs:subClassOf core:RenewableEquipment ;
    skos:definition "Power electronics equipment designed to condition, invert, or transform electrical power generated by renewable sources for integration into the topside grid."@en .

renewable:RenewablePowerGenerationEquipment a owl:Class ;
    rdfs:label "Renewable Power Generation Equipment"@en,
        "Equipamento de Geração Renovável de Energia"@pt ;
    rdfs:subClassOf core:RenewableEquipment ;
    skos:definition "A physical artifact engineered to capture ambient renewable energy (solar, wind) and convert it into electrical power."@en .

sensors:FuelFlowMeter a owl:Class ;
    rdfs:label "Fuel Flow Meter"@en,
        "Medidor de Vazão de Combustível"@pt-br ;
    rdfs:comment "Flow meter installed in the gas turbine fuel system, used to measure the fuel flow rate supplied to the combustion chamber(s) — a quantity used in calculating specific fuel consumption (ISO 3977-1, 2.33) and the unit energy balance."@en,
        "Medidor de vazão instalado no sistema de combustível da turbina a gás, usado para medir a vazão de combustível fornecida à(s) câmara(s) de combustão — grandeza usada no cálculo do consumo específico de combustível (ISO 3977-1, 2.33) e no balanço de energia da unidade."@pt-br ;
    rdfs:subClassOf sensors:FlowMeter,
        o3po:Flowmeter .

static:AirReceiverTank a owl:Class ;
    rdfs:label "Air Receiver Tank"@en,
        "Vaso Pulmão de Ar Comprimido"@pt ;
    rdfs:isDefinedBy "API Spec 12J" ;
    rdfs:subClassOf static:PressureVesselEquipment,
        o3po:Vessel .

static:CoalescingFilterEquipment a owl:Class ;
    rdfs:label "Coalescing Filter Equipment"@en,
        "Filtro Coalescente"@pt ;
    rdfs:subClassOf static:FilterEquipment,
        o3po:Filter ;
    owl:equivalentClass o3po:CoalescingFilter ;
    skos:definition "A filter designed to aggregate fine liquid droplets into larger drops for phase separation."@en .

static:DilutionWaterHeater a owl:Class ;
    rdfs:label "Dilution Water Heater"@en,
        "Aquecedor de Água de Diluição"@pt ;
    rdfs:isDefinedBy "ISO 16812 / API Spec 12K" ;
    rdfs:subClassOf static:HeatExchangeEquipment,
        o3po:HeatExchanger,
        o3po:Heater .

static:PIPWaterHeater a owl:Class ;
    rdfs:label "PIP Water Heater"@en,
        "Aquecedor de Água PIP"@pt ;
    rdfs:isDefinedBy "ISO 16812 / API Spec 12K" ;
    rdfs:subClassOf static:HeatExchangeEquipment,
        o3po:HeatExchanger,
        o3po:Heater .

iof-core:hasSimpleExpressionValue a owl:DatatypeProperty ;
    rdfs:label "has simple expression value"@en,
        "tem valor de expressão simples"@pt ;
    rdfs:domain iof-core:ValueExpression ;
    rdfs:range rdfs:Literal ;
    skos:definition "Relates a value expression to the literal that represents the magnitude or category of an entity."@en .

o3po:Basin a owl:Class ;
    rdfs:label "basin"@en,
        "bacia"@pt-br ;
    ns1:definition "def. a two-dimensional continuant faunal boundary"@en ;
    rdfs:subClassOf uo:BFO_0000146 .

o3po:Borehole a owl:Class ;
    rdfs:label "wellbore"@en,
        "furo do poço"@pt-br ;
    ns2:hasRelatedSynonym "borehole"@en ;
    ns2:source "https://www.lexico.com/en/definition/well"@en ;
    ns1:definition "def. a BFO:Site that is a boring in the Earth designed to bring oil, gas or water to the surface"@en ;
    rdfs:comment "A shaft sunk into the ground to obtain water, oil, or gas."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty uo:BFO_0000050 ;
            owl:someValuesFrom o3po:Well ],
        [ a owl:Restriction ;
            owl:onProperty uo:BFO_0000050 ;
            owl:someValuesFrom o3po:Well ],
        uo:BFO_0000029 .

o3po:CoalescingFilter a owl:Class ;
    rdfs:label "coalescing filter"@en,
        "filtro coalescente"@pt-br ;
    ns1:definition "def. A filter designed to cause liquid aerosols in a gas stream to coalesce into larger droplets for removal."@en ;
    rdfs:subClassOf static:FilterEquipment,
        o3po:Filter .

o3po:CommonCloseControlLinePressure a owl:Class ;
    rdfs:label "common close control line pressure"@en,
        "pressão de linha de controle comum de fechamento"@pt-br ;
    ns1:definition "def. a pressure in a control line"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty uo:RO_0000080 ;
            owl:someValuesFrom o3po:ControlLine ],
        [ a owl:Restriction ;
            owl:onProperty uo:RO_0000080 ;
            owl:someValuesFrom o3po:ControlLine ],
        o3po:Pressure .

o3po:ControlLine a owl:Class ;
    rdfs:label "control line"@en,
        "linha de controle"@pt-br ;
    ns1:definition "def. a tube that is a small-diameter hydraulic line used to operate downhole completion equipment"@en ;
    rdfs:comment "A small-diameter hydraulic line used to operate downhole completion equipment such as the surface controlled subsurface safety valve (SCSSV). Most systems operated by control line operate on a fail-safe basis."@en ;
    rdfs:subClassOf o3po:Tube .

o3po:Flowmeter a owl:Class ;
    rdfs:label "flowmeter"@en,
        "medidor de vazão"@pt-br ;
    ns1:definition "def. a sensor that measures the flow rate of fluids through a pipeline"@en ;
    rdfs:comment "An instrument that measures the flow rate of fluids through a pipeline."@en ;
    rdfs:seeAlso "https://glossary.oilfield.slb.com/en/Terms/f/flowmeter.aspx"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty o3po:measures ;
            owl:someValuesFrom o3po:FlowRate ],
        [ a owl:Restriction ;
            owl:onProperty o3po:measures ;
            owl:someValuesFrom o3po:FlowRate ],
        sensors:MeasuringInstrument,
        o3po:Sensor .

o3po:GasLiftValve a owl:Class ;
    rdfs:label "gas-lift valve"@en,
        "válvula de gas-lift"@pt-br ;
    ns1:definition "def. a valve used in gas-lift operations"@en ;
    rdfs:subClassOf core:ValveAndSecurityEquipment,
        o3po:Valve .

o3po:GasScrubber a owl:Class ;
    rdfs:label "gas scrubber"@en,
        "depurador de gás"@pt-br ;
    ns1:definition "def. A scrubber specifically used to clean a natural gas stream before compression or dehydration."@en ;
    rdfs:subClassOf o3po:Scrubber .

o3po:ICVFlowRateICVMethod a owl:Class ;
    rdfs:label "ICV flow rate ICV method"@en,
        "vazão da ICV método ICV"@pt-br ;
    ns1:definition "def. a flow rate measurement datum about ICV flow rate determined using the ICV method"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty iof-core:isAbout ;
            owl:someValuesFrom o3po:ICVFlowRate ],
        [ a owl:Restriction ;
            owl:onProperty iof-core:isAbout ;
            owl:someValuesFrom o3po:ICVFlowRate ],
        o3po:FlowRateMeasurementDatum .

o3po:ICVFlowRateIPRMethod a owl:Class ;
    rdfs:label "ICV flow rate IPR method"@en,
        "vazão da ICV método IPR"@pt-br ;
    ns1:definition "def. a flow rate measurement datum about ICV flow rate determined using the IPR (Inflow Performance Relationship) method"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty iof-core:isAbout ;
            owl:someValuesFrom o3po:ICVFlowRate ],
        [ a owl:Restriction ;
            owl:onProperty iof-core:isAbout ;
            owl:someValuesFrom o3po:ICVFlowRate ],
        o3po:FlowRateMeasurementDatum .

o3po:ICVFlowRateReconciledMethod a owl:Class ;
    rdfs:label "ICV flow rate reconciled method"@en,
        "vazão da ICV método reconciliado"@pt-br ;
    ns1:definition "def. a flow rate measurement datum about ICV flow rate determined using a reconciled method that combines multiple measurement sources"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty iof-core:isAbout ;
            owl:someValuesFrom o3po:ICVFlowRate ],
        [ a owl:Restriction ;
            owl:onProperty iof-core:isAbout ;
            owl:someValuesFrom o3po:ICVFlowRate ],
        o3po:FlowRateMeasurementDatum .

o3po:InjectionRole a owl:Class ;
    rdfs:label "injection role"@en,
        "papel de injeção"@pt-br ;
    ns1:definition "def. a role borne by a fluid that is being injected into a well"@en ;
    rdfs:comment "Role assumed by a fluid that is being injected into a well."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty iof-core:roleOf ;
            owl:someValuesFrom o3po:InjectionFluid ],
        [ a owl:Restriction ;
            owl:allValuesFrom o3po:InjectionFluid ;
            owl:onProperty iof-core:roleOf ],
        [ a owl:Restriction ;
            owl:onProperty iof-core:roleOf ;
            owl:someValuesFrom o3po:InjectionFluid ],
        [ a owl:Restriction ;
            owl:allValuesFrom o3po:InjectionFluid ;
            owl:onProperty iof-core:roleOf ],
        uo:BFO_0000023 .

o3po:InjectorRole a owl:Class ;
    rdfs:label "injector role"@en,
        "papel de injetor"@pt-br ;
    ns1:definition "def. a role borne by a well that injects fluids"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty iof-core:roleOf ;
            owl:someValuesFrom o3po:Well ],
        [ a owl:Restriction ;
            owl:allValuesFrom o3po:Well ;
            owl:onProperty iof-core:roleOf ],
        [ a owl:Restriction ;
            owl:onProperty iof-core:roleOf ;
            owl:someValuesFrom o3po:Well ],
        [ a owl:Restriction ;
            owl:allValuesFrom o3po:Well ;
            owl:onProperty iof-core:roleOf ],
        uo:BFO_0000023 .

o3po:Name a owl:Class ;
    rdfs:label "name"@en,
        "nome"@pt-br ;
    ns1:definition "def. a quality that serves as a linguistic identifier for an entity"@en ;
    rdfs:subClassOf uo:BFO_0000019 .

o3po:ObservationRole a owl:Class ;
    rdfs:label "observation role"@en,
        "papel de observação"@pt-br ;
    ns1:definition "def. a role borne by a well used for observation"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty iof-core:roleOf ;
            owl:someValuesFrom o3po:ObservationWell ],
