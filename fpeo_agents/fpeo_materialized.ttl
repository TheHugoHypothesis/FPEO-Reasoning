    o3po:hasFluidFedBy abox:LPCompressor_K02,
        abox:VRUCompressor_K01 .

uo:RO_0000080 a owl:ObjectProperty ;
    owl:inverseOf [ owl:inverseOf uo:RO_0000080 ] .

