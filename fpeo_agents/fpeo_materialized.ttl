            owl:onProperty iof-core:roleOf ;
            owl:someValuesFrom o3po:ObservationWell ],
        [ a owl:Restriction ;
            owl:allValuesFrom o3po:ObservationWell ;
            owl:onProperty iof-core:roleOf ],
        uo:BFO_0000023 .

o3po:PressureDownstreamOfChoke a owl:Class ;
    rdfs:label "pressure downstream of choke"@en,
        "pressão à jusante do choke"@pt-br ;
    ns1:definition "def. a pressure measured downstream of a choke"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty uo:RO_0000080 ;
            owl:someValuesFrom o3po:Choke ],
        [ a owl:Restriction ;
            owl:onProperty uo:RO_0000080 ;
            owl:someValuesFrom o3po:Choke ],
        o3po:Pressure .

o3po:PressureUpstreamOfChoke a owl:Class ;
    rdfs:label "pressure upstream of choke"@en,
        "pressão à montante do choke"@pt-br ;
    ns1:definition "def. a pressure measured upstream of a choke"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty uo:RO_0000080 ;
            owl:someValuesFrom o3po:Choke ],
        [ a owl:Restriction ;
            owl:onProperty uo:RO_0000080 ;
            owl:someValuesFrom o3po:Choke ],
        o3po:Pressure .

o3po:ProducerRole a owl:Class ;
    rdfs:label "producer role"@en,
        "papel de produtor"@pt-br ;
    ns1:definition "def. a role borne by a well that produces hydrocarbons"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty iof-core:roleOf ;
            owl:someValuesFrom o3po:Well ],
        [ a owl:Restriction ;
            owl:allValuesFrom o3po:Well ;
            owl:onProperty iof-core:roleOf ],
        [ a owl:Restriction ;
            owl:onProperty iof-core:roleOf ;
            owl:someValuesFrom o3po:Well ],
        [ a owl:Restriction ;
            owl:allValuesFrom o3po:Well ;
            owl:onProperty iof-core:roleOf ],
        uo:BFO_0000023 .

o3po:ProductionRole a owl:Class ;
    rdfs:label "production role"@en,
        "papel de produção"@pt-br ;
    ns1:definition "def. a role borne by a fluid that is produced by a well"@en ;
    rdfs:comment "Role assumed by a fluid that is produced by a well such as natural gas or crude oil that are being produced by a well."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty iof-core:roleOf ;
            owl:someValuesFrom o3po:ProductionFluid ],
        [ a owl:Restriction ;
            owl:allValuesFrom o3po:ProductionFluid ;
            owl:onProperty iof-core:roleOf ],
        [ a owl:Restriction ;
            owl:onProperty iof-core:roleOf ;
            owl:someValuesFrom o3po:ProductionFluid ],
        [ a owl:Restriction ;
            owl:allValuesFrom o3po:ProductionFluid ;
            owl:onProperty iof-core:roleOf ],
        uo:BFO_0000023 .

o3po:ReservoirRole a owl:Class ;
    rdfs:label "reservoir role"@en,
        "papel de reservatório"@pt-br ;
    ns1:definition "def. a role borne by a reservoir"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty uo:RO_0000081 ;
            owl:someValuesFrom o3po:Reservoir ],
        [ a owl:Restriction ;
            owl:onProperty uo:RO_0000081 ;
            owl:someValuesFrom o3po:Reservoir ],
        uo:BFO_0000023 .

o3po:TemperatureDownstreamOfChoke a owl:Class ;
    rdfs:label "temperature downstream of choke"@en,
        "temperatura à jusante do choke"@pt-br ;
    ns1:definition "def. a temperature measured downstream of a choke"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty uo:RO_0000080 ;
            owl:someValuesFrom o3po:Choke ],
        [ a owl:Restriction ;
            owl:onProperty uo:RO_0000080 ;
            owl:someValuesFrom o3po:Choke ],
        o3po:Temperature .

o3po:TemperatureUpstreamOfChoke a owl:Class ;
    rdfs:label "temperature upstream of choke"@en,
        "temperatura à montante do choke"@pt-br ;
    ns1:definition "def. a temperature measured upstream of a choke"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty uo:RO_0000080 ;
            owl:someValuesFrom o3po:Choke ],
        [ a owl:Restriction ;
            owl:onProperty uo:RO_0000080 ;
            owl:someValuesFrom o3po:Choke ],
        o3po:Temperature .

o3po:TubingDownholePressure a owl:Class ;
    rdfs:label "tubing downhole pressure"@en,
        "pressão de fundo do tubing"@pt-br ;
    ns1:definition "def. a pressure measured at the downhole location of tubing"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty iof-core:qualityOf ;
            owl:someValuesFrom o3po:Tubing ],
        [ a owl:Restriction ;
            owl:onProperty iof-core:qualityOf ;
            owl:someValuesFrom o3po:Tubing ],
        o3po:Pressure .

o3po:TubingDownholeTemperature a owl:Class ;
    rdfs:label "tubing downhole temperature"@en,
        "temperatura de fundo do tubing"@pt-br ;
    ns1:definition "def. a temperature measured at the downhole location of tubing"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty iof-core:qualityOf ;
            owl:someValuesFrom o3po:Tubing ],
        [ a owl:Restriction ;
            owl:onProperty iof-core:qualityOf ;
            owl:someValuesFrom o3po:Tubing ],
        o3po:Temperature .

o3po:TubingRole a owl:Class ;
    rdfs:label "tubing role"@en,
        "papel de tubing"@pt-br ;
    ns1:definition "def. a role borne by a pipeline that is inside a well"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty iof-core:roleOf ;
            owl:someValuesFrom o3po:Pipeline ],
        [ a owl:Restriction ;
            owl:allValuesFrom o3po:Pipeline ;
            owl:onProperty iof-core:roleOf ],
        [ a owl:Restriction ;
            owl:onProperty iof-core:roleOf ;
            owl:someValuesFrom o3po:Pipeline ],
        [ a owl:Restriction ;
            owl:allValuesFrom o3po:Pipeline ;
            owl:onProperty iof-core:roleOf ],
        uo:BFO_0000023 .

o3po:WellheadPressure a owl:Class ;
    rdfs:label "wellhead pressure"@en,
        "pressão na cabeça do poço"@pt-br ;
    ns1:definition "def. a pressure measured at the wellhead"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty iof-core:qualityOf ;
            owl:someValuesFrom o3po:Wellhead ],
        [ a owl:Restriction ;
            owl:onProperty iof-core:qualityOf ;
            owl:someValuesFrom o3po:Wellhead ],
        o3po:Pressure .

o3po:WellheadTemperature a owl:Class ;
    rdfs:label "wellhead temperature"@en,
        "temperatura na cabeça do poço"@pt-br ;
    ns1:definition "def. a temperature measured at the wellhead"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty iof-core:qualityOf ;
            owl:someValuesFrom o3po:Wellhead ],
        [ a owl:Restriction ;
            owl:onProperty iof-core:qualityOf ;
            owl:someValuesFrom o3po:Wellhead ],
        o3po:Temperature .

o3po:hasFluidReturnedBy a owl:ObjectProperty ;
    rdfs:label "has fluid returned by"@en,
        "tem fluido retornado por"@pt-br ;
    rdfs:comment "Relation between a thing that has fluid returned to it and the thing returning the fluid."@en ;
    rdfs:subPropertyOf o3po:feedsFluidTo ;
    owl:inverseOf [ owl:inverseOf o3po:hasFluidReturnedBy ],
        o3po:returnsFluidTo ;
    ns3:adaptedFrom "http://www.w3id.org/fso"@en .

o3po:injects a owl:ObjectProperty ;
    rdfs:label "injects"@en,
        "injeta"@pt-br ;
    ns1:definition "def. to introduce (something) into a passage, cavity, or solid material under pressure"@en ;
    rdfs:seeAlso "https://www.lexico.com/en/definition/inject"@en ;
    owl:inverseOf [ owl:inverseOf o3po:injects ],
        o3po:isInjectedBy .

o3po:isInjectedBy a owl:ObjectProperty ;
    rdfs:label "is injected by"@en,
        "é injetado por"@pt-br ;
    ns1:definition "def. inverse of injects"@en ;
    owl:inverseOf [ owl:inverseOf o3po:isInjectedBy ],
        o3po:injects .

o3po:returnsFluidTo a owl:ObjectProperty ;
    rdfs:label "returns fluid to"@en,
        "retorna fluido para"@pt-br ;
    rdfs:comment "Relation implying logical return flow from a thing to another."@en ;
    rdfs:subPropertyOf o3po:hasFluidFedBy ;
    owl:inverseOf [ owl:inverseOf o3po:returnsFluidTo ],
        o3po:hasFluidReturnedBy ;
    ns3:adaptedFrom "http://www.w3id.org/fso"@en .

o3po:suppliesFluidTo a owl:ObjectProperty ;
    rdfs:label "supplies fluid to"@en,
        "fornece fluido para"@pt-br ;
    rdfs:comment "Relation implying logical supply flow from a thing to another."@en ;
    rdfs:subPropertyOf o3po:hasFluidFedBy ;
    owl:inverseOf [ owl:inverseOf o3po:suppliesFluidTo ] ;
    ns3:adaptedFrom "http://www.w3id.org/fso"@en .

o3po:treats a owl:AsymmetricProperty,
        owl:FunctionalProperty,
        owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:label "treats"@en,
        "trata"@pt-br ;
    ns1:definition "def. to apply a process or a substance to (something) to protect or preserve it or to give it particular properties"@en ;
    rdfs:seeAlso "https://www.lexico.com/en/definition/treat"@en ;
    owl:inverseOf [ owl:inverseOf o3po:treats ] .

uo:IAO_0000039 a owl:ObjectProperty ;
    rdfs:label "has measurement unit label"@en,
        "tem rótulo de unidade de medida"@pt ;
    rdfs:domain iof-core:ValueExpression ;
    rdfs:range uo:UO_0000000 ;
    owl:inverseOf [ owl:inverseOf uo:IAO_0000039 ] ;
    skos:definition "Relates an IOF ValueExpression to the standardized unit of measurement instance defined in the Unit of Measurement Ontology (UO)."@en .

uo:RO_0000081 a owl:ObjectProperty ;
    owl:inverseOf [ owl:inverseOf uo:RO_0000081 ] .

uo:RO_0000086 a owl:ObjectProperty ;
    owl:inverseOf [ owl:inverseOf uo:RO_0000086 ] .

uo:RO_0001015 a owl:ObjectProperty ;
    owl:inverseOf [ owl:inverseOf uo:RO_0001015 ] .

