    core:isPortOf abox:TestOilPump_P02 .

abox:Spec_DesignFlow_K02 a prop:DesignFlowRateSpecification,
        owl:NamedIndividual,
        owl:Thing,
        iof-core:DesignSpecification ;
    rdfs:label "Design Flow Rate Specification"@en ;
    iof-core:hasContinuantPartAtAllTimes abox:Val_Flow_K02 ;
    iof-core:prescribes abox:LPCompressor_K02 .

abox:Spec_DesignFlow_P01 a prop:DesignFlowRateSpecification,
        owl:NamedIndividual,
        owl:Thing,
        iof-core:DesignSpecification ;
    rdfs:label "Design Volumetric Flow Rate"@en ;
    iof-core:hasContinuantPartAtAllTimes abox:Val_Flow_P01 ;
    iof-core:prescribes abox:SeawaterLiftPump_P01 .

abox:Spec_DesignPressure_E01 a prop:DesignPressureSpecification,
        owl:NamedIndividual,
        owl:Thing,
        iof-core:DesignSpecification ;
    rdfs:label "Design Pressure Specification"@en ;
    iof-core:hasContinuantPartAtAllTimes abox:Val_Pressure_E01 ;
    iof-core:prescribes abox:SeawaterCooler_E01 .

abox:Spec_DesignPressure_F01 a prop:DesignPressureSpecification,
