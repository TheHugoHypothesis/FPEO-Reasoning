@prefix : <http://usp.ai/ontologies/fpeo-collect-equipments-abox#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .

# Ontologias de Referência Externa
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix uo: <http://purl.obolibrary.org/obo/> .
@prefix o3po: <https://www.inf.ufrgs.br/ontologies/o3po#> .
@prefix iof-core: <https://spec.industrialontologies.org/ontology/core/Core/> .

# Core e Módulos FPEO
@prefix core: <http://usp.ai/ontologies/fpeo-equipments-core#> .
@prefix static: <http://usp.ai/ontologies/fpeo-static-equipments#> .
@prefix dynamical: <http://usp.ai/ontologies/fpeo-dynamical-equipments#> .
@prefix electrical: <http://usp.ai/ontologies/fpeo-electrical-equipments#> .
@prefix valve: <http://usp.ai/ontologies/fpeo-valves-security#> .
@prefix sensors: <http://usp.ai/ontologies/fpeo-sensors-equipments#> .
@prefix renewable: <http://usp.ai/ontologies/fpeo-renewable-equipments#> .
@prefix prop: <http://usp.ai/ontologies/fpeo-properties-equipments#> .
@prefix rules: <http://usp.ai/ontologies/fpeo-rules-equipments#> .

@base <http://usp.ai/ontologies/fpeo-collect-equipments-abox#> .

<http://usp.ai/ontologies/fpeo-collect-equipments-abox> rdf:type owl:Ontology ;
    owl:imports <http://usp.ai/ontologies/fpeo-rules-equipments> ;
    dc:creator "Hugo Cardoso Ferreira de Araújo" ;
    dc:description "Complete FPSO Topside Equipment ABox Assertion Model for FPEO Validation, fully instantiated with Realist Data Properties (IOF-Core & UO)"@en .


#################################################################
# 1. INSTÂNCIAS DE NAVIOS FPSO (o3po:FPSO)
#################################################################

### 1.1 FPSO P-78 Marechal Duque
:FPSO_P78 rdf:type owl:NamedIndividual , o3po:FPSO ;
    rdfs:label "FPSO P-78 Marechal Duque"@en ;
    rdfs:comment "Navio Plataforma FPSO P-78 alocado no Campo de Búzios, Pré-Sal da Bacia de Santos"@pt .

:Doc_FPSO_P78 rdf:type owl:NamedIndividual , prop:EquipmentDesignDocument ;
    rdfs:label "Datasheet Geral de Capacidade da Planta - FPSO P-78"@pt ;
    iof-core:describes :FPSO_P78 ;
    iof-core:hasContinuantPartAtAllTimes :Spec_OilCapacity_P78 , :Spec_GasCapacity_P78 .

:Spec_OilCapacity_P78 rdf:type owl:NamedIndividual , prop:DesignFlowRateSpecification ;
    rdfs:label "Capacidade Nominal de Processamento de Óleo"@pt ;
    iof-core:prescribes :FPSO_P78 ;
    iof-core:hasContinuantPartAtAllTimes :Val_OilCapacity_P78 .

:Val_OilCapacity_P78 rdf:type owl:NamedIndividual , prop:FlowRateValueExpression ;
    obo:IAO_0000039 uo:UO_0000099 ; # barrels per day / m3/h
    iof-core:hasSimpleExpressionValue "180000.0"^^xsd:double .

:Spec_GasCapacity_P78 rdf:type owl:NamedIndividual , prop:DesignFlowRateSpecification ;
    rdfs:label "Capacidade Nominal de Tratamento e Compressão de Gás"@pt ;
    iof-core:prescribes :FPSO_P78 ;
    iof-core:hasContinuantPartAtAllTimes :Val_GasCapacity_P78 .

:Val_GasCapacity_P78 rdf:type owl:NamedIndividual , prop:FlowRateValueExpression ;
    obo:IAO_0000099 uo:UO_0000099 ;
    iof-core:hasSimpleExpressionValue "7.2"^^xsd:double .


### 1.2 FPSO P-79 Guanabara
:FPSO_P79 rdf:type owl:NamedIndividual , o3po:FPSO ;
    rdfs:label "FPSO P-79 Guanabara"@en ;
    rdfs:comment "Navio Plataforma FPSO P-79 alocado na Bacia de Santos"@pt .


#################################################################
# 2. INSTÂNCIAS DE MÓDULOS TOPSIDE (core:FPSOModule)
#################################################################

### Módulos localizados no FPSO P-78 (obo:RO_0001025)
:Module_M01 rdf:type owl:NamedIndividual , core:FPSOModule ;
    rdfs:label "M-01 CO2 & Seawater Module"@en ;
    rdfs:comment "Módulo M-01: Captação de Água do Mar, Resfriamento e Compressão de CO2"@pt ;
    obo:RO_0001025 :FPSO_P78 ;
    core:isLocatedInFPSO :FPSO_P78 .

:Module_M02 rdf:type owl:NamedIndividual , core:FPSOModule ;
    rdfs:label "M-02 Flare & VRU System"@en ;
    rdfs:comment "Módulo M-02: Sistema de Flare e Recuperação de Vapores (VRU)"@pt ;
    obo:RO_0001025 :FPSO_P78 ;
    core:isLocatedInFPSO :FPSO_P78 .

### Módulos localizados no FPSO P-79 (obo:RO_0001025)
:Module_M06 rdf:type owl:NamedIndividual , core:FPSOModule ;
    rdfs:label "M-06 Main Gas Compression & Power"@en ;
    rdfs:comment "Módulo M-06: Compressão Principal de Gás e Geração de Energia"@pt ;
    obo:RO_0001025 :FPSO_P79 ;
    core:isLocatedInFPSO :FPSO_P79 .

:Module_M08 rdf:type owl:NamedIndividual , core:FPSOModule ;
    rdfs:label "M-08 Oil Processing Module"@en ;
    rdfs:comment "Módulo M-08: Separação, Aquecimento e Tratamento Eletrostático de Petróleo"@pt ;
    obo:RO_0001025 :FPSO_P79 ;
    core:isLocatedInFPSO :FPSO_P79 .


#################################################################
# 3. SUBSISTEMA DE CAPTAÇÃO E REFRIGERAÇÃO DE ÁGUA DO MAR (SEAWATER)
#################################################################

### 3.1 Bomba de Elevação de Água do Mar (P-01)
:SeawaterLiftPump_P01 rdf:type owl:NamedIndividual , dynamical:SeawaterLiftPump ;
    rdfs:label "P-01 Seawater Lift Pump"@en ;
    core:isLocatedInModule :Module_M01 ;
    core:hasPort :P01_Port_Out , :P01_Port_Elec .

:P01_Port_Out rdf:type owl:NamedIndividual , core:OutletPort ;
    core:isPortOf :SeawaterLiftPump_P01 ;
    core:portConnectedTo :F01_Port_In .

:P01_Port_Elec rdf:type owl:NamedIndividual , core:ElectricalPort ;
    core:isPortOf :SeawaterLiftPump_P01 .

