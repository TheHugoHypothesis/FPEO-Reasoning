    rdfs:label "Datasheet Técnico - Bomba P-01"@pt ;
    iof-core:describes :SeawaterLiftPump_P01 ;
    iof-core:hasContinuantPartAtAllTimes :Tag_P01 , :Spec_RatedPower_P01 , :Spec_DesignPressure_P01 , :Spec_DesignFlow_P01 .

:Tag_P01 rdf:type owl:NamedIndividual , prop:EquipmentTagIdentifier ;
    iof-core:identifies :SeawaterLiftPump_P01 ;
    iof-core:hasSimpleExpressionValue "P-01" .

:Spec_RatedPower_P01 rdf:type owl:NamedIndividual , prop:RatedPowerSpecification ;
    rdfs:label "Rated Power Specification"@en ;
    iof-core:prescribes :SeawaterLiftPump_P01 ;
    iof-core:hasContinuantPartAtAllTimes :Val_Power_P01 .

:Val_Power_P01 rdf:type owl:NamedIndividual , prop:PowerValueExpression ;
    obo:IAO_0000039 uo:UO_0000036 ; # kilowatt (UO)
    iof-core:hasSimpleExpressionValue "3200.0"^^xsd:double .

:Spec_DesignPressure_P01 rdf:type owl:NamedIndividual , prop:DesignPressureSpecification ;
    rdfs:label "Design Discharge Pressure"@en ;
    iof-core:prescribes :SeawaterLiftPump_P01 ;
    iof-core:hasContinuantPartAtAllTimes :Val_Pressure_P01 .

:Val_Pressure_P01 rdf:type owl:NamedIndividual , prop:PressureValueExpression ;
    obo:IAO_0000039 uo:UO_0000062 ; # bar (UO)
    iof-core:hasSimpleExpressionValue "180.0"^^xsd:double .

:Spec_DesignFlow_P01 rdf:type owl:NamedIndividual , prop:DesignFlowRateSpecification ;
    rdfs:label "Design Volumetric Flow Rate"@en ;
    iof-core:prescribes :SeawaterLiftPump_P01 ;
    iof-core:hasContinuantPartAtAllTimes :Val_Flow_P01 .

:Val_Flow_P01 rdf:type owl:NamedIndividual , prop:FlowRateValueExpression ;
    obo:IAO_0000039 uo:UO_0000099 ; # m3/h (UO)
    iof-core:hasSimpleExpressionValue "2400.0"^^xsd:double .


