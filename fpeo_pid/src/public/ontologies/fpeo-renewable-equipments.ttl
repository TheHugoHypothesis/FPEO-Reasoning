@prefix : <http://usp.ai/ontologies/fpeo-renewable-equipments#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix core: <http://usp.ai/ontologies/fpeo-equipments-core#> .

@base <http://usp.ai/ontologies/fpeo-renewable-equipments#> .

<http://usp.ai/ontologies/fpeo-renewable-equipments> rdf:type owl:Ontology ;
    owl:imports <http://usp.ai/ontologies/fpeo-equipments-core> ;
    dc:creator "Hugo Cardoso Ferreira de Araújo" ;
    dc:description "Renewable Equipments Module for FPEO-Equipments Ontology"@en .


#################################################################
#    1. Abstrações Intermediárias de Equipamentos Renováveis
#################################################################

:RenewablePowerGenerationEquipment rdf:type owl:Class ;
    rdfs:subClassOf core:RenewableEquipment ;
    rdfs:label "Renewable Power Generation Equipment"@en , "Equipamento de Geração Renovável de Energia"@pt ;
    skos:definition "A physical artifact engineered to capture ambient renewable energy (solar, wind) and convert it into electrical power."@en .

:RenewablePowerConversionEquipment rdf:type owl:Class ;
    rdfs:subClassOf core:RenewableEquipment ;
    rdfs:label "Renewable Power Conversion Equipment"@en , "Equipamento de Conversão de Energia Renovável"@pt ;
    skos:definition "Power electronics equipment designed to condition, invert, or transform electrical power generated by renewable sources for integration into the topside grid."@en .


#################################################################
#    2. Equipamentos Concretos: Geração Renovável (RenewablePowerGenerationEquipment)
#################################################################

:SolarPanel rdf:type owl:Class ;
    rdfs:subClassOf :RenewablePowerGenerationEquipment ;
    rdfs:label "Solar PV Panel"@en , "Painel Solar Fotovoltaico"@pt ;
    skos:altLabel "Solar PV Module"@en , "Módulo Solar Fotovoltaico"@pt ;
    skos:definition "Assembly of photovoltaic cells that converts solar irradiance directly into direct current (DC) electrical power."@en ;
    rdfs:isDefinedBy "IEC 61215 / IEC 61730" .

:WindTurbine rdf:type owl:Class ;
    rdfs:subClassOf :RenewablePowerGenerationEquipment ;
    rdfs:label "Offshore Wind Turbine Generator"@en , "Turbina Eólica Offshore"@pt ;
    skos:definition "A rotary device that converts the kinetic energy of wind into mechanical energy and then into electrical power."@en ;
    rdfs:isDefinedBy "IEC 61400" .


#################################################################
#    3. Equipamentos Concretos: Conversão e Inversores (RenewablePowerConversionEquipment)
#################################################################

:SolarInverter rdf:type owl:Class ;
    rdfs:subClassOf :RenewablePowerConversionEquipment ;
    rdfs:label "Solar Photovoltaic Inverter"@en , "Inversor Solar Fotovoltaico"@pt ;
    skos:definition "A power converter that transforms variable direct current (DC) output from solar panels into utility-frequency alternating current (AC)."@en ;
    rdfs:isDefinedBy "IEC 62109" .

:WindPowerConverter rdf:type owl:Class ;
    rdfs:subClassOf :RenewablePowerConversionEquipment ;
    rdfs:label "Wind Turbine Power Converter"@en , "Conversor de Potência para Turbina Eólica"@pt ;
    skos:definition "An AC-DC-AC power electronic converter used to synchronize variable-frequency power from wind generators with the main platform grid."@en ;
    rdfs:isDefinedBy "IEC 61400-21 / IEC 62477" .
