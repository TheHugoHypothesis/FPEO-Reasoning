'use client';

import React, { createContext, useContext, useState, useEffect, useCallback } from 'react';
import {
  OntologyGraph,
  Equipment,
  AuditResult,
  AppSettings,
  CreateEquipmentPayload,
  CreatePortPayload,
  PortType,
  EquipmentPort,
  EquipmentComponent,
  PortConnection,
  FpsoModule,
} from '@/lib/types';
import { parseTurtleContent, generateTurtleFromGraph } from '@/lib/rdfParser';
import { runSemanticAudit } from '@/lib/auditClient';
import { NAMESPACES, getShortUri } from '@/lib/namespaces';

const DEFAULT_SETTINGS: AppSettings = {
  ollamaUrl: 'http://localhost:11434',
  ollamaModel: 'llama3:latest',
  backendUrl: 'http://localhost:8000',
  autoAuditOnLoad: false,
};

export const DEFAULT_FPSO_MODULES: FpsoModule[] = [
  { id: 'M-01', uri: 'http://usp.ai/ontologies/fpeo-equipments-core#Module_M01', code: 'M-01', title: 'CO2 Compression', description: 'Compressão e Injeção de CO2 em Alta Pressão', isDefault: true },
  { id: 'M-02', uri: 'http://usp.ai/ontologies/fpeo-equipments-core#Module_M02', code: 'M-02', title: 'Flare & VRU System', description: 'Sistema de Flare e Recuperação de Vapores (VRU)', isDefault: true },
  { id: 'M-03', uri: 'http://usp.ai/ontologies/fpeo-equipments-core#Module_M03', code: 'M-03', title: 'CO2 Removal and HCDP', description: 'Remoção de CO2 e Ajuste do Ponto de Orvalho (HCDP)', isDefault: true },
  { id: 'M-04', uri: 'http://usp.ai/ontologies/fpeo-equipments-core#Module_M04', code: 'M-04', title: 'Exportation Gas Compression', description: 'Compressão Principal de Gás para Exportação', isDefault: true },
  { id: 'M-05', uri: 'http://usp.ai/ontologies/fpeo-equipments-core#Module_M05', code: 'M-05', title: 'Dehydration System & Fuel Gas', description: 'Desidratação de Gás por TEG e Gás de Combustível', isDefault: true },
  { id: 'M-06', uri: 'http://usp.ai/ontologies/fpeo-equipments-core#Module_M06', code: 'M-06', title: 'Main Gas Compression & VRU System', description: 'Compressão Principal e VRU de Média Pressão', isDefault: true },
  { id: 'M-07', uri: 'http://usp.ai/ontologies/fpeo-equipments-core#Module_M07', code: 'M-07', title: 'Gas Injection', description: 'Compressão e Injeção de Gás de Alta Pressão', isDefault: true },
  { id: 'M-08', uri: 'http://usp.ai/ontologies/fpeo-equipments-core#Module_M08', code: 'M-08', title: 'Oil Processing', description: 'Processamento de Óleo e Separação Primária', isDefault: true },
  { id: 'M-09', uri: 'http://usp.ai/ontologies/fpeo-equipments-core#Module_M09', code: 'M-09', title: 'Pig Launcher & Manifold', description: 'Manifold de Produção e Lançadores/Recebedores de PIG', isDefault: true },
];

interface OntologyContextType {
  graph: OntologyGraph | null;
  activeGraph: OntologyGraph | null; // Filtered for current FPSO module
  rawFiles: { name: string; content: string }[];
  modules: FpsoModule[];
  activeModuleId: string;
  setActiveModuleId: (id: string) => void;
  createModule: (code: string, title: string, description?: string) => void;
  deleteModule: (id: string) => void;
  changeEquipmentModule: (equipmentUri: string, targetModuleUri: string) => void;
  drilldownEquipment: Equipment | null;
  setDrilldownEquipment: (equipment: Equipment | null) => void;
  selectedEquipment: Equipment | null;
  auditResult: AuditResult | null;
  isAuditing: boolean;
  isPreloading: boolean;
  settings: AppSettings;
  isSettingsOpen: boolean;
  setIsSettingsOpen: (open: boolean) => void;
  setGraphAndFiles: (graph: OntologyGraph, files: { name: string; content: string }[]) => void;
  setSelectedEquipment: (equipment: Equipment | null) => void;
  updateSettings: (newSettings: AppSettings) => void;
  executeAudit: () => Promise<void>;
  preloadScenario: (scenario: 'abox' | 'abox2') => Promise<void>;
  addEquipmentNode: (payload: CreateEquipmentPayload) => void;
  addPortToEquipment: (payload: CreatePortPayload) => void;
  removePortFromEquipment: (equipmentUri: string, portUri: string) => void;
  addConnection: (
    sourceEquipmentUri: string,
    sourcePortUri: string,
    targetEquipmentUri: string,
    targetPortUri: string
  ) => void;
  addComponentToEquipment: (equipmentUri: string, componentLabel: string, componentClassUri?: string) => void;
}

const OntologyContext = createContext<OntologyContextType | undefined>(undefined);

export function OntologyProvider({ children }: { children: React.ReactNode }) {
  const [graph, setGraph] = useState<OntologyGraph | null>(null);
  const [rawFiles, setRawFiles] = useState<{ name: string; content: string }[]>([]);
  const [modules, setModules] = useState<FpsoModule[]>(DEFAULT_FPSO_MODULES);
  const [activeModuleId, setActiveModuleId] = useState<string>('M-01');
  const [selectedEquipment, setSelectedEquipment] = useState<Equipment | null>(null);
  const [drilldownEquipment, setDrilldownEquipment] = useState<Equipment | null>(null);
  const [auditResult, setAuditResult] = useState<AuditResult | null>(null);
  const [isAuditing, setIsAuditing] = useState(false);
  const [isPreloading, setIsPreloading] = useState(true);
  const [settings, setSettings] = useState<AppSettings>(DEFAULT_SETTINGS);
  const [isSettingsOpen, setIsSettingsOpen] = useState(false);

  // Sync updated graph with raw TTL files for HermiT backend audits
  const syncGraphWithFiles = useCallback((updatedGraph: OntologyGraph) => {
    const generatedTtl = generateTurtleFromGraph(updatedGraph);
    setRawFiles(prev => {
      const remaining = prev.filter(f => !f.name.includes('abox'));
      return [...remaining, { name: 'fpeo-dynamic-abox.ttl', content: generatedTtl }];
    });
  }, []);

  // Automatic distribution of equipments to FPSO modules using inFPSOModule
  const distributeEquipmentsToModules = useCallback((equipments: Equipment[]): Equipment[] => {
    return equipments.map((eq, index) => {
      if (eq.moduleCode) return eq;

      let targetMod = DEFAULT_FPSO_MODULES[0]; // M-01
      const cat = eq.category;
      const lbl = eq.label.toLowerCase();

      if (cat === 'CompressorEquipment' || lbl.includes('compressor')) {
        if (lbl.includes('co2')) targetMod = DEFAULT_FPSO_MODULES[0];
        else if (lbl.includes('export')) targetMod = DEFAULT_FPSO_MODULES[3];
        else if (lbl.includes('injec')) targetMod = DEFAULT_FPSO_MODULES[6];
        else targetMod = DEFAULT_FPSO_MODULES[5];
      } else if (cat === 'ValveAndSecurityEquipment' || lbl.includes('flare') || lbl.includes('vru')) {
        targetMod = DEFAULT_FPSO_MODULES[1];
      } else if (cat === 'SeparationAndFilterEquipment' || lbl.includes('dew point') || lbl.includes('hcdp')) {
        targetMod = DEFAULT_FPSO_MODULES[2];
      } else if (lbl.includes('teg') || lbl.includes('fuel') || lbl.includes('dehydrat')) {
        targetMod = DEFAULT_FPSO_MODULES[4];
      } else if (cat === 'PumpEquipment' || cat === 'PressureVesselEquipment' || lbl.includes('oil') || lbl.includes('desalter')) {
        targetMod = DEFAULT_FPSO_MODULES[7];
      } else if (lbl.includes('pig') || lbl.includes('manifold')) {
        targetMod = DEFAULT_FPSO_MODULES[8];
      } else {
        targetMod = DEFAULT_FPSO_MODULES[index % DEFAULT_FPSO_MODULES.length];
      }

      return {
        ...eq,
        moduleUri: targetMod.uri,
        moduleCode: targetMod.code,
        triples: [
          ...eq.triples.filter(t => t.predicate !== 'core:inFPSOModule' && t.predicate !== 'inFPSOModule'),
          { subject: eq.shortUri, predicate: 'core:inFPSOModule', object: targetMod.code },
        ],
      };
    });
  }, []);

  // Preload default ontologies on app start
  const preloadDefaultOntologies = useCallback(async (aboxFileName: string = 'fpeo-collect-equipments-abox.ttl') => {
    setIsPreloading(true);
    try {
      const filesToLoad = [
        'fpeo-equipments-core.ttl',
        'fpeo-static-equipments.ttl',
        'fpeo-dynamical-equipments.ttl',
        'fpeo-electrical-equipments.ttl',
        'fpeo-valves-security.ttl',
        'fpeo-renewable-equipments.ttl',
        aboxFileName,
      ];

      const fileFetchPromises = filesToLoad.map(async (filename) => {
        const res = await fetch(`/ontologies/${filename}`);
        if (!res.ok) throw new Error(`Failed to fetch /ontologies/${filename}`);
        const content = await res.text();
        return { name: filename, content };
      });

      const loadedRaw = await Promise.all(fileFetchPromises);
      setRawFiles(loadedRaw);

      const parsedGraph = await parseTurtleContent(
        loadedRaw.map(f => f.content),
        loadedRaw.map(f => f.name)
      );

      const distributedEquipments = distributeEquipmentsToModules(parsedGraph.equipments);
      const updatedGraph = { ...parsedGraph, equipments: distributedEquipments };

      setGraph(updatedGraph);
    } catch (e) {
      console.error('Error preloading ontologies:', e);
    } finally {
      setIsPreloading(false);
    }
  }, [distributeEquipmentsToModules]);

  useEffect(() => {
    preloadDefaultOntologies();
  }, [preloadDefaultOntologies]);

  const setGraphAndFiles = (newGraph: OntologyGraph, files: { name: string; content: string }[]) => {
    const distributed = distributeEquipmentsToModules(newGraph.equipments);
    const updatedGraph = { ...newGraph, equipments: distributed };
    setGraph(updatedGraph);
    setRawFiles(files);
    setAuditResult(null);
  };

  const updateSettings = (newSettings: AppSettings) => {
    setSettings(newSettings);
  };

  // FPSO Module Management Functions
  const createModule = (code: string, title: string, description?: string) => {
    const cleanCode = code.toUpperCase().trim();
    const modUri = `http://usp.ai/ontologies/fpeo-equipments-core#Module_${cleanCode.replace(/[^a-zA-Z0-9]/g, '')}`;
    const newModule: FpsoModule = {
      id: cleanCode,
      uri: modUri,
      code: cleanCode,
      title: title.trim(),
      description: description?.trim(),
      isDefault: false,
    };
    setModules(prev => [...prev, newModule]);
    setActiveModuleId(cleanCode);
  };

  const deleteModule = (id: string) => {
    setModules(prev => {
      const remaining = prev.filter(m => m.id !== id && m.code !== id);
      if (activeModuleId === id && remaining.length > 0) {
        setActiveModuleId(remaining[0].id);
      }
      return remaining;
    });
  };

  const changeEquipmentModule = (equipmentUri: string, targetModuleUri: string) => {
    if (!graph) return;

    const isUnassigning = targetModuleUri === 'NONE' || targetModuleUri === '';
    const targetModule = isUnassigning
      ? null
      : modules.find(m => m.uri === targetModuleUri || m.id === targetModuleUri || m.code === targetModuleUri);

    const updatedEquipments = graph.equipments.map(eq => {
      if (eq.uri === equipmentUri) {
        const existingTriples = eq.triples.filter(t => t.predicate !== 'core:inFPSOModule' && t.predicate !== 'inFPSOModule');

        if (isUnassigning || !targetModule) {
          return {
            ...eq,
            moduleUri: undefined,
            moduleCode: undefined,
            triples: existingTriples,
          };
        }

        const newTriple = {
          subject: eq.shortUri,
          predicate: 'core:inFPSOModule',
          object: targetModule.code,
        };

        return {
          ...eq,
          moduleUri: targetModule.uri,
          moduleCode: targetModule.code,
          triples: [...existingTriples, newTriple],
        };
      }
      return eq;
    });

    const updatedGraph = { ...graph, equipments: updatedEquipments };
    setGraph(updatedGraph);
    if (selectedEquipment?.uri === equipmentUri) {
      const updatedEq = updatedEquipments.find(e => e.uri === equipmentUri) || null;
      setSelectedEquipment(updatedEq);
    }
    syncGraphWithFiles(updatedGraph);
  };

  const executeAudit = async () => {
    if (!rawFiles || rawFiles.length === 0) return;
    setIsAuditing(true);
    try {
      const contents = rawFiles.map(f => f.content);
      const result = await runSemanticAudit(contents, settings);
      setAuditResult(result);
    } catch (e) {
      console.error('Audit execution error:', e);
    } finally {
      setIsAuditing(false);
    }
  };

  const preloadScenario = async (scenario: 'abox' | 'abox2') => {
    const filename = scenario === 'abox2' ? 'fpeo-collect-equipments-abox2.ttl' : 'fpeo-collect-equipments-abox.ttl';
    await preloadDefaultOntologies(filename);
    setAuditResult(null);
  };

  // MUTATOR 1: Add new equipment dynamically to active module
  const addEquipmentNode = (payload: CreateEquipmentPayload) => {
    if (!graph) return;
    const cleanId = (payload.shortUri || payload.label)
      .replace(/[^a-zA-Z0-9_]/g, '_')
      .replace(/^_+|_+$/g, '');

    const eqUri = `http://usp.ai/ontologies/fpeo-collect-equipments-abox#${cleanId}_${Date.now()}`;
    const shortUri = `abox:${cleanId}_${Date.now()}`;
    const classLabel = getShortUri(payload.classUri);

    // Build ports
    const createdPorts: EquipmentPort[] = payload.ports.map((p, idx) => {
      const pId = `${cleanId}_Port_${p.type}_${idx + 1}_${Date.now()}`;
      return {
        uri: `http://usp.ai/ontologies/fpeo-collect-equipments-abox#${pId}`,
        shortUri: `abox:${pId}`,
        type: p.type,
        label: p.label || `${p.type} ${idx + 1}`,
        equipmentUri: eqUri,
      };
    });

    // Build components
    const createdComponents: EquipmentComponent[] = (payload.components || []).map((c, idx) => {
      const cId = `Comp_${cleanId}_${idx + 1}_${Date.now()}`;
      return {
        uri: `http://usp.ai/ontologies/fpeo-collect-equipments-abox#${cId}`,
        shortUri: `abox:${cId}`,
        label: c.label,
        predicate: 'o3po:hasComponent',
        typeUri: c.classUri,
        typeLabel: c.classUri ? getShortUri(c.classUri) : undefined,
        source: 'instance',
      };
    });

    let targetModuleUri: string | undefined;
    let targetModuleCode: string | undefined;

    if (payload.moduleCode === 'NONE' || payload.moduleCode === '') {
      targetModuleUri = undefined;
      targetModuleCode = undefined;
    } else if (payload.moduleCode) {
      const matchedMod = modules.find(m => m.code === payload.moduleCode || m.id === payload.moduleCode);
      targetModuleCode = payload.moduleCode;
      targetModuleUri = matchedMod?.uri || `http://usp.ai/ontologies/fpeo-topside-module#${payload.moduleCode}`;
    } else {
      const activeMod = modules.find(m => m.id === activeModuleId || m.code === activeModuleId);
      if (activeMod && activeModuleId !== 'ALL') {
        targetModuleUri = activeMod.uri;
        targetModuleCode = activeMod.code;
      }
    }

    const newEquipment: Equipment = {
      uri: eqUri,
      shortUri,
      label: payload.label,
      classUri: payload.classUri,
      classLabel,
      category: payload.category || 'GenericEquipment',
      ports: createdPorts,
      moduleUri: targetModuleUri,
      moduleCode: targetModuleCode,
      triples: [
        { subject: shortUri, predicate: 'rdf:type', object: classLabel },
        { subject: shortUri, predicate: 'rdfs:label', object: `"${payload.label}"@en` },
        ...(targetModuleCode ? [{ subject: shortUri, predicate: 'core:inFPSOModule', object: targetModuleCode }] : []),
      ],
      components: createdComponents,
    };

    const updatedGraph: OntologyGraph = {
      ...graph,
      equipments: [...graph.equipments, newEquipment],
    };

    setGraph(updatedGraph);
    setSelectedEquipment(newEquipment);
    syncGraphWithFiles(updatedGraph);
  };

  // MUTATOR 2: Add dynamic port to an existing equipment
  const addPortToEquipment = (payload: CreatePortPayload) => {
    if (!graph) return;
    const targetEq = graph.equipments.find(e => e.uri === payload.equipmentUri);
    if (!targetEq) return;

    const pId = `${targetEq.label.replace(/[^a-zA-Z0-9_]/g, '_')}_${payload.type}_${Date.now()}`;
    const newPort: EquipmentPort = {
      uri: `http://usp.ai/ontologies/fpeo-collect-equipments-abox#${pId}`,
      shortUri: `abox:${pId}`,
      type: payload.type,
      label: payload.label,
      equipmentUri: targetEq.uri,
    };

    const updatedEquipments = graph.equipments.map(eq => {
      if (eq.uri === payload.equipmentUri) {
        return {
          ...eq,
          ports: [...eq.ports, newPort],
        };
      }
      return eq;
    });

    const updatedGraph = { ...graph, equipments: updatedEquipments };
    setGraph(updatedGraph);

    if (selectedEquipment?.uri === targetEq.uri) {
      setSelectedEquipment(updatedEquipments.find(e => e.uri === targetEq.uri) || null);
    }

    syncGraphWithFiles(updatedGraph);
  };

  // MUTATOR 3: Remove port from equipment
  const removePortFromEquipment = (equipmentUri: string, portUri: string) => {
    if (!graph) return;
    const updatedEquipments = graph.equipments.map(eq => {
      if (eq.uri === equipmentUri) {
        return {
          ...eq,
          ports: eq.ports.filter(p => p.uri !== portUri),
        };
      }
      return eq;
    });

    const updatedConnections = graph.connections.filter(
      c => c.sourcePortUri !== portUri && c.targetPortUri !== portUri
    );

    const updatedGraph = {
      ...graph,
      equipments: updatedEquipments,
      connections: updatedConnections,
    };

    setGraph(updatedGraph);

    if (selectedEquipment?.uri === equipmentUri) {
      setSelectedEquipment(updatedEquipments.find(e => e.uri === equipmentUri) || null);
    }

    syncGraphWithFiles(updatedGraph);
  };

  // MUTATOR 4: Connect two ports
  const addConnection = (
    sourceEquipmentUri: string,
    sourcePortUri: string,
    targetEquipmentUri: string,
    targetPortUri: string
  ) => {
    if (!graph) return;
    const newConnection: PortConnection = {
      id: `conn_${Date.now()}`,
      sourceEquipmentUri,
      sourcePortUri,
      targetEquipmentUri,
      targetPortUri,
      connectionType: 'portConnectedTo',
    };

    const updatedGraph = {
      ...graph,
      connections: [...graph.connections, newConnection],
    };

    setGraph(updatedGraph);
    syncGraphWithFiles(updatedGraph);
  };

  // MUTATOR 5: Add a component to an equipment
  const addComponentToEquipment = (equipmentUri: string, componentLabel: string, componentClassUri?: string) => {
    if (!graph) return;
    const targetEq = graph.equipments.find(e => e.uri === equipmentUri);
    if (!targetEq) return;

    const cId = `Comp_${targetEq.label.replace(/[^a-zA-Z0-9_]/g, '_')}_${Date.now()}`;
    const newComp: EquipmentComponent = {
      uri: `http://usp.ai/ontologies/fpeo-collect-equipments-abox#${cId}`,
      shortUri: `abox:${cId}`,
      label: componentLabel,
      predicate: 'o3po:hasComponent',
      typeUri: componentClassUri,
      typeLabel: componentClassUri ? getShortUri(componentClassUri) : undefined,
      source: 'instance',
    };

    const updatedEquipments = graph.equipments.map(eq => {
      if (eq.uri === equipmentUri) {
        return {
          ...eq,
          components: [...(eq.components || []), newComp],
        };
      }
      return eq;
    });

    const updatedGraph = { ...graph, equipments: updatedEquipments };
    setGraph(updatedGraph);

    if (selectedEquipment?.uri === equipmentUri) {
      setSelectedEquipment(updatedEquipments.find(e => e.uri === equipmentUri) || null);
    }

    syncGraphWithFiles(updatedGraph);
  };

  // Compute active filtered graph for current active FPSO module
  const activeGraph: OntologyGraph | null = graph
    ? activeModuleId === 'ALL'
      ? graph
      : {
          ...graph,
          equipments: graph.equipments.filter(e => e.moduleCode === activeModuleId || e.moduleUri?.endsWith(activeModuleId)),
        }
    : null;

  return (
    <OntologyContext.Provider
      value={{
        graph,
        activeGraph,
        rawFiles,
        modules,
        activeModuleId,
        setActiveModuleId,
        createModule,
        deleteModule,
        changeEquipmentModule,
        drilldownEquipment,
        setDrilldownEquipment,
        selectedEquipment,
        auditResult,
        isAuditing,
        isPreloading,
        settings,
        isSettingsOpen,
        setIsSettingsOpen,
        setGraphAndFiles,
        setSelectedEquipment,
        updateSettings,
        executeAudit,
        preloadScenario,
        addEquipmentNode,
        addPortToEquipment,
        removePortFromEquipment,
        addConnection,
        addComponentToEquipment,
      }}
    >
      {children}
    </OntologyContext.Provider>
  );
}

export function useOntology() {
  const context = useContext(OntologyContext);
  if (!context) {
    throw new Error('useOntology must be used within an OntologyProvider');
  }
  return context;
}
