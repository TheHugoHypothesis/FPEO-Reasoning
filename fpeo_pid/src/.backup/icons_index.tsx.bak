import React from 'react';
import { EquipmentCategory } from '@/lib/types';

export function CompressorIcon({ className = "w-6 h-6" }: { className?: string }) {
  return (
    <svg viewBox="0 0 48 48" fill="none" className={className} stroke="currentColor" strokeWidth="2.5">
      <circle cx="24" cy="24" r="18" className="stroke-cyan-400 fill-cyan-950/40" />
      <polygon points="16,14 36,24 16,34" className="fill-cyan-400/30 stroke-cyan-400" />
      <line x1="24" y1="6" x2="24" y2="42" strokeDasharray="2 2" className="stroke-cyan-500/60" />
    </svg>
  );
}

export function PumpIcon({ className = "w-6 h-6" }: { className?: string }) {
  return (
    <svg viewBox="0 0 48 48" fill="none" className={className} stroke="currentColor" strokeWidth="2.5">
      <circle cx="22" cy="24" r="16" className="stroke-cyan-400 fill-cyan-950/40" />
      <polygon points="22,12 36,12 36,36 22,36" className="fill-cyan-500/20 stroke-cyan-400" />
      <line x1="6" y1="24" x2="38" y2="24" className="stroke-cyan-300" />
    </svg>
  );
}

export function VesselIcon({ className = "w-6 h-6" }: { className?: string }) {
  return (
    <svg viewBox="0 0 48 48" fill="none" className={className} stroke="currentColor" strokeWidth="2.5">
      <rect x="14" y="8" width="20" height="32" rx="10" className="stroke-emerald-400 fill-emerald-950/40" />
      <line x1="14" y1="18" x2="34" y2="18" className="stroke-emerald-500/60" />
      <line x1="14" y1="30" x2="34" y2="30" className="stroke-emerald-500/60" />
    </svg>
  );
}

export function ExchangerIcon({ className = "w-6 h-6" }: { className?: string }) {
  return (
    <svg viewBox="0 0 48 48" fill="none" className={className} stroke="currentColor" strokeWidth="2.5">
      <circle cx="24" cy="24" r="18" className="stroke-orange-400 fill-orange-950/40" />
      <path d="M10 24 C14 16, 20 16, 24 24 C28 32, 34 32, 38 24" className="stroke-orange-300 stroke-[3]" />
      <line x1="6" y1="24" x2="10" y2="24" className="stroke-orange-400" />
      <line x1="38" y1="24" x2="42" y2="24" className="stroke-orange-400" />
    </svg>
  );
}

export function ValveIcon({ className = "w-6 h-6" }: { className?: string }) {
  return (
    <svg viewBox="0 0 48 48" fill="none" className={className} stroke="currentColor" strokeWidth="2.5">
      <polygon points="10,12 24,24 10,36" className="stroke-red-400 fill-red-950/40" />
      <polygon points="38,12 24,24 38,36" className="stroke-red-400 fill-red-950/40" />
      <line x1="24" y1="24" x2="24" y2="10" className="stroke-red-300" />
      <line x1="18" y1="10" x2="30" y2="10" className="stroke-red-300" />
    </svg>
  );
}

export function FilterIcon({ className = "w-6 h-6" }: { className?: string }) {
  return (
    <svg viewBox="0 0 48 48" fill="none" className={className} stroke="currentColor" strokeWidth="2.5">
      <polygon points="24,6 42,24 24,42 6,24" className="stroke-purple-400 fill-purple-950/40" />
      <line x1="6" y1="24" x2="42" y2="24" strokeDasharray="3 3" className="stroke-purple-300" />
      <line x1="24" y1="6" x2="24" y2="42" strokeDasharray="3 3" className="stroke-purple-300" />
    </svg>
  );
}

export function TurbineIcon({ className = "w-6 h-6" }: { className?: string }) {
  return (
    <svg viewBox="0 0 48 48" fill="none" className={className} stroke="currentColor" strokeWidth="2.5">
      <polygon points="10,14 38,8 38,40 10,34" className="stroke-amber-400 fill-amber-950/40" />
      <line x1="4" y1="24" x2="44" y2="24" strokeDasharray="4 2" className="stroke-amber-300" />
    </svg>
  );
}

export function ElectricalIcon({ className = "w-6 h-6" }: { className?: string }) {
  return (
    <svg viewBox="0 0 48 48" fill="none" className={className} stroke="currentColor" strokeWidth="2.5">
      <rect x="8" y="10" width="32" height="28" rx="4" className="stroke-yellow-400 fill-yellow-950/40" />
      <path d="M26 14 L18 26 L24 26 L22 34 L30 22 L24 22 Z" className="fill-yellow-400 stroke-yellow-300" />
    </svg>
  );
}

export function TankIcon({ className = "w-6 h-6" }: { className?: string }) {
  return (
    <svg viewBox="0 0 48 48" fill="none" className={className} stroke="currentColor" strokeWidth="2.5">
      <path d="M10 16 L24 8 L38 16 L38 38 L10 38 Z" className="stroke-slate-400 fill-slate-950/40" />
      <line x1="10" y1="24" x2="38" y2="24" className="stroke-slate-500/60" />
    </svg>
  );
}

export function CategoryIcon({ category, className = "w-6 h-6" }: { category: EquipmentCategory; className?: string }) {
  switch (category) {
    case 'CompressorEquipment': return <CompressorIcon className={className} />;
    case 'PumpEquipment': return <PumpIcon className={className} />;
    case 'GasTurbineEquipment': return <TurbineIcon className={className} />;
    case 'PressureVesselEquipment': return <VesselIcon className={className} />;
    case 'HeatExchangeEquipment': return <ExchangerIcon className={className} />;
    case 'SeparationAndFilterEquipment': return <FilterIcon className={className} />;
    case 'StorageAndPipingHeaderEquipment': return <TankIcon className={className} />;
    case 'ValveAndSecurityEquipment': return <ValveIcon className={className} />;
    case 'ElectricalEquipment': return <ElectricalIcon className={className} />;
    case 'RenewableEquipment': return <ElectricalIcon className={className} />;
    default: return <VesselIcon className={className} />;
  }
}
