<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:owl="http://www.w3.org/2002/07/owl#"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
>
  <rdf:Description rdf:about="http://www.usp.ai/Ontologies/FPEO/MeasurementTemporalModule">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <rdfs:label xml:lang="en">FPEO Measurement and Temporal Module</rdfs:label>
    <rdfs:comment xml:lang="en">FPEO V5 candidate generated 2026-08-21. This ontology is part of the JSON-compatible, BFO-2020-aligned test architecture and is not the immutable production baseline.</rdfs:comment>
    <owl:versionIRI rdf:resource="http://www.usp.ai/Ontologies/FPEO/MeasurementTemporalModule/versions/2026-08-21"/>
    <owl:imports rdf:resource="http://purl.obolibrary.org/obo/bfo/2020/bfo.owl"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.usp.ai/Ontologies/FPEO/MeasurementTemporalModule#hasEndDate">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">has end date</rdfs:label>
    <rdfs:comment xml:lang="en">What it is: Exclusive calendar end date of a temporal interval specification. BFO/IOF placement: literal-bearing information attribute. Why it is here: Provides reusable JSON-compatible measurement/temporal projection semantics.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.usp.ai/Ontologies/FPEO/MeasurementTemporalModule#MeasurementValue">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Measurement value</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000031"/>
    <rdfs:comment xml:lang="en">What it is: An information content entity that records a numeric measurement together with a unit. BFO/IOF placement: generically dependent continuant. Why it is here: Centralizes reusable numeric/unit semantics required by power, emission, and temporal scenario projections.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.usp.ai/Ontologies/FPEO/MeasurementTemporalModule#hasStartDate">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">has start date</rdfs:label>
    <rdfs:comment xml:lang="en">What it is: Inclusive calendar start date of a temporal interval specification. BFO/IOF placement: literal-bearing information attribute. Why it is here: Provides reusable JSON-compatible measurement/temporal projection semantics.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.usp.ai/Ontologies/FPEO/MeasurementTemporalModule#hasNumericValue">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">has numeric value</rdfs:label>
    <rdfs:comment xml:lang="en">What it is: Numeric value recorded by a measurement. BFO/IOF placement: literal-bearing information attribute. Why it is here: Provides reusable JSON-compatible measurement/temporal projection semantics.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.usp.ai/Ontologies/FPEO/MeasurementTemporalModule#hasUnitSymbol">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">has unit symbol</rdfs:label>
    <rdfs:comment xml:lang="en">What it is: Unit symbol associated with a measurement value. BFO/IOF placement: literal-bearing information attribute. Why it is here: Provides reusable JSON-compatible measurement/temporal projection semantics.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.usp.ai/Ontologies/FPEO/MeasurementTemporalModule#TemporalIntervalSpecification">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Temporal interval specification</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000031"/>
    <rdfs:comment xml:lang="en">What it is: An information content entity specifying a bounded interval using start and end dates. BFO/IOF placement: generically dependent continuant. Why it is here: Supports JSON demand periods without treating date strings themselves as BFO temporal regions.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.usp.ai/Ontologies/FPEO/MeasurementTemporalModule#hasCalendarYear">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">has calendar year</rdfs:label>
    <rdfs:comment xml:lang="en">What it is: Calendar year coordinate, allowing decimal sub-year resolution. BFO/IOF placement: literal-bearing information attribute. Why it is here: Provides reusable JSON-compatible measurement/temporal projection semantics.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </rdf:Description>
</rdf:RDF>
