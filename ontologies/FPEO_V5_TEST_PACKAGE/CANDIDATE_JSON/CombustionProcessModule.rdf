<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:owl="http://www.w3.org/2002/07/owl#"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
>
  <rdf:Description rdf:about="http://www.usp.ai/Ontologies/FPEO/CombustionProcessModule#usesFuelSpecification">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">uses fuel specification</rdfs:label>
    <rdfs:comment xml:lang="en">What it is: Relates combustion to the fuel specification consumed. BFO/IOF placement: relation between ontology entities. Why it is here: Supports GasTurbineIn.fuel_key through an ontology relation to FuelSpecification.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.usp.ai/Ontologies/FPEO/CombustionProcessModule#CombustionProcess"/>
    <rdfs:range rdf:resource="http://www.usp.ai/Ontologies/FPEO/EmissionProcessModule#FuelSpecification"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.usp.ai/Ontologies/FPEO/CombustionProcessModule#GasTurbineCombustionProcess">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Gas turbine combustion process</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.usp.ai/Ontologies/FPEO/CombustionProcessModule#CombustionProcess"/>
    <rdfs:comment xml:lang="en">What it is: A combustion process occurring in a gas turbine. BFO/IOF placement: process. Why it is here: Connects the PLM gas turbine compatibility class to fuel/emission behavior.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.usp.ai/Ontologies/FPEO/CombustionProcessModule#usesGasTurbine">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">uses gas turbine</rdfs:label>
    <rdfs:comment xml:lang="en">What it is: Relates a gas-turbine combustion process to its participating PLM gas turbine. BFO/IOF placement: relation between ontology entities. Why it is here: Supports gas-turbine scenario provenance without replacing the PLM class.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.usp.ai/Ontologies/FPEO/CombustionProcessModule#GasTurbineCombustionProcess"/>
    <rdfs:range rdf:resource="http://rds.posccaesar.org/ontology/plm/rdl/PCA_100005927"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.usp.ai/Ontologies/FPEO/CombustionProcessModule">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <rdfs:label xml:lang="en">FPEO Combustion Process Module</rdfs:label>
    <rdfs:comment xml:lang="en">FPEO V5 candidate generated 2026-08-21. This ontology is part of the JSON-compatible, BFO-2020-aligned test architecture and is not the immutable production baseline.</rdfs:comment>
    <owl:versionIRI rdf:resource="http://www.usp.ai/Ontologies/FPEO/CombustionProcessModule/versions/2026-08-21"/>
    <owl:imports rdf:resource="http://www.usp.ai/Ontologies/FPEO/EmissionProcessModule"/>
    <owl:imports rdf:resource="http://www.usp.ai/Ontologies/FPEO/EquipmentModule"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.usp.ai/Ontologies/FPEO/CombustionProcessModule#CombustionProcess">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Combustion process</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.usp.ai/Ontologies/FPEO/EmissionProcessModule#EmissionProcess"/>
    <rdfs:comment xml:lang="en">What it is: An emission process in which fuel undergoes combustion. BFO/IOF placement: process. Why it is here: Represents combustion as the emission mechanism used by fuel-burning generation.</rdfs:comment>
  </rdf:Description>
</rdf:RDF>
