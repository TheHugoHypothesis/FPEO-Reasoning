    <rdfs:label xml:lang="en">has identifier</rdfs:label>
    <rdfs:comment xml:lang="en">What it is: Stable software-facing identifier of an equipment item. BFO/IOF placement: literal-bearing information attribute. Why it is here: Supports JSON id values without deleting has_Serial_Number.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
