    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000027"/>
    <rdfs:comment xml:lang="en">What it is: An object aggregate containing a gas turbine prime mover and electrical generator used as a generating unit. BFO/IOF placement: object aggregate. Why it is here: Distinguishes the turbine itself from the complete electrical generating unit while preserving PLM:PCA_100005927 for turbine instances.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.usp.ai/Ontologies/FPEO/EquipmentModule#hasIdentifier">
