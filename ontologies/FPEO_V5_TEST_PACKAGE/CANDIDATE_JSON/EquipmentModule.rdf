  <rdf:Description rdf:about="http://www.usp.ai/Ontologies/FPEO/EquipmentModule#ElectricalGenerator">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Electrical generator</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://rds.posccaesar.org/ontology/plm/rdl/PCA_100005932"/>
    <rdfs:comment xml:lang="en">What it is: An engineered electrical generator that converts primary or shaft energy into electrical power. BFO/IOF placement: material entity / object. Why it is here: Provides a precise FPEO class for generation equipment without replacing the PLM GasTurbine IRI expected by software.</rdfs:comment>
  </rdf:Description>
